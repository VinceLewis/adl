# ADL authority server configuration sample.
#
# Copy to a location your process manager loads (never commit the filled copy)
# and set every value below. No real secret belongs in this file.
#
# Migrations are applied OUT OF BAND, before the process starts, using the
# migration role in src/server/migrations/roles.sql. Run roles.sql once as the
# database owner, then, as the migration role:
#   psql "$ADL_MIGRATION_DATABASE_URL" -f src/server/migrations/grants.sql
#   psql "$ADL_MIGRATION_DATABASE_URL" -f src/server/migrations/0001_authority_projection.sql
#   ... through the highest-numbered file, in order.
# grants.sql is what gives the traffic role (adl_authority, the role this file's
# ADL_DATABASE_URL names) DML over the projection tables. Skip it and the process
# connects successfully and then fails every query with `permission denied for
# table adl_authority_*`. It is idempotent, needs no superuser, and may be run
# before or after the numbered files. See the runbook's "Database roles and
# migrations".
# The server never applies migration SQL; it only upserts its own application
# model row at startup.
#
# Start with: npm run start:authority
#
# For a LOCAL development deployment -- real TLS, real HTTPS origins, real
# __Host- cookies, no production check relaxed -- follow
# docs/development/local-https-development.md, which carries a filled-in
# development copy of every value below.

# --- Deployment ---------------------------------------------------------------

# development | test | production. Production additionally requires
# ADL_COOKIE_SECURE=true and a real identity verifier: the bypass is refused
# outright there (see ADL_IDENTITY_VERIFICATION).
ADL_ENV=development

# PostgreSQL connection string for the RUNTIME role (not the migration role).
# Must start with postgresql:// or postgres://. Treat as a secret: it is never
# logged, echoed, or included in a /readyz reason.
ADL_DATABASE_URL=postgresql://adl_authority:CHANGE_ME@localhost:5432/adl

# Comma-separated browser origins allowed to call the authority. HTTPS only, no
# duplicates, no trailing path.
ADL_ALLOWED_ORIGINS=https://app.example.com

# Interface and port this process binds. Keep the default loopback bind when a
# TLS-terminating reverse proxy fronts the process on the same host.
ADL_HOST=127.0.0.1
ADL_PORT=8787

# --- Application --------------------------------------------------------------

# Required. Partitions every authority projection row and is the foreign key
# target of the application model row. Must be stable for the life of the
# deployment: changing it orphans existing records.
ADL_APPLICATION_ID=giggle-band

# Required. Directory containing app.yaml and every ADL source it lists.
# Relative paths resolve against the process working directory. There is no
# default: an unset value refuses to start rather than silently serving the
# bundled Giggle Band reference app behind a real deployment.
ADL_MODEL_PATH=src/reference/giggle-band

# --- Identity boundary --------------------------------------------------------

# passkey | upstream | bypass. DEFAULTS TO bypass.
#
# passkey is the real credential the authority verifies itself. It issues a
# challenge, the authenticator signs it, and the assertion is checked against a
# stored public key. There is no shared secret, so there is no password store,
# no reset email and no credential stuffing. Sessions are issued only by a
# completed ceremony: /v1/session/issue is unavailable in this mode and answers
# endpoint_unavailable (503), so no weaker second way in exists alongside it.
# It requires the ADL_WEBAUTHN_* values below.
#
# upstream requires a real bearer-proof verifier (for example an OIDC id_token)
# to be supplied to the process. Without one, every proof is unverifiable and no
# session is issued (an honest failure, never a silent downgrade to the bypass).
#
# bypass is DEVELOPMENT ONLY. No provider is contacted and the supplied
# x-adl-account-proof is accepted as the identity subject, so anyone who can
# reach the authority becomes any user by naming them. A production process
# REFUSES TO START with it: loadAuthorityConfiguration raises a configuration
# error instead of serving traffic. There is deliberately no escape hatch - the
# former ADL_IDENTITY_BYPASS_ACKNOWLEDGED variable has been REMOVED and setting
# it now does nothing - because a real verifier exists, so no operator should be
# able to opt a production deployment back into accepting an unverified
# identity.
#
# No mode is silent: the active one is written to the startup security log as
# identity_verification_configured and reported by /readyz as
# { mode, verifier, bypassed }. No mode widens anything else either: context
# roles always resolve from accepted membership records through the runtime.
ADL_IDENTITY_VERIFICATION=passkey

# Expected issuer and audience an upstream verifier checks a provider proof
# against. Both are required in EVERY mode, including passkey and bypass, so
# switching the mode does not need a second configuration change.
ADL_UPSTREAM_IDENTITY_ISSUER=https://identity.example.com
ADL_UPSTREAM_IDENTITY_AUDIENCE=adl-authority

# --- WebAuthn relying party (required when ADL_IDENTITY_VERIFICATION=passkey) --
#
# Origin binding is EXPLICIT and is never inferred from a request. A credential
# registered against one relying party id will not work against another, so a
# development registration and a production registration are separate by design:
# a passkey created against a localhost relying party cannot sign in to
# app.example.com, and changing these values invalidates every credential
# already registered. Choose them once, deliberately.

# The registrable domain every allowed origin sits under. A host name only: no
# scheme, no port, no path.
ADL_WEBAUTHN_RP_ID=app.example.com

# Human-readable name the platform prompt shows the person. Defaults to
# ADL_WEBAUTHN_RP_ID.
ADL_WEBAUTHN_RP_NAME=Giggle Band

# Comma-separated origins an assertion may legitimately come from. Defaults to
# ADL_ALLOWED_ORIGINS. Every entry must be under ADL_WEBAUTHN_RP_ID - equal to
# it, or a subdomain of it - and a mismatch is refused at startup rather than
# producing credentials that silently fail to verify later.
ADL_WEBAUTHN_ORIGINS=https://app.example.com

# Lifetime of a server-issued ceremony challenge, in seconds (positive integer).
# Default 300. A challenge is single-use and bound to the ceremony it was issued
# for; the finish call consumes it. Shorten this rather than lengthening it.
ADL_WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# --- HTTP controls ------------------------------------------------------------

# Must be true in production. Session and CSRF cookies are always issued Secure,
# HttpOnly (session) and SameSite=Strict; this asserts the deployment terminates
# HTTPS in front of the process and forwards x-forwarded-proto: https.
ADL_COOKIE_SECURE=true

# Opaque session lifetime in minutes (positive integer). Default 480.
ADL_SESSION_TTL_MINUTES=480

# Maximum accepted JSON request body in bytes (positive integer). Default 65536.
ADL_MAX_REQUEST_BYTES=65536

# --- Rate limits (requests per fixed window, per client, positive integers) ----

ADL_RATE_ACCOUNT_PROOF=10

# Registration and authentication ceremonies (/v1/webauthn/*). Its own bucket
# because most of those calls are pre-session, so they must not spend - or be
# limited by - an authenticated caller's session allowance. Both the begin and
# the finish call of a ceremony count against it. Default 20.
ADL_RATE_WEBAUTHN=20

ADL_RATE_SESSION=30
ADL_RATE_INVITE=20
ADL_RATE_BOOTSTRAP=120
ADL_RATE_REPLAY=240
ADL_RATE_REPORT=30
ADL_RATE_ADMINISTRATION=30

# --- Retention (Phase 55) -----------------------------------------------------
#
# Read by the authority process and by the one-shot retention entry point
# (`npm run retention`, `npm run retention:dry-run`). The retention job needs
# only ADL_DATABASE_URL, ADL_APPLICATION_ID and these variables - not the rest of
# this file - so a cron job can carry a much smaller environment than a server.
#
# Defaults are deliberately conservative and there is NO schedule by default: a
# deployment that has said nothing about retention deletes nothing. Take a dry
# run and obtain legal approval before enabling one.

# Runtime-audit and operation-outcome rows inside this window are never pruned,
# whatever cutoff is requested. Set it to at least your legal audit-retention
# period. Positive integer days. Default 365.
ADL_RETENTION_MINIMUM_DAYS=365

# How long an ALREADY ENDED session row is kept after it ended. A session that is
# still active - not revoked and not yet expired - is never eligible, whatever
# this is set to. Positive integer days. Default 30.
ADL_RETENTION_SESSION_DAYS=30

# How long a consumed or expired WebAuthn ceremony challenge is kept. A challenge
# still answerable is never eligible. Positive integer days. Default 1.
ADL_RETENTION_CHALLENGE_DAYS=1

# Legal hold. Only the exact string "true" holds, so a typo cannot silently
# disable the hold. When held, every run reports `held` and deletes nothing.
ADL_RETENTION_LEGAL_HOLD=false

# In-process schedule, in minutes. Leave UNSET (the default) to run retention out
# of band with the one-shot entry point instead; both are safe together because
# every run takes the same per-application advisory lock.
# ADL_RETENTION_INTERVAL_MINUTES=1440

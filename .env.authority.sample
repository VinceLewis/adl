# ADL authority server configuration sample.
#
# Copy to a location your process manager loads (never commit the filled copy)
# and set every value below. No real secret belongs in this file.
#
# Migrations are applied OUT OF BAND, before the process starts, using the
# migration role in src/server/migrations/roles.sql:
#   psql "$ADL_MIGRATION_DATABASE_URL" -f src/server/migrations/0001_authority_projection.sql
#   ... through the highest-numbered file, in order.
# The server never applies migration SQL; it only upserts its own application
# model row at startup.
#
# Start with: npm run start:authority

# --- Deployment ---------------------------------------------------------------

# development | test | production. Production additionally requires
# ADL_COOKIE_SECURE=true, and requires the identity bypass to be acknowledged
# explicitly (see ADL_IDENTITY_BYPASS_ACKNOWLEDGED).
ADL_ENV=development

# PostgreSQL connection string for the RUNTIME role (not the migration role).
# Must start with postgresql:// or postgres://. Treat as a secret: it is never
# logged, echoed, or included in a /readyz reason.
ADL_DATABASE_URL=postgresql://adl_authority:CHANGE_ME@localhost:5432/adl

# Comma-separated browser origins allowed to call the authority. HTTPS only, no
# duplicates, no trailing path.
ADL_ALLOWED_ORIGINS=https://app.example.com

# Interface and port this process binds. Keep the default loopback bind when a
# TLS-terminating reverse proxy fronts the process on the same host.
ADL_HOST=127.0.0.1
ADL_PORT=8787

# --- Application --------------------------------------------------------------

# Required. Partitions every authority projection row and is the foreign key
# target of the application model row. Must be stable for the life of the
# deployment: changing it orphans existing records.
ADL_APPLICATION_ID=giggle-band

# Directory containing app.yaml and every ADL source it lists. Relative paths
# resolve against the process working directory.
ADL_MODEL_PATH=src/reference/giggle-band

# --- Identity boundary --------------------------------------------------------

# bypass | upstream. DEFAULTS TO bypass.
#
# bypass is a documented, TEMPORARY development state pending a real provider
# decision: no provider is contacted and the supplied x-adl-account-proof is
# accepted as the identity subject. It is never silent - the active mode is
# written to the startup security log and reported by /readyz - and it does not
# widen anything else: context roles still resolve from accepted membership
# records through the runtime.
#
# upstream requires a real verifier to be supplied to the process. Without one,
# every proof is unverifiable and no session is issued (an honest failure, never
# a silent downgrade to the bypass).
ADL_IDENTITY_VERIFICATION=bypass

# Required in production when ADL_IDENTITY_VERIFICATION=bypass. Production must
# not reach the bypass by omission; an operator has to state it deliberately.
# ADL_IDENTITY_BYPASS_ACKNOWLEDGED=true

# Expected issuer and audience an upstream verifier checks a provider proof
# against. Both are required even while the bypass is active, so switching the
# mode on does not need a second configuration change.
ADL_UPSTREAM_IDENTITY_ISSUER=https://identity.example.com
ADL_UPSTREAM_IDENTITY_AUDIENCE=adl-authority

# --- HTTP controls ------------------------------------------------------------

# Must be true in production. Session and CSRF cookies are always issued Secure,
# HttpOnly (session) and SameSite=Strict; this asserts the deployment terminates
# HTTPS in front of the process and forwards x-forwarded-proto: https.
ADL_COOKIE_SECURE=true

# Opaque session lifetime in minutes (positive integer). Default 480.
ADL_SESSION_TTL_MINUTES=480

# Maximum accepted JSON request body in bytes (positive integer). Default 65536.
ADL_MAX_REQUEST_BYTES=65536

# --- Rate limits (requests per fixed window, per client, positive integers) ----

ADL_RATE_ACCOUNT_PROOF=10
ADL_RATE_SESSION=30
ADL_RATE_INVITE=20
ADL_RATE_BOOTSTRAP=120
ADL_RATE_REPLAY=240
ADL_RATE_REPORT=30
ADL_RATE_ADMINISTRATION=30

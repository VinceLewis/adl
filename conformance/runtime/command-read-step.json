  "cases": [
    {
      "id": "command.read-step.seeds-a-new-record-and-overrides-a-field-instead-of-copying-it.001",
      "title": "A READ step's bound record seeds a later CREATE step's fields, and an overridden field is not copied",
      "specRef": "resolved-model#commands",
      "operation": "executeCommand",
      "modelRef": "commandReadStep",
      "setup": [
        {
          "operation": "create",
          "alias": "source",
          "objectName": "Event",
          "values": {
            "VenueName": "The Forum",
            "ContactName": "Jamie Rivera",
            "AmountCents": 250000,
            "EventDate": "2026-01-10"
          },
          "context": {
            "userId": "user-admin",
            "roles": ["Admin"],
            "channel": "api",
            "now": "2026-07-31T09:00:00.000Z"
          }
        }
      ],
      "input": {
        "commandName": "DuplicateEvent",
        "input": {
          "SourceEventId": { "$ref": "source.meta.guid" },
          "NewDate": "2026-03-20"
        },
        "context": {
          "userId": "user-admin",
          "roles": ["Admin"],
          "channel": "api",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "steps": [
            {
              "step": "duplicate",
              "objectName": "Event",
              "values": {
                "VenueName": "The Forum",
                "ContactName": "Jamie Rivera",
                "AmountCents": 250000,
                "EventDate": "2026-03-20"
              }
            }
          ]
        }
      }
    },
    {
      "id": "command.read-step.policy-denial-on-the-read-step-fails-the-whole-command.002",
      "title": "A caller whose read policy denies the READ step's target record fails the whole command, writing nothing",
      "specRef": "resolved-model#commands",
      "operation": "executeCommand",
      "modelRef": "commandReadStep",
      "setup": [
        {
          "operation": "create",
          "alias": "source",
          "objectName": "Event",
          "values": {
            "VenueName": "The Forum",
            "ContactName": "Jamie Rivera",
            "AmountCents": 250000,
            "EventDate": "2026-01-10"
          },
          "context": {
            "userId": "user-admin",
            "roles": ["Admin"],
            "channel": "api",
            "now": "2026-07-31T09:00:00.000Z"
          }
        }
      ],
      "input": {
        "commandName": "DuplicateEvent",
        "input": {
          "SourceEventId": { "$ref": "source.meta.guid" },
          "NewDate": "2026-03-20"
        },
        "context": {
          "userId": "user-outsider",
          "roles": ["Outsider"],
          "channel": "api",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": false,
        "error": {
          "name": "PolicyDeniedError",
          "code": "ADL_POLICY_DENIED"
        }
      }
    },
    {
      "id": "command.read-step.a-read-of-a-nonexistent-record-fails-the-whole-command.003",
      "title": "A READ step whose target record does not exist fails the whole command",
      "specRef": "resolved-model#commands",
      "operation": "executeCommand",
      "modelRef": "commandReadStep",
      "input": {
        "commandName": "DuplicateEvent",
        "input": {
          "SourceEventId": "no-such-event",
          "NewDate": "2026-03-20"
        },
        "context": {
          "userId": "user-admin",
          "roles": ["Admin"],
          "channel": "api",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": false,
        "error": {
          "name": "StorageError",
          "code": "ADL_STORAGE_ERROR"
        }
      }
    },
    {
      "id": "command.read-step.a-step-may-not-forward-reference-a-later-read-step.004",

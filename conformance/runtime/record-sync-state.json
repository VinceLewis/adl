{
  "version": 1,
  "models": {
    "recordSync": {
      "app": {
        "name": "RecordSync"
      },
      "objects": [
        {
          "name": "Note",
          "displayField": "Title",
          "fields": [
            {
              "name": "Title",
              "type": "text",
              "required": true
            }
          ],
          "constraints": [
            {
              "name": "UniqueNoteTitle",
              "kind": "unique",
              "fields": ["Title"]
            }
          ],
          "sync": {
            "mode": "localFirst",
            "scope": "all",
            "conflict": "serverWins"
          }
        },
        {
          "name": "Tag",
          "displayField": "Label",
          "fields": [
            {
              "name": "Note",
              "type": "text",
              "required": true,
              "lookup": {
                "targetObject": "Note",
                "displayField": "Title"
              }
            },
            {
              "name": "Label",
              "type": "text",
              "required": true
            }
          ],
          "sync": {
            "mode": "localFirst",
            "scope": "all"
          }
        },
        {
          "name": "Draft",
          "displayField": "Title",
          "fields": [
            {
              "name": "Title",
              "type": "text",
              "required": true
            }
          ],
          "sync": {
            "mode": "localPrivate",
            "scope": "all"
          }
        }
      ],
      "commands": [
        {
          "name": "FileNote",
          "label": "File a note",
          "inputs": [
            {
              "name": "Title",
              "type": "text",
              "required": true
            }
          ],
          "steps": [
            {
              "name": "createNote",
              "action": "create",
              "object": "Note",
              "values": {
                "Title": {
                  "kind": "input",
                  "name": "Title"
                }
              }
            },
            {
              "name": "createTag",
              "action": "create",
              "object": "Tag",
              "values": {
                "Note": {
                  "kind": "stepMeta",
                  "step": "createNote",
                  "property": "guid"
                },
                "Label": {
                  "kind": "literal",
                  "value": "filed"
                }
              }
            }
          ]
        }
      ],
      "policies": [
        {
          "name": "NotePolicy",
          "object": "Note",
          "rules": [
            {
              "name": "allowAuthenticatedAllNote",
              "effect": "allow",
              "principal": {
                "match": "authenticated"
              },
              "action": "*"
            }
          ]
        },
        {
          "name": "TagPolicy",
          "object": "Tag",
          "rules": [
            {
              "name": "allowAuthenticatedAllTag",
              "effect": "allow",
              "principal": {
                "match": "authenticated"
              },
              "action": "*"
            }
          ]
        },
        {
          "name": "DraftPolicy",
          "object": "Draft",
          "rules": [
            {
              "name": "allowAuthenticatedAllDraft",
              "effect": "allow",
              "principal": {
                "match": "authenticated"
              },
              "action": "*"
            }
          ]
        }
      ]
    }
  },
  "cases": [
    {
      "id": "recordsyncstate.local.a-queued-write-leaves-the-record-pending.001",
      "title": "A device write on a queueable object is pending: the same commit queued it, and nothing has answered it yet",
      "specRef": "runtime-semantics#record-sync-state",
      "operation": "readPersistedRecords",
      "modelRef": "recordSync",
      "setup": [
        {
          "operation": "create",
          "alias": "note",
          "objectName": "Note",
          "values": {
            "Title": "Set list"
          },
          "context": {
            "userId": "user-1",
            "roles": [],
            "channel": "ui",
            "now": "2026-07-31T09:00:00.000Z"
          }
        }
      ],
      "input": {
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "records": [
            {
              "objectName": "Note",
              "recordId": "$note",
              "deleted": false,
              "syncStatus": "pending",
              "syncRejectedCreate": "$absent"
            }
          ]
        }
      }
    },
    {
      "id": "recordsyncstate.local.a-write-with-no-delivery-path-leaves-the-record-local.002",

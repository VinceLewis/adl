            }
          ]
        }
      }
    },
    {
      "id": "recordsyncstate.local.a-write-on-the-sync-channel-is-already-authority-state.003",
      "title": "A write arriving on the sync channel is the authority writing its own state, so it is synced rather than queued and pending",
      "specRef": "runtime-semantics#record-sync-state",
      "operation": "readPersistedRecords",
      "modelRef": "recordSync",
      "setup": [
        {
          "operation": "create",
          "alias": "note",
          "objectName": "Note",
          "values": {
            "Title": "Set list"
          },
          "context": {
            "userId": "user-1",
            "roles": [],
            "channel": "sync",
            "now": "2026-07-31T09:00:00.000Z"
          }
        }
      ],
      "input": {
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "records": [
            {
              "objectName": "Note",

          "online": true,
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "outcomes": [
            {
              "status": "rejected",
              "code": "ADL_RUNTIME_VALIDATION_FAILED"
            }
          ],
          "queue": [
            {
              "objectName": "Note",
              "operation": "command",
              "recordId": "$createNote",
              "recovery": {
                "status": "rejected",
                "code": "ADL_RUNTIME_VALIDATION_FAILED"
              },
              "command": {
                "name": "FileNote",
                "records": [
                  {
                    "objectName": "Note",
                    "recordId": "$createNote"
                  },
                  {
                    "objectName": "Tag",
                    "recordId": "$createTag"
                  }
                ]
              }
            }
          ],
          "records": [
            {
              "objectName": "Note",
              "recordId": "$createNote",
              "deleted": false,
              "syncStatus": "rejected",

      "operation": "syncReconcile",
      "modelRef": "recordSync",
      "input": {
        "authoritySetup": [
          {
            "alias": "seeded",
            "intent": {
              "operationId": "op-seed-note",
              "kind": "create",
              "objectName": "Note",
              "recordId": "note-1",
              "values": {
                "Title": "Original"
              }
            }
          }
        ],
        "deviceBootstrap": true,
        "device": [
          {
            "operation": "update",
            "objectName": "Note",
            "id": "note-1",
            "patch": {
              "Title": "Device edit"
            },
            "context": {
              "userId": "user-1",
              "roles": [],
              "channel": "ui",
              "now": "2026-07-31T09:00:00.000Z"
            }
          }
        ],
        "concurrent": [
          {
            "intent": {
              "operationId": "op-other-client",
              "kind": "update",
              "objectName": "Note",
              "recordId": "note-1",
              "patch": {
                "Title": "Server edit"
              },
              "baseRevision": {
                "$ref": "seeded.records.0.meta.revision"
              }
            }
          }
        ],
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "online": true,
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "outcomes": [
            {
              "status": "conflict",
              "code": "ADL_SYNC_CONFLICT"
            }
          ],
          "queue": [
            {
              "objectName": "Note",
              "operation": "update",
              "recordId": "note-1",
              "recovery": {
                "status": "conflict",
                "code": "ADL_SYNC_CONFLICT",
                "strategy": "serverWins"
              }
            }
          ],
          "records": [
            {
              "objectName": "Note",
              "recordId": "note-1",
              "deleted": false,
              "syncStatus": "conflict",
              "syncRejectedCreate": "$absent"
            }
          ]
        }
      }
    },

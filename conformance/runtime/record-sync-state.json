            },
            {
              "objectName": "Tag",
              "recordId": "$createTag",
              "deleted": false,
              "syncStatus": "rejected",
              "syncRejectedCreate": true
            }
          ]
        }
      }
    },
    {
      "id": "recordsyncstate.reconcile.an-accepted-command-leaves-every-record-it-wrote-synced.008",

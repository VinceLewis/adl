      "input": {
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "records": [
            {
              "objectName": "Draft",
              "recordId": "$draft",
              "deleted": false,

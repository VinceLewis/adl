    {
      "id": "recordsyncstate.reconcile.an-accepted-replay-leaves-the-record-synced.004",
      "title": "A queued write the authority accepts leaves the record synced and the queue empty",
      "specRef": "runtime-semantics#record-sync-state",
      "operation": "syncReconcile",
      "modelRef": "recordSync",
      "input": {
        "device": [
          {
            "operation": "create",
            "alias": "note",
            "objectName": "Note",
            "values": {
              "Title": "Set list"
            },
            "context": {
              "userId": "user-1",
              "roles": [],
              "channel": "ui",
              "now": "2026-07-31T09:00:00.000Z"
            }
          }
        ],
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "online": true,
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "outcomes": [
            {
              "status": "accepted"
            }
          ],
          "queue": [],
          "records": [
            {
              "objectName": "Note",
              "recordId": "$note",
              "deleted": false,
              "syncStatus": "synced",
              "syncRejectedCreate": "$absent",
              "values": {
                "Title": "Set list"
              }
            }
          ]
        }
      }
    },
    {
      "id": "recordsyncstate.reconcile.a-refused-replay-leaves-the-record-rejected.005",
      "title": "A queued create the authority refuses leaves the record behind as rejected, licensed for discard because the refusal was of its own create",
      "specRef": "runtime-semantics#record-sync-state",
      "operation": "syncReconcile",
      "modelRef": "recordSync",
      "input": {
        "authoritySetup": [
          {
            "intent": {
              "operationId": "op-seed-note",
              "kind": "create",
              "objectName": "Note",
              "recordId": "note-existing",
              "values": {
                "Title": "Set list"
              }
            }
          }
        ],
        "device": [
          {
            "operation": "create",
            "alias": "note",
            "objectName": "Note",
            "values": {
              "Title": "Set list"
            },
            "context": {
              "userId": "user-1",
              "roles": [],
              "channel": "ui",
              "now": "2026-07-31T09:00:00.000Z"
            }
          }
        ],
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "online": true,
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "outcomes": [
            {
              "status": "rejected",
              "code": "ADL_RUNTIME_VALIDATION_FAILED"
            }
          ],
          "queue": [
            {
              "objectName": "Note",
              "operation": "create",
              "recordId": "$note",
              "recovery": {
                "status": "rejected",
                "code": "ADL_RUNTIME_VALIDATION_FAILED",
                "strategy": "$absent"
              }
            }
          ],
          "records": [
            {
              "objectName": "Note",
              "recordId": "$note",
              "deleted": false,
              "syncStatus": "rejected",
              "syncRejectedCreate": true
            }
          ]
        }
      }
    },
    {
      "id": "recordsyncstate.reconcile.a-dismissed-verdict-leaves-the-record-rejected.006",
      "title": "Dismissing the verdict above discards the queue entry and nothing else: the row it wrote is still here, still says it was refused, and sits beside the authority's own record that refused it",
      "specRef": "runtime-semantics#record-sync-state",
      "operation": "syncReconcile",
      "modelRef": "recordSync",
      "input": {
        "authoritySetup": [
          {
            "intent": {
              "operationId": "op-seed-note",
              "kind": "create",
              "objectName": "Note",
              "recordId": "note-existing",
              "values": {
                "Title": "Set list"
              }
            }
          }
        ],
        "device": [
          {
            "operation": "create",
            "alias": "note",
            "objectName": "Note",
            "values": {
              "Title": "Set list"
            },
            "context": {
              "userId": "user-1",
              "roles": [],
              "channel": "ui",
              "now": "2026-07-31T09:00:00.000Z"
            }
          }
        ],
        "resolve": "keepServer",
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "online": true,
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "outcomes": [
            {
              "status": "rejected",
              "code": "ADL_RUNTIME_VALIDATION_FAILED"
            }
          ],
          "queue": [],
          "records": [
            {
              "objectName": "Note",
              "recordId": "$note",
              "deleted": false,
              "syncStatus": "rejected",
              "syncRejectedCreate": true
            },
            {
              "objectName": "Note",
              "recordId": "note-existing",
              "deleted": false,
              "syncStatus": "synced",
              "syncRejectedCreate": "$absent"
            }
          ]
        }
      }
    },
    {
      "id": "recordsyncstate.reconcile.a-refused-command-marks-every-record-it-wrote.007",
      "title": "One verdict over a command settles every record all of its steps wrote, not only the one its queue entry is filed under",
      "specRef": "runtime-semantics#what-a-verdict-covers",

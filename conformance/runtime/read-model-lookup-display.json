  "cases": [
    {
      "id": "read-model.lookup-display.projects-the-target-display-value.001",
      "title": "A field projected from a LOOKUP field carries the target's display value beside the stored id",
      "specRef": "runtime-semantics#projected-lookup-display-values",
      "operation": "executeReadModel",
      "modelRef": "lookupDisplay",
      "setup": [
        {
          "operation": "create",
          "alias": "casey",
          "objectName": "User",
          "values": {
            "Name": "Casey Morgan",
            "Email": "casey@example.com"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-07T08:00:00.000Z"
          }
        },
        {
          "operation": "create",
          "alias": "robin",
          "objectName": "User",
          "values": {
            "Name": "Robin Fox",
            "Email": "robin@example.com"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-07T08:00:00.000Z"
          }
        },
        {
          "operation": "create",
          "alias": "alpha",
          "objectName": "Team",
          "values": {
            "Name": "The Alphas"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-07T08:00:00.000Z"
          }
        },
        {
          "operation": "create",
          "alias": "caseyMember",
          "objectName": "TeamMember",
          "values": {
            "User": {
              "$ref": "casey.meta.guid"
            },
            "Team": {
              "$ref": "alpha.meta.guid"
            },
            "Role": "Member"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-07T08:00:00.000Z",
            "selectedContexts": {
              "Team": {
                "$ref": "alpha.meta.guid"
              }
            }
          }
        },
        {
          "operation": "create",
          "alias": "amp",
          "objectName": "Gadget",
          "values": {
            "Label": "Amp",
            "Owner": "casey@example.com"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-07T08:00:00.000Z",
            "selectedContexts": {
              "Team": {
                "$ref": "alpha.meta.guid"
              }
            }
          }
        },
        {
          "operation": "create",
          "alias": "orphan",
          "objectName": "Gadget",
          "values": {
            "Label": "Orphan",
            "Owner": "nobody@example.com"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-07T08:00:00.000Z",
            "selectedContexts": {
              "Team": {
                "$ref": "alpha.meta.guid"
              }
            }
          }
        }
      ],
      "input": {
        "readModelName": "TeamRoster",
        "context": {
          "userId": {
            "$ref": "casey.meta.guid"
          },
          "roles": [],
          "channel": "api",
          "now": "2026-08-07T08:00:00.000Z",
          "selectedContexts": {
            "Team": {
              "$ref": "alpha.meta.guid"
            }
          }
        }

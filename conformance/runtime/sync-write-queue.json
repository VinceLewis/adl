{
  "version": 1,
  "models": {
    "syncWriteModes": {
      "app": {
        "name": "SyncWriteModes"
      },
      "roles": [
        {
          "name": "Admin"
        }
      ],
      "objects": [
        {
          "name": "LocalFirstTask",
          "fields": [
            {
              "name": "Name",
              "type": "text",
              "required": true
            },
            {
              "name": "Status",
              "type": "text",
              "required": true,
              "defaultValue": "Draft"
            }
          ],
          "lifecycle": {
            "name": "LocalFirstTaskLifecycle",
            "stateField": "Status",
            "initialState": "Draft",
            "states": [
              {
                "name": "Draft"
              },
              {
                "name": "Done",
                "terminal": true
              }
            ],
            "actions": [
              {
                "name": "complete",
                "from": "Draft",
                "to": "Done",
                "policyRefs": [
                  "LocalFirstTaskPolicy"
                ]
              }
            ]
          },
          "sync": {
            "mode": "localFirst",
            "scope": "all"
          }
        },
        {
          "name": "LocalPrivateNote",
          "fields": [
            {
              "name": "Name",
              "type": "text",
              "required": true
            },
            {
              "name": "Status",
              "type": "text",
              "required": true,
              "defaultValue": "Draft"
            }
          ],
          "lifecycle": {
            "name": "LocalPrivateNoteLifecycle",
            "stateField": "Status",
            "initialState": "Draft",
            "states": [
              {
                "name": "Draft"
              },
              {
                "name": "Done",
                "terminal": true
              }
            ],
            "actions": [
              {
                "name": "complete",
                "from": "Draft",
                "to": "Done",
                "policyRefs": [
                  "LocalPrivateNotePolicy"
                ]
              }
            ]
          },
          "sync": {
            "mode": "localPrivate",
            "scope": "all"
          }
        },
        {
          "name": "CacheReadonlyItem",
          "fields": [
            {
              "name": "Name",
              "type": "text",
              "required": true
            }
          ],
          "sync": {
            "mode": "cacheReadonly",
            "scope": "all"
          }
        },
        {
          "name": "OnlineRequiredItem",
          "fields": [
            {
              "name": "Name",
              "type": "text",
              "required": true
            },
            {
              "name": "Status",
              "type": "text",
              "required": true,
              "defaultValue": "Draft"
            }
          ],
          "sync": {
            "mode": "onlineRequired",
            "scope": "all"
          },
          "lifecycle": {
            "name": "OnlineRequiredItemLifecycle",
            "stateField": "Status",
            "initialState": "Draft",
            "states": [
              {
                "name": "Draft"
              },
              {
                "name": "Done",
                "terminal": true
              }
            ],
            "actions": [
              {
                "name": "complete",
                "from": "Draft",
                "to": "Done",
                "policyRefs": [
                  "OnlineRequiredItemPolicy"
                ]
              }
            ]
          }
        }
      ],
      "policies": [
        {
          "name": "LocalFirstTaskPolicy",
          "object": "LocalFirstTask",
          "rules": [
            {
              "name": "allowAdminAllLocalFirstTask",
              "effect": "allow",
              "principal": {
                "match": "specific",
                "roles": [
                  "Admin"
                ]
              },
              "action": "*"
            }
          ]
        },
        {
          "name": "LocalPrivateNotePolicy",
          "object": "LocalPrivateNote",
          "rules": [
            {
              "name": "allowAdminAllLocalPrivateNote",
              "effect": "allow",
              "principal": {
                "match": "specific",
                "roles": [
                  "Admin"
                ]
              },
              "action": "*"
            }
          ]
        },
        {
          "name": "CacheReadonlyItemPolicy",
          "object": "CacheReadonlyItem",
          "rules": [
            {
              "name": "allowAdminAllCacheReadonlyItem",
              "effect": "allow",
              "principal": {
                "match": "specific",
                "roles": [
                  "Admin"
                ]
              },
              "action": "*"
            }
          ]
        },
        {
          "name": "OnlineRequiredItemPolicy",
          "object": "OnlineRequiredItem",
          "rules": [
            {
              "name": "allowAdminAllOnlineRequiredItem",
              "effect": "allow",
              "principal": {
                "match": "specific",
                "roles": [
                  "Admin"
                ]
              },
              "action": "*"
            }
          ]
        }
      ]
    }
  },
  "cases": [
    {
      "id": "syncwrite.localfirst.create-queues.001",
      "title": "A localFirst create is allowed and lands in the sync queue",
      "specRef": "runtime-semantics#sync-modes",
      "operation": "syncWrite",
      "modelRef": "syncWriteModes",
      "input": {
        "objectName": "LocalFirstTask",
        "write": "create",
        "values": {
          "Name": "Draft task"
        },
        "context": {
          "userId": "admin-1",
          "roles": [
            "Admin"
          ],
          "channel": "ui",
          "online": true
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "decision": {
            "allowed": true,
            "objectName": "LocalFirstTask",
            "operation": "create",
            "mode": "localFirst",
            "online": true,
            "queueable": true,
            "readonly": false
          },
          "write": {
            "status": "written"
          },
          "queue": [
            {
              "objectName": "LocalFirstTask",
              "operation": "create",
              "mode": "localFirst",
              "status": "pending"
            }
          ]
        }
      }
    },
    {

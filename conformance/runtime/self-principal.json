    {
      "id": "policy.self.fails-closed-with-no-record.005",
      "title": "A SELF rule cannot match a request that carries no record at all, which is what makes every recordless gate unreachable for it",
      "specRef": "runtime-semantics#policy-decisions",
      "operation": "policyDecision",
      "modelRef": "selfPrincipal",
      "input": {
        "request": {
          "objectName": "User",
          "action": "read"
        },
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "api"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "precedence": "defaultDeny",
          "decision": {
            "effect": "deny",
            "reasons": [
              {
                "policyName": "UserDefaultDeny",
                "effect": "deny"
              }
            ]
          }
        }
      }
    },

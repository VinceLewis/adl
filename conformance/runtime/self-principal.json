  "cases": [
    {
      "id": "policy.self.reads-own-record-in-full.001",
      "title": "A SELF principal lets a caller read the record whose own id is their user id, including fields no field-scoped rule grants",
      "specRef": "runtime-semantics#policy-decisions",
      "operation": "read",
      "modelRef": "selfPrincipal",
      "setup": [
        {
          "operation": "create",
          "alias": "alice",
          "objectName": "User",
          "values": {
            "Name": "Alice Adams",
            "Email": "alice@example.com"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-20T09:00:00.000Z"
          }
        },
        {
          "operation": "create",
          "alias": "bob",
          "objectName": "User",
          "values": {
            "Name": "Bob Brand",
            "Email": "bob@example.com"
          },
          "context": {
            "userId": "system-admin",
            "roles": [
              "SystemAdmin"
            ],
            "channel": "api",
            "now": "2026-08-20T09:00:00.000Z"
          }
        }
      ],
      "input": {
        "objectName": "User",
        "id": {
          "$ref": "alice.meta.guid"
        },
        "context": {
          "userId": {
            "$ref": "alice.meta.guid"
          },
          "roles": [],
          "channel": "api",
          "now": "2026-08-20T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "objectName": "User",
          "recordId": "$alice",
          "values": {
            "Name": "Alice Adams",
            "Email": "alice@example.com"
          }
        }
      }
    },

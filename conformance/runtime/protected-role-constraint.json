            }
          ]
        }
      ]
    }
  },
  "cases": [
    {
      "id": "protectedrole.delete.refuses-the-last-admin.001",
      "title": "Deleting the last guarded-role holder in a scope is refused rather than leaving the scope with none",
      "specRef": "resolved-model#protected-roles",
      "operation": "delete",
      "modelRef": "protectedRoleTeam",
      "setup": [
        {
          "operation": "create",
          "alias": "team",
          "objectName": "Team",
          "values": { "Name": "Alpha" },
          "context": { "userId": "admin-1", "roles": ["Admin"], "channel": "api", "now": "2026-07-31T09:00:00.000Z" }
        },
        {
          "operation": "create",
          "alias": "founder",
          "objectName": "TeamMember",
          "values": { "Team": { "$ref": "team.meta.guid" }, "User": "casey", "Role": "Admin" },
          "context": { "userId": "admin-1", "roles": ["Admin"], "channel": "api", "now": "2026-07-31T09:00:00.000Z" }
        }
      ],
      "input": {
        "objectName": "TeamMember",
        "id": { "$ref": "founder.meta.guid" },
        "context": { "userId": "admin-1", "roles": ["Admin"], "channel": "api", "now": "2026-07-31T09:05:00.000Z" }
      },
      "expected": {
        "ok": false,
        "error": {
          "name": "RuntimeValidationError",
          "code": "ADL_RUNTIME_VALIDATION_FAILED",
          "issues": [{ "code": "ADL_RUNTIME_CONSTRAINT_PROTECTED_ROLE" }]
        }
      }
    },
    {

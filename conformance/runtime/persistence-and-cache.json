{
  "version": 1,
  "models": {
    "computedPersistence": {
      "app": {
        "name": "ComputedPersistence"
      },
      "roles": [
        {
          "name": "Admin"
        }
      ],
      "objects": [
        {
          "name": "Invoice",
          "fields": [
            {
              "name": "UnitPrice",
              "type": "number",
              "required": true
            },
            {
              "name": "Quantity",
              "type": "number",
              "required": true
            }
          ],
          "computedFields": [
            {
              "name": "Total",
              "type": "number",
              "expression": {
                "kind": "binary",
                "operator": "*",
                "left": {
                  "kind": "field",
                  "field": "UnitPrice"
                },
                "right": {
                  "kind": "field",
                  "field": "Quantity"
                }
              }
            }
          ]
        }
      ],
      "policies": [
        {
          "name": "InvoicePolicy",
          "object": "Invoice",
          "rules": [
            {
              "name": "allowAdminAllInvoiceOps",
              "effect": "allow",
              "principal": {
                "match": "specific",
                "roles": ["Admin"]
              },
              "action": "*"
            }
          ]
        }
      ]
    },
    "cachedCatalog": {
      "app": {
        "name": "CachedCatalog"
      },
      "roles": [
        {
          "name": "Admin"
        }
      ],
      "objects": [
        {
          "name": "Rate",
          "displayField": "Name",
          "fields": [
            {
              "name": "Name",
              "type": "text",
              "required": true
            },
            {
              "name": "Amount",
              "type": "number",
              "required": true
            }
          ],
          "sync": {
            "mode": "cacheReadonly",
            "scope": "all"
          }
        }
      ],
      "policies": [
        {
          "name": "RatePolicy",
          "object": "Rate",
          "rules": [
            {
              "name": "allowAdminAllRateOps",
              "effect": "allow",
              "principal": {
                "match": "specific",
                "roles": ["Admin"]
              },
              "action": "*"
            }
          ]
        }
      ]
    }
  },
  "cases": [
    {
      "id": "persistence.computed.absent-from-storage-after-create.001",
      "title": "A created record stores its source fields and no computed field key",
      "specRef": "runtime-semantics#computed-fields",
      "operation": "readPersistedRecords",
      "modelRef": "computedPersistence",
      "setup": [
        {
          "operation": "create",
          "alias": "invoice",
          "objectName": "Invoice",
          "values": {
            "UnitPrice": 4,
            "Quantity": 5
          },
          "context": {
            "userId": "admin-1",
            "roles": ["Admin"],
            "channel": "api",
            "now": "2026-07-30T09:00:00.000Z"
          }
        }
      ],
      "input": {
        "context": {
          "userId": "admin-1",
          "roles": ["Admin"],
          "channel": "api",
          "now": "2026-07-30T09:05:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "records": [
            {
              "objectName": "Invoice",
              "recordId": "$invoice",
              "schemaVersion": 1,
              "deleted": false,
              "values": {
                "UnitPrice": 4,
                "Quantity": 5,
                "Total": "$absent"
              }
            }
          ]
        }
      }
    },

    {
      "id": "cacheread.write.update-of-seeded-record-refused.001",
      "title": "A cache-readonly record placed in storage still refuses a local update",
      "specRef": "runtime-semantics#sync-modes",
      "operation": "update",
      "modelRef": "cachedCatalog",
      "records": [
        {
          "objectName": "Rate",
          "record": {
            "meta": {
              "guid": "rate-1",
              "object": "Rate",
              "schemaVersion": 1,
              "revision": "seed-a",
              "createdAt": "2026-01-01T00:00:00.000Z",
              "createdBy": "seed",
              "updatedAt": "2026-01-01T00:00:00.000Z",
              "updatedBy": "seed",
              "syncStatus": "synced"
            },
            "values": {
              "Name": "Standard",
              "Amount": 10
            }
          }
        }
      ],
      "input": {
        "objectName": "Rate",
        "id": "rate-1",
        "patch": {
          "Amount": 99
        },
        "context": {
          "userId": "admin-1",
          "roles": ["Admin"],
          "channel": "ui",
          "online": true,
          "now": "2026-07-30T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": false,
        "error": {
          "code": "ADL_SYNC_POLICY_DENIED",
          "decision": {
            "allowed": false,
            "objectName": "Rate",
            "operation": "update",
            "mode": "cacheReadonly",
            "online": true,
            "queueable": false,
            "readonly": true
          }
        }
      }
    },

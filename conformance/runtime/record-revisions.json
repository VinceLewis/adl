  "cases": [
    {
      "id": "revision.one-runtime.every-write-is-a-new-version.001",
      "title": "Four writes through one runtime produce four versions and reissue nothing",
      "specRef": "runtime-semantics#record-revisions",
      "operation": "readRecordRevisions",
      "modelRef": "revisionModel",
      "setup": [
        {
          "operation": "create",
          "alias": "note",
          "objectName": "Note",
          "values": {
            "Title": "Version one"
          },
          "context": {
            "userId": "admin-1",
            "roles": ["Admin"],
            "channel": "ui",
            "online": true,
            "now": "2026-07-17T09:00:00.000Z"
          }
        },
        {
          "operation": "update",
          "objectName": "Note",
          "id": {
            "$ref": "note.meta.guid"
          },
          "patch": {
            "Title": "Version two"
          },
          "context": {
            "userId": "admin-1",
            "roles": ["Admin"],
            "channel": "ui",
            "online": true,
            "now": "2026-07-17T09:01:00.000Z"
          }
        },
        {
          "operation": "update",
          "objectName": "Note",
          "id": {
            "$ref": "note.meta.guid"
          },
          "patch": {
            "Title": "Version three"
          },
          "context": {
            "userId": "admin-1",
            "roles": ["Admin"],
            "channel": "ui",
            "online": true,
            "now": "2026-07-17T09:02:00.000Z"
          }
        },
        {
          "operation": "update",
          "objectName": "Note",
          "id": {
            "$ref": "note.meta.guid"
          },
          "patch": {
            "Title": "Version four"
          },
          "context": {
            "userId": "admin-1",
            "roles": ["Admin"],
            "channel": "ui",
            "online": true,
            "now": "2026-07-17T09:03:00.000Z"
          }
        }
      ],
      "input": {
        "objectName": "Note",
        "id": {
          "$ref": "note.meta.guid"
        },
        "context": {
          "userId": "admin-1",
          "roles": ["Admin"],
          "channel": "ui",
          "online": true,
          "now": "2026-07-17T09:04:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "writes": 4,
          "distinctRevisions": 4,
          "everyWriteChangedTheRevision": true,
          "revisionReissued": false,
          "currentRevisionIsTheLastWritten": true
        }
      }
    },

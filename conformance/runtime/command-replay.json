    {
      "id": "commandreplay.authority.accepts-a-context-establishing-command.017",
      "title": "A command that founds a context and its first membership is accepted as one intent, under the ids the device minted for both records",
      "specRef": "runtime-semantics#command-intents",
      "operation": "authorityReplay",
      "modelRef": "commandReplay",
      "input": {
        "sessions": {
          "founder": {
            "userId": "user-founder"
          }
        },
        "intent": {
          "operationId": "op-found-crew",
          "kind": "command",
          "commandName": "FoundCrew",
          "input": {
            "Name": "Night shift"
          },
          "recordIds": [
            {
              "step": "createCrew",
              "objectName": "Crew",
              "recordId": "crew-1"
            },
            {
              "step": "createLead",
              "objectName": "CrewMember",
              "recordId": "crew-member-1"
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "status": "accepted",
          "operationId": "op-found-crew",
          "records": [
            {
              "object": "Crew",
              "recordId": "crew-1",
              "values": {
                "Name": "Night shift"
              },
              "deleted": false
            },
            {
              "object": "CrewMember",
              "recordId": "crew-member-1",
              "values": {
                "User": "user-founder",
                "Crew": "crew-1",
                "Role": "Lead"
              },
              "deleted": false
            }
          ]
        }
      }
    },

          "steps": [
            {
              "name": "importSongs",
              "action": "create",
              "object": "Song",
              "forEach": "Songs",
              "values": {
                "Title": {
                  "kind": "item",
                  "field": "Title"
                },
                "Composer": {
                  "kind": "item",
                  "field": "Composer"
                },
                "Position": {
                  "kind": "itemIndex"
                }

          }
        ]
      }
    },
    {
      "id": "command.batch.the-current-item-is-meaningless-outside-an-iterating-step.011",
      "title": "A step that does not iterate may not reference the current item",
      "specRef": "resolved-model#repeated-inputs-and-iterating-steps",

  "cases": [
    {
      "id": "command.batch.an-iterating-step-writes-one-record-per-item.001",
      "title": "A step iterating a repeated input plans one write per item into the command's single transaction",
      "specRef": "resolved-model#repeated-inputs-and-iterating-steps",
      "operation": "executeCommand",
      "modelRef": "batchCommands",
      "input": {
        "commandName": "ImportSongs",
        "input": {
          "Songs": [
            {
              "Title": "Neon Map",
              "Composer": "Ada"
            },
            {
              "Title": "Slow Harbour",
              "Composer": "Grace"
            },
            {
              "Title": "Third Rail"
            }
          ]
        },
        "context": {
          "userId": "user-importer",
          "roles": [],
          "channel": "api",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "steps": [
            {
              "step": "importSongs",
              "objectName": "Song",
              "values": {
                "Title": "Neon Map",
                "Composer": "Ada",
                "Position": 0
              }
            },
            {
              "step": "importSongs",
              "objectName": "Song",
              "values": {
                "Title": "Slow Harbour",
                "Composer": "Grace",
                "Position": 1
              }
            },
            {
              "step": "importSongs",
              "objectName": "Song",
              "values": {
                "Title": "Third Rail",
                "Position": 2
              }
            }
          ]
        }
      }
    },
    {
      "id": "command.batch.a-list-of-scalars-iterates-as-well-as-a-list-of-records.002",
      "title": "A repeated input declaring no item fields carries plain values, which the current item reads whole",
      "specRef": "resolved-model#repeated-inputs-and-iterating-steps",
      "operation": "executeCommand",
      "modelRef": "batchCommands",
      "input": {
        "commandName": "ImportTags",
        "input": {
          "Tags": [
            "Rock",
            "Folk",
            "Jazz"
          ]
        },
        "context": {
          "userId": "user-importer",
          "roles": [],
          "channel": "api",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "steps": [
            {
              "step": "importTags",
              "objectName": "Tag",
              "values": {
                "Name": "Rock",
                "Ordinal": 0
              }
            },
            {
              "step": "importTags",
              "objectName": "Tag",
              "values": {
                "Name": "Folk",
                "Ordinal": 1
              }
            },
            {
              "step": "importTags",
              "objectName": "Tag",
              "values": {
                "Name": "Jazz",
                "Ordinal": 2
              }
            }
          ]
        }
      }
    },
    {
      "id": "command.batch.the-item-index-of-the-first-item-is-zero.003",
      "title": "The current item's index is its zero-based position, so a single-item batch writes index zero",
      "specRef": "resolved-model#repeated-inputs-and-iterating-steps",
      "operation": "executeCommand",

    },
    {
      "id": "command.batch.an-invalid-item-refuses-the-whole-batch.004",
      "title": "One item failing its declared shape refuses the entire batch rather than the item",
      "specRef": "resolved-model#repeated-inputs-and-iterating-steps",
      "operation": "executeCommand",
      "modelRef": "batchCommands",
      "input": {
        "commandName": "ImportSongs",
        "input": {
          "Songs": [
            {
              "Title": "Good"
            },
            {
              "Composer": "Missing a title"
            }
          ]
        },
        "context": {
          "userId": "user-importer",
          "roles": [],
          "channel": "api",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": false,
        "error": {
          "name": "RuntimeValidationError",
          "code": "ADL_RUNTIME_VALIDATION_FAILED",
          "issues": [
            {
              "code": "ADL_RUNTIME_COMMAND_INPUT_ITEM_REQUIRED",
              "path": "input.Songs[1].Title",
              "field": "Title"
            }
          ]
        }
      }
    },
    {
      "id": "command.batch.a-repeated-input-given-a-single-value-is-refused.005",
      "title": "A repeated input handed something that is not a list is refused rather than wrapped in a list of one",
      "specRef": "resolved-model#repeated-inputs-and-iterating-steps",
      "operation": "executeCommand",
      "modelRef": "batchCommands",
      "input": {
        "commandName": "ImportSongs",
        "input": {
          "Songs": "Neon Map"
        },
        "context": {
          "userId": "user-importer",
          "roles": [],
          "channel": "api",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": false,
        "error": {
          "name": "RuntimeValidationError",
          "code": "ADL_RUNTIME_VALIDATION_FAILED",
          "issues": [
            {
              "code": "ADL_RUNTIME_COMMAND_INPUT_NOT_A_LIST",
              "path": "input.Songs"
            }
          ]
        }
      }
    },
    {
      "id": "command.batch.the-authority-accepts-a-batch-as-one-intent.006",
      "title": "A batch command replays through the authority as one intent and returns every record it wrote",
      "specRef": "runtime-semantics#commands",
      "operation": "authorityReplay",
      "modelRef": "batchCommands",
      "input": {
        "sessions": {
          "importer": {
            "userId": "user-importer"
          }
        },
        "intent": {
          "operationId": "op-import-good",
          "kind": "command",
          "commandName": "ImportSongs",
          "input": {
            "Songs": [
              {
                "Title": "Neon Map",
                "Composer": "Ada"
              },
              {
                "Title": "Slow Harbour",
                "Composer": "Grace"
              },
              {
                "Title": "Third Rail"
              }
            ]
          },
          "recordIds": [
            {
              "step": "importSongs",
              "itemIndex": 0,
              "objectName": "Song",
              "recordId": "song-import-1"
            },
            {
              "step": "importSongs",
              "itemIndex": 1,
              "objectName": "Song",
              "recordId": "song-import-2"
            },
            {
              "step": "importSongs",
              "itemIndex": 2,
              "objectName": "Song",
              "recordId": "song-import-3"
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "status": "accepted",
          "operationId": "op-import-good",
          "records": [
            {
              "object": "Song",
              "values": {
                "Title": "Neon Map",
                "Position": 0
              },
              "deleted": false
            },
            {
              "object": "Song",
              "values": {
                "Title": "Slow Harbour",
                "Position": 1
              },
              "deleted": false
            },
            {
              "object": "Song",
              "values": {
                "Title": "Third Rail",
                "Position": 2
              },
              "deleted": false
            }
          ]
        }
      }
    },
    {
      "id": "command.batch.the-authority-refuses-a-batch-with-an-invalid-item.007",
      "title": "The authority refuses the whole batch intent when one item fails validation",
      "specRef": "runtime-semantics#commands",
      "operation": "authorityReplay",
      "modelRef": "batchCommands",
      "input": {
        "sessions": {
          "importer": {
            "userId": "user-importer"
          }
        },
        "intent": {
          "operationId": "op-import-bad",
          "kind": "command",
          "commandName": "ImportSongs",
          "input": {
            "Songs": [
              {
                "Title": "Good"
              },
              {
                "Composer": "Missing a title"
              }
            ]
          },
          "recordIds": [
            {
              "step": "importSongs",
              "itemIndex": 0,
              "objectName": "Song",
              "recordId": "song-bad-1"
            },
            {
              "step": "importSongs",
              "itemIndex": 1,
              "objectName": "Song",
              "recordId": "song-bad-2"
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "status": "rejected",
          "operationId": "op-import-bad",
          "code": "ADL_RUNTIME_VALIDATION_FAILED"
        }
      }
    },
    {
      "id": "command.batch.a-refused-batch-leaves-nothing-behind.008",
      "title": "Nothing a refused batch would have written is readable afterwards, so the batch is atomic and not merely reported as failed",
      "specRef": "runtime-semantics#commands",
      "operation": "authorityBootstrap",
      "modelRef": "batchCommands",
      "input": {
        "sessions": {
          "importer": {
            "userId": "user-importer"
          }
        },
        "setup": [
          {
            "intent": {
              "operationId": "op-import-bad",
              "kind": "command",
              "commandName": "ImportSongs",
              "input": {
                "Songs": [
                  {
                    "Title": "Good"
                  },
                  {
                    "Composer": "Missing a title"
                  }
                ]
              },
              "recordIds": [
                {
                  "step": "importSongs",
                  "itemIndex": 0,
                  "objectName": "Song",
                  "recordId": "song-nothing-1"
                },
                {
                  "step": "importSongs",
                  "itemIndex": 1,
                  "objectName": "Song",
                  "recordId": "song-nothing-2"
                }
              ]
            },
            "expect": "rejected"
          }
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "records": []
        }
      }
    },
    {
      "id": "command.batch.an-accepted-batch-does-leave-its-records-behind.009",
      "title": "The same read after an accepted batch returns what it wrote, so the empty result above is the refusal and not the read",
      "specRef": "runtime-semantics#commands",
      "operation": "authorityBootstrap",
      "modelRef": "batchCommands",
      "input": {
        "sessions": {
          "importer": {
            "userId": "user-importer"
          }
        },
        "setup": [
          {
            "intent": {
              "operationId": "op-import-one",
              "kind": "command",
              "commandName": "ImportSongs",
              "input": {
                "Songs": [
                  {
                    "Title": "Only Song"
                  }
                ]
              },
              "recordIds": [
                {
                  "step": "importSongs",
                  "itemIndex": 0,
                  "objectName": "Song",
                  "recordId": "song-kept-1"
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "records": [
            {
              "object": "Song",
              "values": {
                "Title": "Only Song",
                "Position": 0
              },
              "deleted": false
            }
          ]
        }
      }
    },
    {
      "id": "command.batch.an-iterating-step-may-not-be-referenced-by-a-later-step.010",
      "title": "A later step may not read an iterating step's record, because the step names many records rather than one",
      "specRef": "resolved-model#repeated-inputs-and-iterating-steps",
      "operation": "validateModel",

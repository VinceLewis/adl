    {
      "id": "edit-surface.staged.one-batch-entry.001",
      "title": "A staged batch commits every child change and queues exactly one batch operation covering all of them",
      "specRef": "runtime-semantics#staged-child-changes",
      "operation": "applyStagedChildChanges",
      "modelRef": "orderEditSurface",
      "setup": [
        {
          "operation": "create",
          "alias": "order",
          "objectName": "Order",
          "values": {
            "Code": "A-1"
          },
          "context": {
            "userId": "user-1",
            "roles": [],
            "channel": "ui",
            "now": "2026-07-31T09:00:00.000Z"
          }
        }
      ],
      "input": {
        "objectName": "Order",
        "viewName": "OrderForm",
        "parentRecordId": {
          "$ref": "order.meta.guid"
        },
        "stagedChanges": [
          {
            "id": "strings",
            "section": "Lines",
            "operation": "createChild",
            "childObject": "OrderLine",
            "values": {
              "Description": "Strings",
              "Position": 1
            }
          },
          {
            "id": "picks",
            "section": "Lines",
            "operation": "createChild",
            "childObject": "OrderLine",
            "values": {
              "Description": "Picks",
              "Position": 2
            }
          }
        ],
        "context": {
          "userId": "user-1",
          "roles": [],
          "channel": "ui",
          "now": "2026-07-31T09:00:00.000Z"
        }
      },
      "expected": {
        "ok": true,
        "result": {
          "apply": {
            "status": "applied",
            "applied": [
              {
                "operationId": "strings",
                "operation": "createChild",
                "childObject": "OrderLine",
                "recordId": "$strings"
              },
              {
                "operationId": "picks",
                "operation": "createChild",
                "childObject": "OrderLine",
                "recordId": "$picks"
              }
            ]
          },
          "queue": [
            {
              "objectName": "Order",
              "operation": "create",
              "recordId": "$order",
              "mode": "localFirst"
            },
            {
              "objectName": "OrderLine",
              "operation": "batch",
              "recordId": "$strings",
              "mode": "localFirst",
              "batch": {
                "writes": [
                  {
                    "operation": "create",
                    "objectName": "OrderLine",
                    "recordId": "$strings",
                    "values": {
                      "Description": "Strings",
                      "Position": 1,
                      "Order": "$order"
                    }
                  },
                  {
                    "operation": "create",
                    "objectName": "OrderLine",
                    "recordId": "$picks",
                    "values": {
                      "Description": "Picks",
                      "Position": 2,
                      "Order": "$order"
                    }
                  }
                ]
              }
            }
          ],
          "records": [
            {
              "objectName": "Order",
              "recordId": "$order",
              "syncStatus": "pending"
            },
            {
              "objectName": "OrderLine",
              "recordId": "$picks",
              "syncStatus": "pending",
              "values": {
                "Description": "Picks",
                "Position": 2
              }
            },
            {
              "objectName": "OrderLine",
              "recordId": "$strings",
              "syncStatus": "pending",
              "values": {
                "Description": "Strings",
                "Position": 1
              }
            }
          ]
        }
      }

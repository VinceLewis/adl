  "cases": [
    {
      "id": "policy.role-reach.membership-role-on-an-object-outside-its-context.001",
      "title": "A rule whose only principal is a membership-earned ROLE is refused on an object that is neither scoped to that context nor that context's own bound object",
      "specRef": "language#role-reach",
      "operation": "validateModel",
      "modelRef": "roleReachDeadRule",
      "expected": {
        "ok": true,
        "result": [
          {
            "severity": "error",
            "code": "ADL_POLICY_ROLE_PRINCIPAL_UNREACHABLE",
            "path": "policies[3].rules[0].principal.roles"
          }
        ]
      }
    },

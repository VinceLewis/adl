{
  "version": 1,
  "models": {
    "declaredOfflineScopes": {
      "adl": [
        "APP 'Declared Offline Scopes'",
        "END.APP",
        "",
        "OBJECT Gig",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  FIELD Status TEXT REQUIRED",
        "  FIELD Owner TEXT",
        "  FIELD GigDate DATE REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE recent WINDOW GigDate 14 DAYS LIMIT 50",
        "END.OBJECT",
        "",
        "OBJECT Note",
        "  DISPLAY Body",
        "  FIELD Body TEXT REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE recent",
        "END.OBJECT",
        "",
        "OBJECT Task",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  FIELD Status TEXT REQUIRED",
        "  FIELD Owner TEXT",
        "  SYNC LOCAL_FIRST SCOPE custom WHERE Status == 'open' AND Owner == RUNTIME.userId",
        "END.OBJECT",
        "",
        "OBJECT Receipt",
        "  DISPLAY Body",
        "  FIELD Body TEXT REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE recent WINDOW LIMIT 5",
        "END.OBJECT"
      ]
    },
    "customScopeWithoutPredicate": {
      "adl": [
        "APP 'Custom Scope Without Predicate'",
        "END.APP",
        "",
        "OBJECT Gig",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  FIELD Status TEXT REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE custom",
        "END.OBJECT"
      ]
    },
    "customPredicateOverAFieldThatDoesNotExist": {
      "adl": [
        "APP 'Custom Predicate Over A Field That Does Not Exist'",
        "END.APP",
        "",
        "OBJECT Gig",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE custom WHERE Status == 'open'",
        "END.OBJECT"
      ]
    },
    "customPredicateThatIsNotBoolean": {
      "adl": [
        "APP 'Custom Predicate That Is Not Boolean'",
        "END.APP",
        "",
        "OBJECT Gig",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  FIELD Status TEXT REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE custom WHERE Status",
        "END.OBJECT"
      ]
    },
    "composedOfflineBounds": {
      "adl": [
        "APP 'Composed Offline Bounds'",
        "END.APP",
        "",
        "OBJECT Shift",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  FIELD ShiftDate DATE REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE currentUser WINDOW ShiftDate 90 DAYS LIMIT 50",
        "END.OBJECT",
        "",
        "OBJECT Ticket",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  FIELD Status TEXT REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE currentContext WHERE Status == 'open'",
        "END.OBJECT",
        "",
        "OBJECT Invoice",
        "  DISPLAY Title",
        "  FIELD Title TEXT REQUIRED",
        "  FIELD Status TEXT REQUIRED",
        "  FIELD IssuedOn DATE REQUIRED",
        "  SYNC LOCAL_FIRST SCOPE currentUser WINDOW IssuedOn 30 DAYS WHERE Status == 'open'",
        "END.OBJECT"
      ]
    }
  },
  "cases": [
    {
      "id": "offline.scope.language.window.001",
      "title": "A WINDOW declared in ADL source reaches the resolved sync window",
      "specRef": "language#offline-dataset-scope",
      "operation": "resolveModel",
      "modelRef": "declaredOfflineScopes",
      "input": {
        "select": [
          "objects.0.sync.scope",
          "objects.0.sync.window.field",
          "objects.0.sync.window.days",
          "objects.0.sync.window.limit"
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "objects.0.sync.scope": "recent",
          "objects.0.sync.window.field": "GigDate",
          "objects.0.sync.window.days": 14,
          "objects.0.sync.window.limit": 50
        }
      }
    },
    {
      "id": "offline.scope.language.window-default.001",
      "title": "A recent scope declared in ADL source without a window still derives the 30 day default",
      "specRef": "language#offline-dataset-scope",
      "operation": "resolveModel",
      "modelRef": "declaredOfflineScopes",
      "input": {
        "select": ["objects.1.sync.window.field", "objects.1.sync.window.days"]
      },
      "expected": {
        "ok": true,
        "result": {
          "objects.1.sync.window.field": "_updatedAt",
          "objects.1.sync.window.days": 30
        }
      }
    },
    {
      "id": "offline.scope.language.window-partial.001",
      "title": "A WINDOW declaring only a limit keeps the default window field",
      "specRef": "language#offline-dataset-scope",
      "operation": "resolveModel",
      "modelRef": "declaredOfflineScopes",
      "input": {
        "select": ["objects.3.sync.window.field", "objects.3.sync.window.limit"]
      },
      "expected": {
        "ok": true,
        "result": {
          "objects.3.sync.window.field": "_updatedAt",
          "objects.3.sync.window.limit": 5
        }
      }
    },
    {
      "id": "offline.scope.language.custom-predicate.001",
      "title": "A custom scope predicate declared in ADL source reaches the resolved model as an ordinary expression",
      "specRef": "language#offline-dataset-scope",
      "operation": "resolveModel",
      "modelRef": "declaredOfflineScopes",
      "input": {
        "select": [
          "objects.2.sync.scope",
          "objects.2.sync.predicate.operator",
          "objects.2.sync.predicate.left.left.field",
          "objects.2.sync.predicate.left.right.value",
          "objects.2.sync.predicate.right.left.field",
          "objects.2.sync.predicate.right.right.property"
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "objects.2.sync.scope": "custom",
          "objects.2.sync.predicate.operator": "and",
          "objects.2.sync.predicate.left.left.field": "Status",
          "objects.2.sync.predicate.left.right.value": "open",
          "objects.2.sync.predicate.right.left.field": "Owner",
          "objects.2.sync.predicate.right.right.property": "userId"
        }
      }
    },
    {
      "id": "offline.scope.language.window-on-a-context-scope.001",
      "title": "A WINDOW declared alongside a currentUser scope reaches the resolved model",
      "specRef": "language#offline-dataset-scope",
      "operation": "resolveModel",
      "modelRef": "composedOfflineBounds",
      "input": {
        "select": [
          "objects.0.sync.scope",
          "objects.0.sync.window.field",
          "objects.0.sync.window.days",
          "objects.0.sync.window.limit"
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "objects.0.sync.scope": "currentUser",
          "objects.0.sync.window.field": "ShiftDate",
          "objects.0.sync.window.days": 90,
          "objects.0.sync.window.limit": 50
        }
      }
    },
    {
      "id": "offline.scope.language.predicate-on-a-context-scope.001",
      "title": "A WHERE predicate declared alongside a currentContext scope reaches the resolved model",
      "specRef": "language#offline-dataset-scope",
      "operation": "resolveModel",
      "modelRef": "composedOfflineBounds",
      "input": {
        "select": [
          "objects.1.sync.scope",
          "objects.1.sync.predicate.operator",
          "objects.1.sync.predicate.left.field",
          "objects.1.sync.predicate.right.value"
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "objects.1.sync.scope": "currentContext",
          "objects.1.sync.predicate.operator": "==",
          "objects.1.sync.predicate.left.field": "Status",
          "objects.1.sync.predicate.right.value": "open"
        }
      }
    },
    {
      "id": "offline.scope.language.window-and-predicate-together.001",
      "title": "A window and a predicate declared on the same scope both reach the resolved model",
      "specRef": "language#offline-dataset-scope",
      "operation": "resolveModel",
      "modelRef": "composedOfflineBounds",
      "input": {
        "select": [
          "objects.2.sync.scope",
          "objects.2.sync.window.field",
          "objects.2.sync.window.days",
          "objects.2.sync.predicate.left.field",
          "objects.2.sync.predicate.right.value"
        ]
      },
      "expected": {
        "ok": true,
        "result": {
          "objects.2.sync.scope": "currentUser",
          "objects.2.sync.window.field": "IssuedOn",
          "objects.2.sync.window.days": 30,
          "objects.2.sync.predicate.left.field": "Status",
          "objects.2.sync.predicate.right.value": "open"
        }
      }
    },
    {
      "id": "offline.scope.validation.declared-scopes-are-clean.001",
      "title": "Every declared offline scope in the corpus model validates clean",
      "specRef": "resolved-model#validation",
      "operation": "validateModel",
      "modelRef": "declaredOfflineScopes",
      "expected": {
        "ok": true,
        "result": []
      }
    },
    {
      "id": "offline.scope.validation.bounds-compose-with-any-scope.001",
      "title": "A window and a predicate declared alongside a context scope validate clean",
      "specRef": "resolved-model#validation",
      "operation": "validateModel",
      "modelRef": "composedOfflineBounds",
      "expected": {
        "ok": true,
        "result": []
      }
    },
    {
      "id": "offline.scope.validation.custom-predicate-missing.001",
      "title": "A custom sync scope declared without a predicate is refused",
      "specRef": "resolved-model#validation",
      "operation": "validateModel",
      "modelRef": "customScopeWithoutPredicate",
      "expected": {
        "ok": true,
        "result": [
          {
            "severity": "error",
            "code": "ADL_OBJECT_SYNC_PREDICATE_MISSING",
            "path": "objects[0].sync.scope"
          },
          {
            "severity": "error",
            "code": "ADL_SYNC_PREDICATE_MISSING",
            "path": "sync[0].scope"
          }
        ]
      }
    },
    {
      "id": "offline.scope.validation.custom-predicate-field-unknown.001",
      "title": "A custom sync predicate over a field that does not exist is refused",
      "specRef": "resolved-model#validation",
      "operation": "validateModel",
      "modelRef": "customPredicateOverAFieldThatDoesNotExist",
      "expected": {
        "ok": true,
        "result": [
          {
            "severity": "error",
            "code": "ADL_OBJECT_SYNC_PREDICATE_FIELD_UNKNOWN",
            "path": "objects[0].sync.predicate.left.field"
          },
          {
            "severity": "error",
            "code": "ADL_SYNC_PREDICATE_FIELD_UNKNOWN",
            "path": "sync[0].predicate.left.field"
          }
        ]
      }
    },
    {
      "id": "offline.scope.validation.custom-predicate-type.001",
      "title": "A custom sync predicate that does not resolve to boolean is refused",
      "specRef": "resolved-model#validation",
      "operation": "validateModel",
      "modelRef": "customPredicateThatIsNotBoolean",
      "expected": {
        "ok": true,
        "result": [
          {
            "severity": "error",
            "code": "ADL_OBJECT_SYNC_PREDICATE_TYPE",
            "path": "objects[0].sync.predicate"
          },
          {
            "severity": "error",
            "code": "ADL_SYNC_PREDICATE_TYPE",
            "path": "sync[0].predicate"
          }
        ]
      }
    }
  ]
}

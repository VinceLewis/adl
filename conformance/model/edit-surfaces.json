    {
      "id": "edit-surface.validation.unlink-required-parent-field.001",
      "title": "A child collection supporting unlink against a required parent field is refused, and the diagnostic names the field that can never be cleared",
      "specRef": "resolved-model#validation",
      "operation": "validateModel",
      "modelRef": "unlinkOnRequiredParentField",
      "expected": {
        "ok": true,
        "result": [
          {
            "severity": "error",
            "code": "ADL_VIEW_EDIT_SECTION_UNLINK_PARENT_FIELD_REQUIRED",
            "message": "Edit child collection 'Lines' supports 'unlink' but parent field 'Order' on child object 'OrderLine' is required, so a child can never be detached from its parent. Use 'remove' instead, or make the field optional.",
            "path": "objects[0].views[0].editSections[0].operations"
          }
        ]
      }
    },
    {
      "id": "edit-surface.language.unlink-optional-parent-field.001",
      "title": "The same collection validates clean when the parent field is optional, because then the detachment the operation plans is a write the child can accept",
      "specRef": "resolved-model#validation",
      "operation": "validateModel",
      "modelRef": "unlinkOnOptionalParentField",
      "expected": { "ok": true, "result": [] }
    },
    {
      "id": "edit-surface.validation.picker-link-operation.001",

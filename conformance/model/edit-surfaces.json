        "OBJECT Order",
        "  FIELD Code TEXT REQUIRED",
        "",
        "  VIEW OrderForm FORM",
        "    FIELDS Code",
        "    CHILD_COLLECTION Lines",
        "      CHILD OrderLine PARENT_FIELD Order",
        "      OPERATIONS createChild updateChild unlink",

                          "map": "MyScheduleStatus"
                        }
                      ]
                    },
                    "summaryFields": [
                      "VenueName"
                    ],
                    "titleField": "Title"
                  }
                ],
                "controls": [],
                "heading": "My schedule across bands",
                "lists": [],
                "name": "MySchedule"
              }
            ],
            "state": [
              {
                "defaultValue": "2026-08-01",
                "name": "visibleMonth",
                "type": "date"
              }
            ],
            "statusMaps": [
              {
                "defaultStatus": "unavailable",
                "field": "ScheduleStatus",
                "name": "MyScheduleStatus",
                "values": [
                  {
                    "status": "conflict",
                    "value": "Gig"

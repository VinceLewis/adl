              "kind": "childCollection",
              "name": "Songs",
              "operations": [
                "createChild",
                "updateChild",
                "remove",
                "reorder"
              ],
              "orderField": "Position",
              "parentField": "SetList",
              "picker": {
                "candidateField": "Song",
                "comment": "Adding a song is choosing one, not typing its record id. CANDIDATE_FIELD\nmakes each choice mint a SetListItem naming that Song, appended to the end\nof the set list and ready to be reordered. Songs already in this set list\nare excluded, so the same song cannot be added twice.",
                "displayFields": [
                  "Title",
                  "Composer"
                ],
                "emptyState": {
                  "text": "Every song in the library is already in this set list."
                },
                "name": "SongPicker",

{
  "app": {
    "name": "Giggle Band UI Views (placeholder, discarded on merge)"
  },
  "commands": [],
  "contexts": [],
  "decisionTables": [],
  "objects": [
    {
      "name": "Event",
      "views": [
        {
          "actions": [
            "read",
            "search"
          ],
          "context": {
            "context": "Band",
            "mode": "all"
          },
          "fields": [
            "EventDate",
            "StartTime",
            "EventType",
            "Title",
            "VenueName"
          ],
          "kind": "dashboard",
          "name": "HomeDashboard",
          "presentation": {
            "density": "compact",
            "iconMaps": [
              {
                "defaultIcon": "calendar",
                "field": "EventType",
                "name": "EventTypeIcon",
                "values": [
                  {
                    "icon": "music",
                    "value": "Gig"
                  },
                  {
                    "icon": "microphone",
                    "value": "Rehearsal"
                  },
                  {
                    "icon": "x",
                    "value": "Unavailable"
                  }
                ]
              }
            ],
            "legends": [
              {
                "name": "ScheduleStatus",
                "statuses": [
                  "event",
                  "rehearsal",
                  "unavailable"
                ],
                "title": "Schedule status"
              }
            ],
            "sections": [
              {
                "calendars": [],
                "controls": [
                  {
                    "create": {
                      "object": "Event"
                    },
                    "icon": {
                      "kind": "named",
                      "name": "calendar"
                    },
                    "kind": "action",
                    "label": "Add Event",
                    "name": "addEvent",
                    "placement": "primary"
                  }
                ],
                "heading": "Welcome Back!",
                "lists": [],
                "name": "Welcome"
              },
              {
                "calendars": [],
                "controls": [
                  {
                    "icon": {
                      "kind": "map",
                      "map": "EventTypeIcon",
                      "value": "Gig"
                    },
                    "kind": "toggle",
                    "label": "Gigs",
                    "name": "showGigsToggle",
                    "state": "showGigs"
                  },
                  {
                    "icon": {
                      "kind": "map",
                      "map": "EventTypeIcon",
                      "value": "Rehearsal"
                    },
                    "kind": "toggle",
                    "label": "Rehearsals",
                    "name": "showRehearsalsToggle",
                    "state": "showRehearsals"
                  },
                  {
                    "icon": {
                      "kind": "map",
                      "map": "EventTypeIcon",
                      "value": "Unavailable"
                    },
                    "kind": "toggle",
                    "label": "Unavailable",
                    "name": "showUnavailableToggle",
                    "state": "showUnavailable"
                  }
                ],
                "density": "compact",
                "lists": [],
                "name": "Filters"
              },
              {
                "calendars": [],
                "controls": [],
                "heading": "Schedule",
                "lists": [
                  {
                    "density": "compact",
                    "emptyState": {
                      "text": "No upcoming events"
                    },
                    "filter": "(((EventType == 'Gig') AND (showGigs == TRUE)) OR ((EventType == 'Rehearsal') AND (showRehearsals == TRUE))) OR ((EventType == 'Unavailable') AND (showUnavailable == TRUE))",
                    "name": "UpcomingEvents",
                    "renderAs": "compactFeed",
                    "row": {
                      "fragments": [
                        {
                          "field": "EventDate",
                          "format": {
                            "kind": "date",
                            "pattern": "EEE d MMM"
                          },
                          "kind": "field"
                        },
                        {
                          "kind": "text",
                          "text": " "
                        },
                        {
                          "field": "StartTime",
                          "format": {
                            "kind": "time",
                            "pattern": "h:mma"
                          },
                          "kind": "field"
                        },
                        {
                          "kind": "text",
                          "text": " - "
                        },
                        {
                          "field": "Title",
                          "kind": "field",
                          "style": "bold"
                        },
                        {
                          "kind": "text",
                          "text": " - "
                        },
                        {
                          "field": "VenueName",
                          "kind": "field"
                        }
                      ]
                    },
                    "sort": [
                      {
                        "direction": "asc",
                        "field": "EventDate"
                      },
                      {
                        "direction": "asc",
                        "field": "StartTime"
                      }
                    ],
                    "source": "HomeUpcomingEvents",
                    "status": {
                      "candidates": [
                        {
                          "field": "EventType",
                          "kind": "map",
                          "map": "EventTypeStatus"
                        }
                      ]
                    }
                  }
                ],
                "name": "Schedule"
              },
              {
                "calendars": [],
                "controls": [],
                "heading": "Invitations",
                "lists": [
                  {
                    "density": "compact",
                    "emptyState": {
                      "text": "No pending invitations"
                    },
                    "filter": "Status == 'Pending'",
                    "name": "PendingInvitations",
                    "renderAs": "compactFeed",
                    "row": {
                      "fragments": [
                        {
                          "field": "InviteeEmail",
                          "kind": "field",
                          "style": "bold"
                        },
                        {
                          "kind": "text",
                          "text": " - "
                        },
                        {
                          "field": "Role",
                          "kind": "field"
                        },
                        {
                          "kind": "text",
                          "text": " invited on "
                        },
                        {
                          "field": "SentAt",
                          "format": {
                            "kind": "date",
                            "pattern": "EEE d MMM"
                          },
                          "kind": "field"
                        }
                      ]
                    },
                    "sort": [],
                    "source": "PendingInvitations"
                  }
                ],
                "name": "Invitations"
              }
            ],
            "state": [
              {
                "defaultValue": true,
                "name": "showGigs",
                "type": "boolean"
              },
              {
                "defaultValue": true,
                "name": "showRehearsals",
                "type": "boolean"
              },
              {
                "defaultValue": true,
                "name": "showUnavailable",
                "type": "boolean"
              }
            ],
            "statusMaps": [
              {
                "defaultStatus": "event",
                "field": "EventType",
                "name": "EventTypeStatus",
                "values": [
                  {
                    "status": "event",
                    "value": "Gig"
                  },
                  {
                    "status": "rehearsal",
                    "value": "Rehearsal"
                  },
                  {
                    "status": "unavailable",
                    "value": "Unavailable"
                  }
                ]
              }
            ],
            "statuses": [
              {
                "accessibleLabel": "Gig event",
                "icon": {
                  "kind": "map",
                  "map": "EventTypeIcon",
                  "value": "Gig"
                },
                "label": "Gig",
                "name": "event",
                "precedence": 10
              },
              {
                "accessibleLabel": "Rehearsal event",
                "icon": {
                  "kind": "map",
                  "map": "EventTypeIcon",
                  "value": "Rehearsal"
                },
                "label": "Rehearsal",
                "name": "rehearsal",
                "precedence": 10,
                "themeToken": "colorStatusAlternate"
              },
              {
                "accessibleLabel": "Unavailable block",
                "icon": {
                  "kind": "map",
                  "map": "EventTypeIcon",
                  "value": "Unavailable"
                },
                "label": "Unavailable",
                "name": "unavailable",
                "precedence": 20
              }
            ]
          },
          "readModel": "HomeUpcomingEvents",
          "searchFields": [],
          "sort": [
            {
              "direction": "asc",
              "field": "EventDate"
            },
            {
              "direction": "asc",
              "field": "StartTime"
            }
          ]
        },
        {
          "actions": [
            "read",
            "search"
          ],
          "context": {
            "context": "Band",
            "mode": "required"
          },
          "fields": [
            "Date",
            "StartTime",
            "EventType",
            "Title",
            "VenueName"
          ],
          "kind": "dashboard",
          "name": "BandEventCalendar",
          "presentation": {
            "density": "compact",
            "iconMaps": [
              {
                "defaultIcon": "calendar",
                "field": "EventType",
                "name": "CalendarEventTypeIcon",
                "values": [
                  {
                    "icon": "music",
                    "value": "Gig"
                  },
                  {
                    "icon": "microphone",
                    "value": "Rehearsal"
                  },
                  {
                    "icon": "x",
                    "value": "Unavailable"
                  }
                ]
              }
            ],
            "legends": [
              {
                "name": "CalendarStatus",
                "statuses": [
                  "event",
                  "rehearsal",
                  "unavailable",
                  "conflict"
                ],
                "title": "Calendar status"
              }
            ],
            "sections": [
              {
                "calendars": [
                  {
                    "actions": [
                      {
                        "create": {
                          "object": "Event"
                        },
                        "icon": {
                          "kind": "named",

                        },
                        "input": {
                          "Date": "Date"
                        },
                        "kind": "action",
                        "label": "Add Event",
                        "name": "addEventOnDate",
                        "placement": "primary"
                      }
                    ],
                    "conflictOverlay": {
                      "dateField": "Date",
                      "flagField": "IsConflict",
                      "readModel": "EventAvailabilityConflicts",
                      "status": "conflict"
                    },
                    "dateField": "Date",
                    "density": "compact",
                    "emptyState": {
                      "text": "No events in this month"
                    },
                    "fields": [
                      "Date",
                      "StartTime",
                      "CalendarStatus",
                      "Title",
                      "VenueName"
                    ],
                    "month": {
                      "state": "visibleMonth"
                    },
                    "name": "MonthPlanner",
                    "sort": [
                      {
                        "direction": "asc",
                        "field": "Date"
                      },
                      {
                        "direction": "asc",
                        "field": "StartTime"
                      }
                    ],
                    "source": "CalendarPlanningItems",
                    "sourceKind": "readModel",
                    "status": {
                      "candidates": [
                        {
                          "field": "CalendarStatus",
                          "kind": "map",
                          "map": "CalendarEventTypeStatus"
                        }
                      ]
                    },
                    "summaryFields": [
                      "StartTime",
                      "VenueName"
                    ],
                    "titleField": "Title"
                  }
                ],
                "controls": [],
                "heading": "Calendar",
                "lists": [],
                "name": "PlanningCalendar"
              },
              {
                "calendars": [],
                "comment": "A repeat booking is rarely typed from scratch: a venue that had a band\nback is asking for the same night, the same contact and the same fee.\n`duplicateGig` copies every field but `Date` from an existing gig into a\nfresh create form, landing the user on a prefilled draft with only the\nnew date left to fill in -- the same `CREATE ... INPUT \u003cfield\u003e FROM\n\u003cfield\u003e` shape `addEventOnDate` already uses above, just with one input\nper business field instead of one. Bound to `OBJECT Event` directly\n(not a read model) so every field the row carries -- including the rich\ngig fields -- is available to `INPUT ... FROM`.",
                "controls": [],
                "heading": "Duplicate a previous gig",
                "lists": [
                  {
                    "actions": [
                      {
                        "comment": "`PreviousGig FROM PreviousGig` copies the row's own `PreviousGig`\nvalue forward (its repeat-booking lineage), not the id of the row\nbeing duplicated -- a presentation ACTION's `INPUT ... FROM \u003cexpr\u003e`\nonly ever sees a row's already-projected field values, never the\nrow's own record id (see\n`learnings/implementation/ui-presentation-model.md`'s \"row-scoped\nACTION cannot target an existing record by id\"), so there is no\nexpression here that could point the new gig back at this one.",
                        "create": {
                          "object": "Event"
                        },
                        "icon": {
                          "kind": "named",
                          "name": "list"
                        },
                        "input": {
                          "Agent": "Agent",
                          "Amount": "Amount",
                          "ContactEmail": "ContactEmail",
                          "ContactName": "ContactName",
                          "ContactPhone": "ContactPhone",
                          "EndTime": "EndTime",
                          "EventType": "EventType",
                          "Notes": "Notes",
                          "PaymentMethod": "PaymentMethod",
                          "PreviousGig": "PreviousGig",
                          "StartTime": "StartTime",
                          "Title": "Title",
                          "VenueLocation": "VenueLocation",
                          "VenueName": "VenueName"
                        },
                        "kind": "action",
                        "label": "Duplicate",
                        "name": "duplicateGig",
                        "placement": "row"
                      }
                    ],
                    "density": "compact",
                    "emptyState": {
                      "text": "No previous gigs to duplicate yet"
                    },
                    "name": "PreviousGigs",
                    "renderAs": "compactFeed",
                    "row": {
                      "fragments": [
                        {
                          "field": "Date",
                          "format": {
                            "kind": "date",
                            "pattern": "EEE d MMM"
                          },
                          "kind": "field"
                        },
                        {
                          "kind": "text",
                          "text": " - "
                        },
                        {
                          "field": "Title",
                          "kind": "field",
                          "style": "bold"
                        },
                        {
                          "kind": "text",
                          "text": " - "
                        },
                        {
                          "field": "VenueName",
                          "kind": "field"
                        }
                      ]
                    },
                    "sort": [
                      {
                        "direction": "desc",
                        "field": "Date"
                      }
                    ],
                    "source": "Event",
                    "sourceKind": "object"
                  }
                ],
                "name": "DuplicateGig"
              }
            ],
            "state": [
              {
                "defaultValue": "2026-08-01",
                "name": "visibleMonth",
                "type": "date"
              }
            ],
            "statusMaps": [
              {
                "defaultStatus": "event",
                "field": "EventType",
                "name": "CalendarEventTypeStatus",
                "values": [
                  {
                    "status": "event",
                    "value": "Gig"
                  },
                  {
                    "status": "rehearsal",
                    "value": "Rehearsal"
                  },
                  {
                    "status": "unavailable",
                    "value": "Unavailable"
                  }
                ]
              }
            ],
            "statuses": [
              {
                "accessibleLabel": "Gig event",
                "icon": {
                  "kind": "map",
                  "map": "CalendarEventTypeIcon",
                  "value": "Gig"
                },
                "label": "Gig",
                "name": "event",
                "precedence": 10
              },
              {
                "accessibleLabel": "Rehearsal event",
                "icon": {
                  "kind": "map",
                  "map": "CalendarEventTypeIcon",
                  "value": "Rehearsal"
                },
                "label": "Rehearsal",
                "name": "rehearsal",
                "precedence": 10,
                "themeToken": "colorStatusAlternate"
              },
              {
                "accessibleLabel": "Unavailable block",
                "icon": {
                  "kind": "map",
                  "map": "CalendarEventTypeIcon",
                  "value": "Unavailable"
                },
                "label": "Unavailable",
                "name": "unavailable",
                "precedence": 20
              },
              {
                "accessibleLabel": "Scheduling conflict",
                "icon": {
                  "kind": "named",

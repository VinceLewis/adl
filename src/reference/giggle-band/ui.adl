SHELL
  NAV HomeDashboard LABEL 'Home' ICON home GROUP Main ORDER 10
  NAV BandEventList LABEL 'Gigs' ICON calendar GROUP Main ORDER 20
  NAV BandEventCalendar LABEL 'Calendar' ICON calendar GROUP Main ORDER 30 VISIBLE WHEN CONTEXT Band SELECTED
  NAV MyAvailabilityList LABEL 'Availability' ICON calendar GROUP Main ORDER 40 VISIBLE WHEN CONTEXT Band SELECTED
  NAV SongLibrary LABEL 'Songs' ICON music GROUP Library ORDER 50
  NAV SetListList LABEL 'Set Lists' ICON list GROUP Library ORDER 60
  NAV SetListForm LABEL 'Set list editor' ICON list GROUP Library ORDER 62
  NAV BandDirectory LABEL 'Bands' ICON users GROUP Admin ORDER 70
  NAV MyInvitationList LABEL 'Sent Invitations' ICON list GROUP Admin ORDER 80 VISIBLE WHEN CONTEXT Band SELECTED
  NAV BandMemberAvailabilityBoard LABEL 'Who is free' ICON users GROUP Main ORDER 45 VISIBLE WHEN CONTEXT Band SELECTED
  NAV StreamingLinkList LABEL 'Streaming' ICON music GROUP Library ORDER 65
  CONTROL contextSelector KIND contextSelector PLACEMENT topBar
  CONTROL connection KIND connectivity PLACEMENT topBar
  CONTROL syncStatus KIND syncStatus PLACEMENT topBar
  CONTROL installApp KIND pwaInstall LABEL 'Install' PLACEMENT topBar
  CONTROL signOut KIND logout LABEL 'Sign out' ICON x PLACEMENT navDrawer
  TOP_BAR CONTEXT_SELECTOR topBar MOBILE_CONTEXT_SELECTOR sheet CONTROLS contextSelector connection syncStatus installApp
  NAV_DRAWER TITLE 'Giggle Band' CONTROLS signOut
END.SHELL

OBJECT Event
  VIEW HomeDashboard DASHBOARD
    CONTEXT ALL Band
    READ_MODEL HomeUpcomingEvents
    FIELDS EventDate StartTime EventType Title VenueName
    SORT EventDate ASC StartTime ASC
    ACTIONS read search
    LAYOUT stack
    DENSITY compact

    STATE showGigs BOOLEAN DEFAULT true
    STATE showRehearsals BOOLEAN DEFAULT true
    STATE showUnavailable BOOLEAN DEFAULT true

    ICON_MAP EventTypeIcon FOR EventType DEFAULT calendar
      Gig -> music
      Rehearsal -> microphone
      Unavailable -> x
    END.ICON_MAP

    STATUS event LABEL 'Gig' ARIA_LABEL 'Gig event' ICON EventTypeIcon(Gig) THEME colorStatusEvent PRECEDENCE 10
    STATUS rehearsal LABEL 'Rehearsal' ARIA_LABEL 'Rehearsal event' ICON EventTypeIcon(Rehearsal) THEME colorStatusAlternate PRECEDENCE 10
    STATUS unavailable LABEL 'Unavailable' ARIA_LABEL 'Unavailable block' ICON EventTypeIcon(Unavailable) THEME colorStatusUnavailable PRECEDENCE 20

    STATUS_MAP EventTypeStatus FOR EventType DEFAULT event
      Gig -> event
      Rehearsal -> rehearsal
      Unavailable -> unavailable
    END.STATUS_MAP

    LEGEND ScheduleStatus TITLE 'Schedule status' STATUSES event rehearsal unavailable

    SECTION Welcome
      HEADING 'Welcome Back!'

      ACTION addEvent CREATE Event LABEL 'Add Event' ICON calendar PLACEMENT primary
      END.ACTION
    END.SECTION

    SECTION Filters
      DENSITY compact

      TOGGLE showGigsToggle STATE showGigs
        LABEL 'Gigs'
        ICON EventTypeIcon(Gig)
      END.TOGGLE

      TOGGLE showRehearsalsToggle STATE showRehearsals
        LABEL 'Rehearsals'
        ICON EventTypeIcon(Rehearsal)
      END.TOGGLE

      TOGGLE showUnavailableToggle STATE showUnavailable
        LABEL 'Unavailable'
        ICON EventTypeIcon(Unavailable)
      END.TOGGLE
    END.SECTION

    SECTION Schedule
      HEADING 'Schedule'

      LIST UpcomingEvents FROM HomeUpcomingEvents
        ORDER BY EventDate ASC, StartTime ASC
        WHERE (EventType == 'Gig' AND showGigs == true) OR (EventType == 'Rehearsal' AND showRehearsals == true) OR (EventType == 'Unavailable' AND showUnavailable == true)
        RENDER_AS compactFeed
        DENSITY compact
        EMPTY_TEXT 'No upcoming events'
        STATUS EventTypeStatus(EventType)

        ROW
          ICON EventTypeIcon(EventType)
          TEXT EventDate FORMAT date 'EEE d MMM'
          TEXT ' '
          TEXT StartTime FORMAT time 'h:mma'
          TEXT ' - '
          TEXT Title STYLE bold
          TEXT ' - '
          TEXT VenueName
        END.ROW
      END.LIST
    END.SECTION

    SECTION Invitations
      HEADING 'Invitations'

      LIST PendingInvitations FROM PendingInvitations
        WHERE Status == 'Pending'
        RENDER_AS compactFeed
        DENSITY compact
        EMPTY_TEXT 'No pending invitations'

        ROW
          TEXT InviteeEmail STYLE bold
          TEXT ' - '
          TEXT Role
          TEXT ' invited on '
          TEXT SentAt FORMAT date 'EEE d MMM'
        END.ROW
      END.LIST
    END.SECTION
  END.VIEW

  VIEW BandEventCalendar DASHBOARD
    CONTEXT REQUIRED Band
    FIELDS Date StartTime EventType Title VenueName
    ACTIONS read search
    LAYOUT stack
    DENSITY compact

    STATE visibleMonth DATE DEFAULT '2026-08-01'

    ICON_MAP CalendarEventTypeIcon FOR EventType DEFAULT calendar
      Gig -> music
      Rehearsal -> microphone
      Unavailable -> x
    END.ICON_MAP

    STATUS event LABEL 'Gig' ARIA_LABEL 'Gig event' ICON CalendarEventTypeIcon(Gig) THEME colorStatusEvent PRECEDENCE 10
    STATUS rehearsal LABEL 'Rehearsal' ARIA_LABEL 'Rehearsal event' ICON CalendarEventTypeIcon(Rehearsal) THEME colorStatusAlternate PRECEDENCE 10
    STATUS unavailable LABEL 'Unavailable' ARIA_LABEL 'Unavailable block' ICON CalendarEventTypeIcon(Unavailable) THEME colorStatusUnavailable PRECEDENCE 20
    STATUS conflict LABEL 'Conflict' ARIA_LABEL 'Scheduling conflict' ICON calendar THEME colorStatusConflict PRECEDENCE 100

    STATUS_MAP CalendarEventTypeStatus FOR EventType DEFAULT event
      Gig -> event
      Rehearsal -> rehearsal
      Unavailable -> unavailable
    END.STATUS_MAP

    LEGEND CalendarStatus TITLE 'Calendar status' STATUSES event rehearsal unavailable conflict

    SECTION PlanningCalendar
      HEADING 'Calendar'

      CALENDAR MonthPlanner FROM READ_MODEL CalendarPlanningItems
        MONTH_STATE visibleMonth
        WEEK_START monday
        DATE_FIELD Date
        TITLE_FIELD Title
        SUMMARY_FIELDS StartTime VenueName
        FIELDS Date StartTime CalendarStatus Title VenueName
        ORDER BY Date ASC, StartTime ASC
        DENSITY compact
        STATUS CalendarEventTypeStatus(CalendarStatus)
        EMPTY_TEXT 'No events in this month'

        ACTION addEventOnDate CREATE Event LABEL 'Add Event' ICON calendar PLACEMENT primary
          INPUT Date FROM Date
        END.ACTION
      END.CALENDAR
    END.SECTION
  END.VIEW
END.OBJECT

OBJECT BandInvitation
  # Admin-facing counterpart to the `HomeDashboard` "Invitations" feed, which
  # only ever shows what is still `Pending`. This one is read-only:
  # `RevokeBandInvitation` exists and is exercised directly (see
  # `band-reference-app.test.ts`), the same way `AcceptBandInvitation` has
  # been since Phase 28, but a one-click row action cannot be wired to it yet.
  # A presentation `ACTION`'s `INPUT ... FROM <expr>` only ever sees a row's
  # already-projected field values (`RuntimePresentationRow.values`); nothing
  # in a read model, an object field, or a computed field can carry a
  # record's own storage id (`meta.guid`) into that scope today. Every
  # existing `ACTION` in this app that targets an existing record --
  # accepting an invitation included -- is invoked directly through the
  # command service, never through a list row, for exactly this reason.
  # Closing that gap is platform work (exposing the record id to presentation
  # row values / action input), not reference-app content.
  VIEW MyInvitationList DASHBOARD
    CONTEXT REQUIRED Band
    READ_MODEL SentBandInvitations
    FIELDS InviteeEmail Role Status SentAt RespondedAt
    SORT SentAt DESC
    ACTIONS read search
  END.VIEW
END.OBJECT

OBJECT SetList
  VIEW SetListForm FORM
    CONTEXT REQUIRED Band
    EDIT_CONTAINER page
    FIELDS Name Description
    ACTIONS create read update delete

    EDIT_SECTION Details HEADING 'Set list'
      FIELDS Name Description
    END.EDIT_SECTION

    CHILD_COLLECTION Songs HEADING 'Songs'
      CHILD SetListItem PARENT_FIELD SetList
      CHILD_VIEW SetListItemList
      OPERATIONS createChild updateChild remove reorder
      STAGED
      ORDER_FIELD Position
      EMPTY_TEXT 'No songs in this set list yet.'

      # Adding a song is choosing one, not typing its record id. CANDIDATE_FIELD
      # makes each choice mint a SetListItem naming that Song, appended to the end
      # of the set list and ready to be reordered. Songs already in this set list
      # are excluded, so the same song cannot be added twice.
      PICKER SongPicker
        SOURCE OBJECT Song
        CANDIDATE_FIELD Song
        SELECTION multiple
        DISPLAY Title Composer
        SEARCH Title Composer
        SORT Title ASC
        EXCLUDE_LINKED
        EMPTY_TEXT 'Every song in the library is already in this set list.'
      END.PICKER
    END.CHILD_COLLECTION
  END.VIEW
END.OBJECT

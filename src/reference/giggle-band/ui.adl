SHELL
  NAV HomeDashboard LABEL 'Home' ICON home GROUP Main ORDER 10
  NAV BandEventList LABEL 'Gigs' ICON calendar GROUP Main ORDER 20
  NAV BandEventCalendar LABEL 'Calendar' ICON calendar GROUP Main ORDER 30 VISIBLE WHEN CONTEXT Band SELECTED
  NAV MyAvailabilityList LABEL 'Availability' ICON calendar GROUP Main ORDER 40 VISIBLE WHEN CONTEXT Band SELECTED
  NAV SongLibrary LABEL 'Songs' ICON music GROUP Library ORDER 50
  NAV SetListList LABEL 'Set Lists' ICON list GROUP Library ORDER 60
  NAV SetListForm LABEL 'Set list editor' ICON list GROUP Library ORDER 62
  NAV BandDirectory LABEL 'Bands' ICON users GROUP Admin ORDER 70
  NAV MyInvitationList LABEL 'Sent Invitations' ICON list GROUP Admin ORDER 80 VISIBLE WHEN CONTEXT Band SELECTED
  NAV BandMemberAvailabilityBoard LABEL 'Who is free' ICON users GROUP Main ORDER 45 VISIBLE WHEN CONTEXT Band SELECTED
  NAV StreamingLinkList LABEL 'Streaming' ICON music GROUP Library ORDER 65
  CONTROL contextSelector KIND contextSelector PLACEMENT topBar
  CONTROL connection KIND connectivity PLACEMENT topBar
  CONTROL syncStatus KIND syncStatus PLACEMENT topBar
  CONTROL themeSwitch KIND themeSwitch LABEL 'Theme' PLACEMENT topBar
  CONTROL installApp KIND pwaInstall LABEL 'Install' PLACEMENT topBar
  CONTROL signOut KIND logout LABEL 'Sign out' ICON x PLACEMENT navDrawer
  TOP_BAR CONTEXT_SELECTOR topBar MOBILE_CONTEXT_SELECTOR sheet CONTROLS contextSelector connection syncStatus themeSwitch installApp
  NAV_DRAWER TITLE 'Giggle Band' CONTROLS signOut
END.SHELL

OBJECT Event
  VIEW HomeDashboard DASHBOARD
    CONTEXT ALL Band
    READ_MODEL HomeUpcomingEvents
    FIELDS EventDate StartTime EventType Title VenueName
    SORT EventDate ASC StartTime ASC
    ACTIONS read search
    LAYOUT stack
    DENSITY compact

    STATE showGigs BOOLEAN DEFAULT(true)
    STATE showRehearsals BOOLEAN DEFAULT(true)
    STATE showUnavailable BOOLEAN DEFAULT(true)

    ICON_MAP EventTypeIcon FOR EventType DEFAULT calendar
      Gig -> music
      Rehearsal -> microphone
      Unavailable -> x
    END.ICON_MAP

    STATUS event LABEL 'Gig' ARIA_LABEL 'Gig event' ICON EventTypeIcon(Gig) THEME colorStatusEvent PRECEDENCE 10
    STATUS rehearsal LABEL 'Rehearsal' ARIA_LABEL 'Rehearsal event' ICON EventTypeIcon(Rehearsal) THEME colorStatusAlternate PRECEDENCE 10
    STATUS unavailable LABEL 'Unavailable' ARIA_LABEL 'Unavailable block' ICON EventTypeIcon(Unavailable) THEME colorStatusUnavailable PRECEDENCE 20

    STATUS_MAP EventTypeStatus FOR EventType DEFAULT event
      Gig -> event
      Rehearsal -> rehearsal
      Unavailable -> unavailable
    END.STATUS_MAP

    LEGEND ScheduleStatus TITLE 'Schedule status' STATUSES event rehearsal unavailable

    SECTION Welcome
      HEADING 'Welcome Back!'

      ACTION addEvent CREATE Event LABEL 'Add Event' ICON calendar PLACEMENT primary
      END.ACTION
    END.SECTION

    SECTION Filters
      DENSITY compact

      TOGGLE showGigsToggle STATE showGigs
        LABEL 'Gigs'
        ICON EventTypeIcon(Gig)
      END.TOGGLE

      TOGGLE showRehearsalsToggle STATE showRehearsals
        LABEL 'Rehearsals'
        ICON EventTypeIcon(Rehearsal)
      END.TOGGLE

      TOGGLE showUnavailableToggle STATE showUnavailable
        LABEL 'Unavailable'
        ICON EventTypeIcon(Unavailable)
      END.TOGGLE
    END.SECTION

    SECTION Schedule
      HEADING 'Schedule'

      LIST UpcomingEvents FROM HomeUpcomingEvents
        ORDER BY EventDate ASC, StartTime ASC
        WHERE (EventType == 'Gig' AND showGigs == true) OR (EventType == 'Rehearsal' AND showRehearsals == true) OR (EventType == 'Unavailable' AND showUnavailable == true)
        RENDER_AS compactFeed
        DENSITY compact
        EMPTY_TEXT 'No upcoming events'
        STATUS EventTypeStatus(EventType)

        ROW
          ICON EventTypeIcon(EventType)
          TEXT EventDate FORMAT date 'EEE d MMM'
          TEXT ' '
          TEXT StartTime FORMAT time 'h:mma'
          TEXT ' - '
          TEXT Title STYLE bold
          TEXT ' - '
          TEXT VenueName
        END.ROW
      END.LIST
    END.SECTION

    SECTION Invitations
      HEADING 'Invitations'

      LIST PendingInvitations FROM PendingInvitations
        WHERE Status == 'Pending'
        RENDER_AS compactFeed
        DENSITY compact
        EMPTY_TEXT 'No pending invitations'

        ROW
          TEXT InviteeEmail STYLE bold
          TEXT ' - '
          TEXT Role
          TEXT ' invited on '
          TEXT SentAt FORMAT date 'EEE d MMM'
        END.ROW
      END.LIST
    END.SECTION
  END.VIEW

  VIEW BandEventCalendar DASHBOARD
    CONTEXT REQUIRED Band
    FIELDS Date StartTime EventType Title VenueName
    ACTIONS read search
    LAYOUT stack
    DENSITY compact

    STATE visibleMonth DATE DEFAULT('2026-08-01')

    ICON_MAP CalendarEventTypeIcon FOR EventType DEFAULT calendar
      Gig -> music
      Rehearsal -> microphone
      Unavailable -> x
    END.ICON_MAP

    STATUS event LABEL 'Gig' ARIA_LABEL 'Gig event' ICON CalendarEventTypeIcon(Gig) THEME colorStatusEvent PRECEDENCE 10
    STATUS rehearsal LABEL 'Rehearsal' ARIA_LABEL 'Rehearsal event' ICON CalendarEventTypeIcon(Rehearsal) THEME colorStatusAlternate PRECEDENCE 10
    STATUS unavailable LABEL 'Unavailable' ARIA_LABEL 'Unavailable block' ICON CalendarEventTypeIcon(Unavailable) THEME colorStatusUnavailable PRECEDENCE 20
    STATUS conflict LABEL 'Conflict' ARIA_LABEL 'Scheduling conflict' ICON calendar THEME colorStatusConflict PRECEDENCE 100

    STATUS_MAP CalendarEventTypeStatus FOR EventType DEFAULT event
      Gig -> event
      Rehearsal -> rehearsal
      Unavailable -> unavailable
    END.STATUS_MAP

    LEGEND CalendarStatus TITLE 'Calendar status' STATUSES event rehearsal unavailable conflict

    SECTION PlanningCalendar
      HEADING 'Calendar'

      CALENDAR MonthPlanner FROM READ_MODEL CalendarPlanningItems
        MONTH_STATE visibleMonth
        WEEK_START monday
        DATE_FIELD Date
        TITLE_FIELD Title
        SUMMARY_FIELDS StartTime VenueName
        FIELDS Date StartTime CalendarStatus Title VenueName
        ORDER BY Date ASC, StartTime ASC
        DENSITY compact
        STATUS CalendarEventTypeStatus(CalendarStatus)
        EMPTY_TEXT 'No events in this month'

        ACTION addEventOnDate CREATE Event LABEL 'Add Event' ICON calendar PLACEMENT primary
          INPUT Date FROM Date
        END.ACTION
      END.CALENDAR
    END.SECTION

    # A repeat booking is rarely typed from scratch: a venue that had a band
    # back is asking for the same night, the same contact and the same fee.
    # `duplicateGig` copies every field but `Date` from an existing gig into a
    # fresh create form, landing the user on a prefilled draft with only the
    # new date left to fill in -- the same `CREATE ... INPUT <field> FROM
    # <field>` shape `addEventOnDate` already uses above, just with one input
    # per business field instead of one. Bound to `OBJECT Event` directly
    # (not a read model) so every field the row carries -- including the rich
    # gig fields -- is available to `INPUT ... FROM`.
    SECTION DuplicateGig
      HEADING 'Duplicate a previous gig'

      LIST PreviousGigs FROM OBJECT Event
        ORDER BY Date DESC
        RENDER_AS compactFeed
        DENSITY compact
        EMPTY_TEXT 'No previous gigs to duplicate yet'

        ROW
          TEXT Date FORMAT date 'EEE d MMM'
          TEXT ' - '
          TEXT Title STYLE bold
          TEXT ' - '
          TEXT VenueName
        END.ROW

        # `PreviousGig FROM PreviousGig` copies the row's own `PreviousGig`
        # value forward (its repeat-booking lineage), not the id of the row
        # being duplicated -- a presentation ACTION's `INPUT ... FROM <expr>`
        # only ever sees a row's already-projected field values, never the
        # row's own record id (see
        # `learnings/implementation/ui-presentation-model.md`'s "row-scoped
        # ACTION cannot target an existing record by id"), so there is no
        # expression here that could point the new gig back at this one.
        ACTION duplicateGig CREATE Event LABEL 'Duplicate' ICON list PLACEMENT row
          INPUT EventType FROM EventType
          INPUT StartTime FROM StartTime
          INPUT EndTime FROM EndTime
          INPUT Title FROM Title
          INPUT VenueName FROM VenueName
          INPUT VenueLocation FROM VenueLocation
          INPUT SetList FROM SetList
          INPUT ContactName FROM ContactName
          INPUT ContactPhone FROM ContactPhone
          INPUT ContactEmail FROM ContactEmail
          INPUT Amount FROM Amount
          INPUT PaymentMethod FROM PaymentMethod
          INPUT Agent FROM Agent
          INPUT PreviousGig FROM PreviousGig
          INPUT Notes FROM Notes
        END.ACTION
      END.LIST
    END.SECTION
  END.VIEW
END.OBJECT

OBJECT BandInvitation
  # Admin-facing counterpart to the `HomeDashboard` "Invitations" feed, which
  # only ever shows what is still `Pending`. `RevokeBandInvitation` exists and
  # is exercised directly (see `band-reference-app.test.ts`), the same way
  # `AcceptBandInvitation` has been since Phase 28; the `revoke` row ACTION
  # below is what wires a one-click button to it. This was blocked until
  # Phase 69: a presentation `ACTION`'s `INPUT ... FROM <expr>` only ever saw
  # a row's already-projected field values, with no way to reach a row's own
  # record identity (`meta.guid`) -- see `docs/spec/language.md`'s "Composed
  # View Presentation" section for the `id` token Phase 69 introduced to close
  # exactly this gap, and `duplicateGig` above for the `PLACEMENT row` shape
  # this action reuses.
  VIEW MyInvitationList DASHBOARD
    CONTEXT REQUIRED Band
    READ_MODEL SentBandInvitations
    FIELDS InviteeEmail Role Status SentAt RespondedAt
    SORT SentAt DESC
    ACTIONS read search

    SECTION SentInvitations
      HEADING 'Sent invitations'

      LIST SentInvitationsList FROM READ_MODEL SentBandInvitations
        ORDER BY SentAt DESC
        RENDER_AS table
        DENSITY compact
        EMPTY_TEXT 'No invitations sent yet'

        ROW
          TEXT InviteeEmail STYLE bold
          TEXT ' - '
          TEXT Role
          TEXT ' - '
          TEXT Status
          TEXT ' - '
          TEXT SentAt FORMAT date 'EEE d MMM'
        END.ROW

        # `WHEN Status == 'Pending'` keeps the button off rows that cannot
        # actually be revoked (already accepted, declined, or revoked), even
        # though `RevokeBandInvitation`'s own `REQUIRE Status == 'Pending'`
        # step guard makes this safe either way -- offering it everywhere
        # would just invite a confusing server-side rejection for no reason.
        ACTION revoke COMMAND RevokeBandInvitation LABEL 'Revoke' ICON x PLACEMENT row
          WHEN Status == 'Pending'
          INPUT Invitation FROM id
        END.ACTION
      END.LIST
    END.SECTION
  END.VIEW
END.OBJECT

OBJECT Availability
  # `BandMemberAvailabilityBoard` keeps its whole-band roster (`Who is free`,
  # backed by `BandMemberAvailability`, unchanged) and adds a second section:
  # the signed-in member's own schedule, overlaid with gigs booked with *any*
  # band they belong to, not just the one currently selected. A gig-derived
  # status outranks a plain availability status on the same date -- the same
  # `PRECEDENCE 100` device `BandEventCalendar`'s `conflict` status already
  # uses, reused here so a real booking outranks a stale "I'm free" note on
  # the same date.
  #
  # The label deliberately says "Gig booked" rather than naming which band:
  # a read-model expression only ever sees `RUNTIME.userId` / `RUNTIME.now`
  # (see `docs/spec/language.md`'s Read Models section), never which business
  # context the *consuming view* currently has selected, so nothing here can
  # tell the currently-selected band's own gig apart from another band's. Both
  # are still correctly "booked" -- the wording just does not overclaim which
  # one.
  VIEW BandMemberAvailabilityBoard DASHBOARD
    CONTEXT REQUIRED Band
    READ_MODEL BandMemberAvailability
    FIELDS Member Role Date Status
    SORT Date ASC
    ACTIONS read search
    LAYOUT stack
    DENSITY compact

    STATE visibleMonth DATE DEFAULT('2026-08-01')

    STATUS conflict LABEL 'Gig booked' ARIA_LABEL 'A gig or rehearsal is already booked on this date' ICON calendar THEME colorStatusConflict PRECEDENCE 100
    STATUS available LABEL 'Available' ARIA_LABEL 'Available' ICON calendar THEME colorStatusAvailable PRECEDENCE 10
    STATUS unavailable LABEL 'Unavailable' ARIA_LABEL 'Unavailable' ICON x THEME colorStatusUnavailable PRECEDENCE 20

    STATUS_MAP MyScheduleStatus FOR ScheduleStatus DEFAULT unavailable
      Gig -> conflict
      Rehearsal -> conflict
      Available -> available
      Unavailable -> unavailable
    END.STATUS_MAP

    LEGEND MyScheduleLegend TITLE 'My schedule' STATUSES conflict available unavailable

    SECTION TeamAvailability
      HEADING 'Who is free'

      LIST TeamAvailabilityList FROM READ_MODEL BandMemberAvailability
        ORDER BY Date ASC
        RENDER_AS table
        DENSITY compact
        EMPTY_TEXT 'No availability recorded yet'

        ROW
          TEXT Member STYLE bold
          TEXT ' - '
          TEXT Role
          TEXT ' - '
          TEXT Date FORMAT date 'EEE d MMM'
          TEXT ' - '
          TEXT Status
        END.ROW
      END.LIST
    END.SECTION

    SECTION MySchedule
      HEADING 'My schedule across bands'

      CALENDAR MyScheduleCalendar FROM READ_MODEL MyAvailabilityWithGigs
        MONTH_STATE visibleMonth
        WEEK_START monday
        DATE_FIELD ScheduleDate
        TITLE_FIELD Title
        SUMMARY_FIELDS VenueName
        FIELDS ScheduleDate ScheduleStatus Title VenueName
        ORDER BY ScheduleDate ASC
        DENSITY compact
        STATUS MyScheduleStatus(ScheduleStatus)
        EMPTY_TEXT 'Nothing scheduled this month'
      END.CALENDAR
    END.SECTION
  END.VIEW
END.OBJECT

OBJECT SetList
  VIEW SetListForm FORM
    CONTEXT REQUIRED Band
    EDIT_CONTAINER page
    FIELDS Name Description
    ACTIONS create read update delete

    EDIT_SECTION Details HEADING 'Set list'
      FIELDS Name Description
    END.EDIT_SECTION

    CHILD_COLLECTION Songs HEADING 'Songs'
      CHILD SetListItem PARENT_FIELD SetList
      CHILD_VIEW SetListItemList
      OPERATIONS createChild updateChild remove reorder
      STAGED
      ORDER_FIELD Position
      EMPTY_TEXT 'No songs in this set list yet.'

      # Adding a song is choosing one, not typing its record id. CANDIDATE_FIELD
      # makes each choice mint a SetListItem naming that Song, appended to the end
      # of the set list and ready to be reordered. Songs already in this set list
      # are excluded, so the same song cannot be added twice.
      PICKER SongPicker
        SOURCE OBJECT Song
        CANDIDATE_FIELD Song
        SELECTION multiple
        DISPLAY Title Composer
        SEARCH Title Composer
        SORT Title ASC
        EXCLUDE_LINKED
        EMPTY_TEXT 'Every song in the library is already in this set list.'
      END.PICKER
    END.CHILD_COLLECTION
  END.VIEW
END.OBJECT

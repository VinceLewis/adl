          "direction": "asc"
        }
      ],
      "fields": [
        {
          "name": "InviteeEmail",
          "source": "invitation",
          "field": "InviteeEmail"
        },
        {
          "name": "Role",
          "source": "invitation",
          "field": "Role"
        },
        {
          "name": "Status",
          "source": "invitation",
          "field": "Status"

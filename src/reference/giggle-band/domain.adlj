          ],
          "kind": "list",
          "name": "BandEventList",
          "searchFields": [
            "Title",
            "VenueName",
            "EventType"
          ],
          "sort": [
            {
              "direction": "asc",
              "field": "Date"
            },
            {
              "direction": "asc",
              "field": "StartTime"
            }
          ]
        },
        {
          "actions": [
            "save",
            "delete"
          ],
          "comment": "The `SetLists` child collection replaces what was a single `SetList` lookup\non `Event`. giggle-new's own gig form carries a `Set Lists:` block -- an\nadd-from-dropdown list of *several* set lists in a dragged order, backed by\nits `gig_set_lists(gig_id, set_list_id, position)` table -- so one lookup\ncould never express a two-set night, which is the common case there (an\nopening set and a second set).\n\nNo `EDIT_CONTAINER page`, unlike `SetListForm`'s own `Songs` collection: a\ngig is edited in a modal in giggle-new with its set lists inside it, and a\ngig has a handful of them rather than a whole song library, so the room a\npage buys is room this collection does not need.",
          "context": {
            "context": "Band",
            "mode": "required"
          },
          "editSections": [
            {
              "fields": [
                "EventType",
                "Date",
                "StartTime",
                "EndTime",
                "Title",
                "VenueName",
                "VenueLocation",
                "ContactName",
                "ContactPhone",
                "ContactEmail",
                "Amount",
                "PaymentMethod",
                "Agent",
                "PreviousGig",
                "Notes"
              ],
              "heading": "Event",
              "kind": "fields",
              "name": "Details"
            },
            {
              "childObject": "EventSetList",
              "childView": "EventSetListList",
              "emptyState": {
                "text": "No set lists attached to this event yet."
              },
              "heading": "Set Lists",
              "kind": "childCollection",
              "name": "SetLists",
              "operations": [
                "createChild",
                "updateChild",
                "remove",
                "reorder"
              ],
              "orderField": "Position",
              "parentField": "Event",
              "picker": {
                "candidateField": "SetList",
                "comment": "`EXCLUDE_LINKED` is the modelled form of what giggle-new's gig form does by\nhand: it rebuilds its `availableSetLists` dropdown as every set list minus\nthe ones already attached, because `gig_set_lists`' primary key forbids the\nsame set list twice on one gig. Declaring it here means the constraint is\nenforced by `uniqueSetListForEvent` on the object, not only by a picker that\ndeclines to offer the duplicate.",
                "displayFields": [
                  "Name",
                  "Description"
                ],
                "emptyState": {
                  "text": "Every set list this band has is already attached to this event."
                },
                "name": "EventSetListPicker",
                "searchFields": [
                  "Name"
                ],
                "selection": "multiple",
                "sort": [
                  {
                    "direction": "asc",
                    "field": "Name"
                  }
                ],
                "source": "SetList",
                "sourceKind": "object"
              }
            }
          ],
          "fields": [
            "EventType",
            "Date",
            "StartTime",
            "EndTime",
            "Title",
            "VenueName",
            "VenueLocation",
            "ContactName",
            "ContactPhone",
            "ContactEmail",
            "Amount",
            "PaymentMethod",
            "Agent",
            "PreviousGig",
            "Notes"
          ],
          "kind": "form",
          "name": "BandEventForm",
          "searchFields": [],
          "sort": []
        }

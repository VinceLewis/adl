      ]
    },
    {
      "name": "SentBandInvitations",
      "context": {
        "mode": "required",
        "context": "Band"
      },
      "sources": [
        {
          "name": "invitation",
          "object": "BandInvitation",
          "scope": "currentContext"
        }
      ],
      "sort": [
        {
          "field": "SentAt",
          "direction": "desc"
        }
      ],
      "comment": "The admin-facing counterpart to `PendingInvitations`: every invitation this\nband has sent, in any status, so a `BandAdmin` can see what was accepted,\ndeclined or revoked as well as what is still outstanding. `IsSender` uses\nthe same `runtime.userId` comparison the object's own policy rules already\nuse for `Invitee` (see `BandInvitationPolicy.allowInviteeReadOwnInvitation`)\nso the view can tell an admin which invitations they personally sent.",
      "fields": [
        {
          "name": "InviteeEmail",
          "source": "invitation",
          "field": "InviteeEmail",
          "comment": "`InviteeEmail` leads the field list on purpose: the generic dashboard\nrenderer used by a `READ_MODEL`-backed view with no composed presentation\n(see `MyInvitationList` in `ui.adl`, and `BandMemberAvailabilityBoard` /\n`SetListByPosition` for the same pattern elsewhere in this app) always\nshows every read-model field, using the first non-date field as each\nrow's bold title -- so `Inviter` (a lookup id, not something to read)\ncomes last, alongside the `IsSender` field it only exists to support."
        },
        {
          "name": "Role",
          "source": "invitation",
          "field": "Role"
        },
        {
          "name": "Status",
          "source": "invitation",
          "field": "Status"
        },
        {
          "name": "SentAt",
          "source": "invitation",
          "field": "SentAt"
        },
        {
          "name": "RespondedAt",
          "source": "invitation",
          "field": "RespondedAt"
        },
        {
          "name": "Inviter",
          "source": "invitation",
          "field": "Inviter"
        },
        {
          "name": "IsSender",
          "type": "boolean",
          "expression": "Inviter == RUNTIME.userId"
        }
      ]
    }
  ],
  "decisionTables": [],
  "commands": [
    {
      "name": "AcceptBandInvitation",
      "label": "Accept invitation",
      "inputs": [
        {
          "name": "Invitation",
          "type": "text",
          "required": true
        }
      ],
      "preconditions": [],
      "steps": [
        {
          "name": "acceptInvitation",
          "action": "update",
          "object": "BandInvitation",
          "recordId": {
            "kind": "input",
            "name": "Invitation"
          },
          "patch": {
            "Status": {
              "kind": "literal",
              "value": "Accepted"
            },
            "RespondedAt": {
              "kind": "runtime",
              "property": "today"
            }
          },
          "preconditions": [
            "Invitee == RUNTIME.userId",
            "Status == 'Pending'"
          ]
        },
        {
          "name": "createMembership",
          "action": "create",
          "object": "BandMember",
          "authority": "command",
          "values": {
            "User": {
              "kind": "runtime",
              "property": "userId"
            },
            "Band": {
              "kind": "stepField",
              "step": "acceptInvitation",
              "field": "Band"
            },
            "Role": {
              "kind": "stepField",
              "step": "acceptInvitation",
              "field": "Role"
            },
            "JoinedAt": {
              "kind": "runtime",
              "property": "today"
            }
          },
          "preconditions": []
        }
      ]
    },
    {
      "name": "RevokeBandInvitation",
      "label": "Revoke invitation",
      "inputs": [
        {
          "name": "Invitation",
          "type": "text",
          "required": true
        }
      ],
      "comment": "Revocation is deliberately any-`BandAdmin`, not sender-only: it relies on\n`BandInvitationPolicy.allowBandAdminUpdateInvitations`, the same\nunrestricted admin-management rule that already lets any `BandAdmin`\nupdate or delete a `BandInvitation` regardless of who sent it (see\n`allowBandAdminUpdateInvitations` / `allowBandAdminDeleteInvitations`).\nRestricting it to `Inviter == runtime.userId` would strand a pending\ninvitation the moment its original sender left the band or lost admin\nrights, which is worse product behavior than letting any current admin\nclean it up. `RespondedAt` is left unset because a revoke is not a\nresponse from the invitee (see the `respondedAtRequiredAfterResponse`\nvalidation on `BandInvitation`).",
      "preconditions": [],
      "steps": [
        {
          "name": "revokeInvitation",
          "action": "update",
          "object": "BandInvitation",
          "recordId": {
            "kind": "input",
            "name": "Invitation"
          },
          "patch": {
            "Status": {
              "kind": "literal",
              "value": "Revoked"
            }
          },
          "preconditions": [
            "Status == 'Pending'"
          ]
        }
      ]
    },
    {
      "name": "CreateBand",
      "label": "Create band",
      "inputs": [
        {
          "name": "Name",
          "type": "text",
          "required": true
        },
        {
          "name": "Description",
          "type": "text",
          "required": false
        }
      ],
      "preconditions": [],
      "steps": [
        {
          "name": "createBand",
          "action": "create",
          "object": "Band",
          "values": {
            "Name": {
              "kind": "input",
              "name": "Name"
            },
            "Description": {
              "kind": "input",
              "name": "Description"
            },
            "CreatedBy": {
              "kind": "runtime",
              "property": "userId"
            }
          },
          "establishesContext": "Band",
          "preconditions": []
        },
        {
          "name": "createFounderMembership",
          "action": "create",
          "object": "BandMember",
          "authority": "command",
          "values": {
            "User": {
              "kind": "runtime",
              "property": "userId"
            },

        },
        {
          "name": "Notes",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "ContactName",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "comment": "Booking contact and payment terms travel with the gig, matching the fields\ngiggle-new's own gig form carries (`contact_name`, `contact_phone`,\n`contact_email`, `amount`, `payment_method`, `agent`). `Amount` is a plain\n`NUMBER`, not a `CURRENCY_CODE`-validated field: `CURRENCY_CODE` checks that\na value is three uppercase letters, which is what a currency *code* like\n`'GBP'` looks like, not a fee -- giggle-new itself has no separate currency\nfield, so there is nothing here for `CURRENCY_CODE` to validate.",
          "validators": []
        },
        {
          "name": "ContactPhone",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "regexp",
              "value": "^[0-9 +()-]{7,20}$"
            }
          ]
        },
        {
          "name": "ContactEmail",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "email"
            }
          ]
        },
        {
          "name": "Amount",
          "type": "number",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "min",
              "value": 0
            }
          ]
        },
        {
          "name": "PaymentMethod",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "in",
              "value": [
                "Cash",
                "Cheque",
                "Bank Transfer"
              ]
            }
          ]
        },
        {
          "name": "Agent",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "PreviousGig",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "Event",
            "displayField": "Title"
          },
          "comment": "Self-referencing: naming the gig this one repeats lets a repeat booking\ncarry its history forward without duplicating the earlier record.",
          "validators": []
        },
        {
          "name": "SetList",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "SetList",
            "displayField": "Name"
          },
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [],

          "validators": []
        },
        {
          "hidden": false,
          "name": "Notes",
          "readonly": false,
          "required": false,
          "type": "text",
          "validators": []
        },
        {
          "comment": "Booking contact and payment terms travel with the gig, matching the fields\ngiggle-new's own gig form carries (`contact_name`, `contact_phone`,\n`contact_email`, `amount`, `payment_method`, `agent`). `Amount` is a plain\n`NUMBER`, not a `CURRENCY_CODE`-validated field: `CURRENCY_CODE` checks that\na value is three uppercase letters, which is what a currency *code* like\n`'GBP'` looks like, not a fee -- giggle-new itself has no separate currency\nfield, so there is nothing here for `CURRENCY_CODE` to validate.",
          "hidden": false,
          "name": "ContactName",
          "readonly": false,
          "required": false,
          "type": "text",
          "validators": []
        },
        {
          "hidden": false,
          "name": "ContactPhone",
          "readonly": false,
          "required": false,
          "type": "text",
          "validators": [
            {
              "kind": "regexp",
              "value": "^[0-9 +()-]{7,20}$"
            }
          ]
        },
        {
          "hidden": false,

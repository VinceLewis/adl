    {
      "name": "MyAvailabilityWithGigs",
      "context": {
        "mode": "all",
        "context": "Band"
      },
      "strategy": "union",
      "sources": [
        {
          "name": "event",
          "object": "Event",
          "scope": "allAvailableContexts"
        },
        {
          "name": "availability",
          "object": "Availability",
          "scope": "currentUser"
        }
      ],
      "sort": [
        {
          "field": "ScheduleDate",
          "direction": "asc"
        }
      ],
      "comment": "The cross-band counterpart to `CalendarPlanningItems`: the same union of a\ngig-shaped fact with a personal-availability fact, but the event source is\n`SCOPE allAvailableContexts` (every band the caller belongs to) instead of\n`SCOPE currentContext` (only the selected band). This is what lets a gig\nbooked with a *different* band show up as a same-date overlay on a band's\nown availability board -- exactly the union `HomeUpcomingEvents` already\nuses for the cross-band home feed, reused here for the same reason.\n\n`CONTEXT ALL Band`, matching `HomeUpcomingEvents`, not `CONTEXT REQUIRED\nBand` like the view (`BandMemberAvailabilityBoard`) that consumes this read\nmodel: `ReadModelService.resolveExecutionContext` only drops the caller's\n*selected* business context -- letting `SCOPE allAvailableContexts` reach\nevery band the caller belongs to -- when the read model itself is declared\n`CONTEXT ALL`. Left as `REQUIRED`, `getAllowedContextIds` collapses to the\none already-selected band even though the source says `allAvailableContexts`,\nand a gig from another band silently never appears. A read model may widen a\ncontext requirement past its consuming view's; the view still gates entry\nto the page.",
      "fields": [
        {
          "name": "EventDateSource",
          "source": "event",
          "field": "Date"
        },
        {
          "name": "AvailabilityDate",
          "source": "availability",
          "field": "Date"
        },
        {
          "name": "ScheduleDate",
          "type": "date",
          "expression": "EventDateSource ?? AvailabilityDate"
        },
        {
          "name": "EventTypeSource",
          "source": "event",
          "field": "EventType"
        },
        {
          "name": "AvailabilityStatus",
          "source": "availability",
          "field": "Status"
        },
        {
          "name": "ScheduleStatus",
          "type": "text",
          "expression": "EventTypeSource ?? AvailabilityStatus"
        },
        {
          "name": "EventTitle",
          "source": "event",
          "field": "Title"
        },
        {
          "name": "AvailabilityNotes",
          "source": "availability",
          "field": "Notes"
        },
        {
          "name": "Title",
          "type": "text",
          "expression": "EventTitle ?? AvailabilityNotes"
        },
        {
          "name": "EventVenueName",
          "source": "event",
          "field": "VenueName"
        },
        {
          "name": "VenueName",
          "type": "text",
          "expression": "EventVenueName ?? 'Personal calendar'"
        }
      ]
    },
    {
      "name": "PendingInvitations",
      "context": {
        "mode": "required",
        "context": "Band"
      },
      "sources": [
        {
          "name": "invitation",
          "object": "BandInvitation",
          "scope": "currentContext"

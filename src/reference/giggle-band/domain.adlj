    {
      "name": "BandInvitation",
      "scope": {
        "context": "Band",
        "field": "Band"
      },
      "constraints": [
        {
          "name": "uniqueBandInvitationEmail",
          "kind": "unique",
          "fields": [
            "InviteeEmail"
          ],
          "scopeFields": [
            "Band"
          ]
        }
      ],
      "policies": [],
      "fields": [
        {
          "name": "Band",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "Band",
            "displayField": "Name"
          },
          "validators": []
        },
        {
          "name": "Inviter",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "Name"
          },
          "validators": []
        },
        {
          "name": "Invitee",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "Name"
          },
          "validators": []
        },
        {
          "name": "InviteeEmail",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "email"
            }
          ]
        },
        {
          "name": "Role",
          "type": "text",
          "required": true,
          "defaultValue": "BandMember",
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "in",
              "value": [
                "BandMember"
              ]
            }
          ]
        },
        {
          "name": "Status",
          "type": "text",
          "required": true,
          "defaultValue": "Pending",
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "in",
              "value": [
                "Pending",
                "Accepted",
                "Declined",
                "Revoked"
              ]
            }
          ]
        },
        {
          "name": "SentAt",
          "type": "date",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "RespondedAt",
          "type": "date",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [
        {
          "name": "respondedAtRequiredAfterResponse",
          "expression": "((Status == 'Pending') OR (Status == 'Revoked')) OR (RespondedAt != NULL)",
          "message": "RespondedAt is required when an invitation is accepted or declined.",
          "comment": "A revoke is the sender side withdrawing an invitation nobody has answered\nyet, not a response from the invitee, so it is exempted here the same way\na still-`Pending` invitation is: `RevokeBandInvitation` never sets\n`RespondedAt`, and requiring it would make every revoke fail its own\ncommand's validation."
        }
      ],
      "views": [
        {
          "name": "BandInvitationList",
          "kind": "list",
          "context": {
            "mode": "required",
            "context": "Band"
          },
          "fields": [
            "InviteeEmail",
            "Role",
            "Status",
            "SentAt"
          ],
          "searchFields": [
            "InviteeEmail",
            "Status"
          ],
          "sort": [],
          "actions": [
            "create",
            "read",
            "update",
            "delete"
          ]
        }
      ],
      "sync": {
        "mode": "onlineRequired",
        "scope": "currentContext"
      }
    },

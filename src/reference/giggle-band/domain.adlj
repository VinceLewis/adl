    {
      "comment": "Projects the availability row's own `User` lookup rather than joining the\n`User` object as a second source.\n\nIt used to source `User` with `SCOPE currentUser` purely to project\n`user.Name`, which made the read model depend on a whole-record read grant\non `User` that `UserPolicy` no longer gives an ordinary caller. `FIELD\nUserName FROM availability.User` inherits that field's `LOOKUP User DISPLAY\nName` (Phase 91), so the row carries the musician's id in `values` and\ntheir name in `display`, resolved through the same field-scoped label read\nevery other lookup label in this app uses.",
      "fields": [
        {
          "field": "Date",
          "name": "AvailabilityDate",
          "source": "availability"
        },
        {
          "field": "Status",
          "name": "Status",
          "source": "availability"
        },
        {
          "field": "User",
          "name": "UserName",
          "source": "availability"
        }
      ],
      "name": "CurrentUserAvailability",
      "sort": [
        {
          "direction": "asc",
          "field": "AvailabilityDate"
        }
      ],
      "sources": [
        {
          "name": "availability",
          "object": "Availability",
          "scope": "currentUser"
        }
      ]
    },
    {
      "context": {
        "context": "Band",
        "mode": "required"
      },
      "fields": [
        {
          "field": "Date",
          "name": "EventDate",
          "source": "event"
        },
        {
          "field": "Date",
          "name": "AvailabilityDate",
          "source": "availability"
        },
        {

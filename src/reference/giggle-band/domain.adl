APP 'Giggle Band ADL Example'
  MODEL_VERSION '1.0.0'
  THEME CorporateLight
  START_VIEW HomeDashboard
  OFFLINE_GRACE 30 DAYS
END.APP

ROLE SystemAdmin
ROLE BandMember
ROLE BandAdmin INHERITS BandMember

CONTEXT User OBJECT User SELECTION REQUIRED
CONTEXT Band OBJECT Band SELECTION OPTIONAL AUTO_SELECT false PERSISTENCE local MEMBERSHIP BandMember USER User CONTEXT_FIELD Band ROLE_FIELD Role ROLES BandAdmin BandMember

CONTEXT_GRANT pendingBandInvitation ON Band OBJECT BandInvitation USER Invitee CONTEXT_FIELD Band WHEN Status == 'Pending'

OBJECT User
  KEY Email
  DISPLAY Name
  FIELD Name TEXT REQUIRED
  FIELD Email TEXT REQUIRED EMAIL
  FIELD ProfilePicture ATTACHMENT
  SYNC LOCAL_FIRST SCOPE currentUser

  VIEW UserProfileList LIST
    FIELDS Name Email
    SEARCH Name Email
    ACTIONS read search
  END.VIEW
END.OBJECT

OBJECT Band
  DISPLAY Name
  FIELD Name TEXT REQUIRED
  FIELD Description TEXT
  FIELD Biography TEXT
  FIELD CreatedBy TEXT LOOKUP User DISPLAY Name
  FIELD Facebook TEXT REGEXP('^https?://')
  FIELD Instagram TEXT REGEXP('^https?://')
  FIELD YouTube TEXT REGEXP('^https?://')
  FIELD ProfilePicture ATTACHMENT
  SYNC LOCAL_FIRST SCOPE allAvailableContexts

  VIEW BandDirectory LIST
    CONTEXT ALL Band
    FIELDS Name Description
    SEARCH Name
    ACTIONS read search
  END.VIEW

  VIEW BandProfile FORM
    CONTEXT REQUIRED Band
    FIELDS Name Description Biography Facebook Instagram YouTube ProfilePicture
    ACTIONS save delete
  END.VIEW
END.OBJECT

OBJECT BandMember
  SCOPE Band FIELD Band
  CONSTRAINT uniqueBandMemberUser UNIQUE SCOPE Band FIELDS User
  CONSTRAINT lastBandAdminStanding PROTECTED_ROLE SCOPE Band FIELD Role VALUES ('BandAdmin') MIN(1)
  FIELD User TEXT REQUIRED LOOKUP User DISPLAY Name
  FIELD Band TEXT REQUIRED LOOKUP Band DISPLAY Name
  FIELD Role TEXT REQUIRED IN ('BandAdmin', 'BandMember')
  FIELD JoinedAt DATE
  SYNC LOCAL_FIRST SCOPE allAvailableContexts

  VIEW BandMemberList LIST
    CONTEXT REQUIRED Band
    FIELDS User Role JoinedAt
    SEARCH Role
    ACTIONS read search
  END.VIEW
END.OBJECT

OBJECT BandInvitation
  SCOPE Band FIELD Band
  CONSTRAINT uniqueBandInvitationEmail UNIQUE SCOPE Band FIELDS InviteeEmail
  FIELD Band TEXT REQUIRED LOOKUP Band DISPLAY Name
  FIELD Inviter TEXT REQUIRED LOOKUP User DISPLAY Name
  FIELD Invitee TEXT LOOKUP User DISPLAY Name
  FIELD InviteeEmail TEXT REQUIRED EMAIL
  FIELD Role TEXT REQUIRED DEFAULT('BandMember') IN ('BandMember')
  FIELD Status TEXT REQUIRED DEFAULT('Pending') IN ('Pending', 'Accepted', 'Declined', 'Revoked')
  FIELD SentAt DATE
  FIELD RespondedAt DATE
  # A revoke is the sender side withdrawing an invitation nobody has answered
  # yet, not a response from the invitee, so it is exempted here the same way
  # a still-`Pending` invitation is: `RevokeBandInvitation` never sets
  # `RespondedAt`, and requiring it would make every revoke fail its own
  # command's validation.
  VALIDATE respondedAtRequiredAfterResponse Status == 'Pending' OR Status == 'Revoked' OR RespondedAt != NULL MESSAGE 'RespondedAt is required when an invitation is accepted or declined.'
  SYNC ONLINE_REQUIRED SCOPE currentContext

  VIEW BandInvitationList LIST
    CONTEXT REQUIRED Band
    FIELDS InviteeEmail Role Status SentAt
    SEARCH InviteeEmail Status
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

OBJECT Event
  DISPLAY Title
  SCOPE Band FIELD Band
  FIELD Band TEXT REQUIRED LOOKUP Band DISPLAY Name
  FIELD EventType TEXT REQUIRED DEFAULT('Gig') IN ('Gig', 'Rehearsal')
  FIELD Date DATE REQUIRED
  FIELD StartTime TIME
  FIELD EndTime TIME
  FIELD Title TEXT REQUIRED
  FIELD VenueName TEXT
  FIELD VenueLocation TEXT
  FIELD Notes TEXT
  # Booking contact and payment terms travel with the gig, matching the fields
  # giggle-new's own gig form carries (`contact_name`, `contact_phone`,
  # `contact_email`, `amount`, `payment_method`, `agent`). `Amount` is a plain
  # `NUMBER`, not a `CURRENCY_CODE`-validated field: `CURRENCY_CODE` checks that
  # a value is three uppercase letters, which is what a currency *code* like
  # `'GBP'` looks like, not a fee -- giggle-new itself has no separate currency
  # field, so there is nothing here for `CURRENCY_CODE` to validate.
  FIELD ContactName TEXT
  FIELD ContactPhone TEXT REGEXP('^[0-9 +()-]{7,20}$')
  FIELD ContactEmail TEXT EMAIL
  FIELD Amount NUMBER MIN(0)
  FIELD PaymentMethod TEXT IN ('Cash', 'Cheque', 'Bank Transfer')
  FIELD Agent TEXT
  # Self-referencing: naming the gig this one repeats lets a repeat booking
  # carry its history forward without duplicating the earlier record.
  FIELD PreviousGig TEXT LOOKUP Event DISPLAY Title
  FIELD SetList TEXT LOOKUP SetList DISPLAY Name
  SYNC LOCAL_FIRST SCOPE currentContext WINDOW Date 90 DAYS LIMIT 200

  VIEW BandEventList LIST
    CONTEXT REQUIRED Band
    FIELDS Date StartTime EventType Title VenueName
    SEARCH Title VenueName EventType
    SORT Date ASC StartTime ASC
    ACTIONS create read update delete
  END.VIEW

  VIEW BandEventForm FORM
    CONTEXT REQUIRED Band
    FIELDS EventType Date StartTime EndTime Title VenueName VenueLocation SetList ContactName ContactPhone ContactEmail Amount PaymentMethod Agent PreviousGig Notes
    ACTIONS save delete
  END.VIEW
END.OBJECT

OBJECT Availability
  DISPLAY Date
  CONSTRAINT uniqueUserAvailabilityDate UNIQUE SCOPE User FIELDS Date
  FIELD User TEXT REQUIRED LOOKUP User DISPLAY Name
  FIELD Date DATE REQUIRED
  FIELD Status TEXT REQUIRED IN ('Available', 'Unavailable')
  FIELD Notes TEXT
  SYNC LOCAL_FIRST SCOPE currentUser WINDOW Date 90 DAYS LIMIT 400

  VIEW MyAvailabilityList LIST
    FIELDS Date Status Notes
    SEARCH Status Notes
    SORT Date ASC
    ACTIONS create read update delete
  END.VIEW

  # `BandMemberAvailabilityBoard`'s composed presentation -- the cross-band gig
  # overlay and its status precedence -- is authored in `ui.adl`, matching
  # `HomeDashboard` and `BandEventCalendar`.
END.OBJECT

OBJECT Song
  DISPLAY Title
  SCOPE Band FIELD Band
  CONSTRAINT uniqueSongTitleInBand UNIQUE SCOPE Band FIELDS Title
  FIELD Band TEXT REQUIRED LOOKUP Band DISPLAY Name
  FIELD Title TEXT REQUIRED
  FIELD Composer TEXT
  FIELD DurationSeconds NUMBER MIN(0)
  FIELD Notes TEXT
  SYNC LOCAL_FIRST SCOPE currentContext

  VIEW SongLibrary LIST
    CONTEXT REQUIRED Band
    FIELDS Title Composer DurationSeconds
    SEARCH Title Composer
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

OBJECT SetList
  DISPLAY Name
  SCOPE Band FIELD Band
  CONSTRAINT uniqueSetListNameInBand UNIQUE SCOPE Band FIELDS Name
  FIELD Band TEXT REQUIRED LOOKUP Band DISPLAY Name
  FIELD Name TEXT REQUIRED
  FIELD Description TEXT
  FIELD CreatedBy TEXT LOOKUP User DISPLAY Name
  SYNC LOCAL_FIRST SCOPE currentContext

  VIEW SetListList LIST
    CONTEXT REQUIRED Band
    EDIT_CONTAINER page
    FIELDS Name Description
    SEARCH Name
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

OBJECT SetListItem
  SCOPE Band FIELD Band
  CONSTRAINT orderedSetListItems ORDERED SCOPE Band PARENT SetList POSITION Position REORDER shift COMPACT onDelete
  FIELD Band TEXT REQUIRED LOOKUP Band DISPLAY Name
  FIELD SetList TEXT REQUIRED LOOKUP SetList DISPLAY Name
  FIELD Song TEXT REQUIRED LOOKUP Song DISPLAY Title
  FIELD Position NUMBER REQUIRED MIN(1)
  # A set-list item is not just a link to a song: how it is played, whether it
  # closes the night, and when it was last rehearsed all belong to the item.
  # These are what make the child collection's inline editor exercise the real
  # field renderer -- an enum, a boolean and a date beside the song lookup.
  FIELD Arrangement TEXT DEFAULT('Full') IN ('Full', 'Acoustic', 'Instrumental')
  FIELD Encore BOOLEAN DEFAULT(false)
  FIELD RehearsedOn DATE
  FIELD Notes TEXT
  SYNC LOCAL_FIRST SCOPE currentContext

  VIEW SetListItemList LIST
    CONTEXT REQUIRED Band
    FIELDS SetList Position Song Arrangement Encore RehearsedOn Notes
    SEARCH Notes
    SORT Position ASC
    ACTIONS create read update delete
  END.VIEW

  VIEW SetListByPosition DASHBOARD
    CONTEXT REQUIRED Band
    READ_MODEL SetListItemsByPosition
    FIELDS Position SongTitle SetListName DurationSeconds
    SORT Position ASC
    ACTIONS read search
  END.VIEW
END.OBJECT

OBJECT StreamingLink
  SCOPE Band FIELD Band
  CONSTRAINT uniqueStreamingPlatformForSong UNIQUE SCOPE Song FIELDS Platform
  FIELD Band TEXT REQUIRED LOOKUP Band DISPLAY Name
  FIELD Song TEXT REQUIRED LOOKUP Song DISPLAY Title
  FIELD Platform TEXT REQUIRED IN ('YouTube', 'Spotify', 'Apple Music', 'SoundCloud', 'Bandcamp', 'Tidal', 'Amazon Music', 'Google Drive', 'Device Gallery', 'Other')
  FIELD Url TEXT REQUIRED REGEXP('^https?://')
  SYNC LOCAL_FIRST SCOPE currentContext

  VIEW StreamingLinkList LIST
    CONTEXT REQUIRED Band
    FIELDS Song Platform Url
    SEARCH Platform Url
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

OBJECT DevicePreference
  DISPLAY LastOpenedView
  FIELD User TEXT REQUIRED LOOKUP User DISPLAY Name
  FIELD SelectedBand TEXT LOOKUP Band DISPLAY Name
  FIELD LastOpenedView TEXT
  SYNC LOCAL_PRIVATE SCOPE currentUser

  VIEW DevicePreferenceList LIST
    FIELDS SelectedBand LastOpenedView
    SEARCH LastOpenedView
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

READ_MODEL HomeUpcomingEvents
  CONTEXT ALL Band
  UNION
  SOURCE event OBJECT Event SCOPE allAvailableContexts
  SOURCE availability OBJECT Availability SCOPE currentUser
  FIELD EventDateSource FROM event.Date
  FIELD AvailabilityDate FROM availability.Date
  FIELD EventDate DATE = EventDateSource ?? AvailabilityDate
  FIELD EventStartTime FROM event.StartTime
  FIELD StartTime TIME = EventStartTime ?? NULL
  FIELD EventTypeSource FROM event.EventType
  FIELD AvailabilityStatus FROM availability.Status
  FIELD EventType TEXT = EventTypeSource ?? AvailabilityStatus
  FIELD EventTitle FROM event.Title
  FIELD AvailabilityNotes FROM availability.Notes
  FIELD Title TEXT = EventTitle ?? AvailabilityNotes
  FIELD EventVenueName FROM event.VenueName
  FIELD VenueName TEXT = EventVenueName ?? 'Personal calendar'
  SORT EventDate ASC StartTime ASC
END.READ_MODEL

READ_MODEL SetListItemsByPosition
  CONTEXT REQUIRED Band
  SOURCE item OBJECT SetListItem SCOPE currentContext
  SOURCE setList OBJECT SetList SCOPE currentContext
  SOURCE song OBJECT Song SCOPE currentContext
  FIELD Position FROM item.Position
  FIELD SetListName FROM setList.Name
  FIELD SongTitle FROM song.Title
  FIELD DurationSeconds FROM song.DurationSeconds
  SORT Position ASC
END.READ_MODEL

READ_MODEL CurrentUserAvailability
  SOURCE availability OBJECT Availability SCOPE currentUser
  SOURCE user OBJECT User SCOPE currentUser
  FIELD AvailabilityDate FROM availability.Date
  FIELD Status FROM availability.Status
  FIELD UserName FROM user.Name
  SORT AvailabilityDate ASC
END.READ_MODEL

READ_MODEL CalendarPlanningItems
  CONTEXT REQUIRED Band
  UNION
  SOURCE event OBJECT Event SCOPE currentContext
  SOURCE availability OBJECT Availability SCOPE currentUser
  FIELD EventDate FROM event.Date
  FIELD AvailabilityDate FROM availability.Date
  FIELD Date DATE = EventDate ?? AvailabilityDate
  FIELD StartTime FROM event.StartTime
  FIELD EventType FROM event.EventType
  FIELD AvailabilityStatus FROM availability.Status
  FIELD CalendarStatus TEXT = EventType ?? AvailabilityStatus
  FIELD EventTitle FROM event.Title
  FIELD AvailabilityNotes FROM availability.Notes
  FIELD Title TEXT = EventTitle ?? AvailabilityNotes
  FIELD VenueName FROM event.VenueName
  SORT Date ASC StartTime ASC
END.READ_MODEL

READ_MODEL BandMemberAvailability
  CONTEXT REQUIRED Band
  SOURCE member OBJECT BandMember SCOPE currentContext
  SOURCE availability OBJECT Availability SCOPE all JOIN member ON User == member.User CARDINALITY many
  FIELD Member FROM member.User
  FIELD Role FROM member.Role
  FIELD Date FROM availability.Date
  FIELD Status FROM availability.Status
  SORT Date ASC
END.READ_MODEL

# The cross-band counterpart to `CalendarPlanningItems`: the same union of a
# gig-shaped fact with a personal-availability fact, but the event source is
# `SCOPE allAvailableContexts` (every band the caller belongs to) instead of
# `SCOPE currentContext` (only the selected band). This is what lets a gig
# booked with a *different* band show up as a same-date overlay on a band's
# own availability board -- exactly the union `HomeUpcomingEvents` already
# uses for the cross-band home feed, reused here for the same reason.
#
# `CONTEXT ALL Band`, matching `HomeUpcomingEvents`, not `CONTEXT REQUIRED
# Band` like the view (`BandMemberAvailabilityBoard`) that consumes this read
# model: `ReadModelService.resolveExecutionContext` only drops the caller's
# *selected* business context -- letting `SCOPE allAvailableContexts` reach
# every band the caller belongs to -- when the read model itself is declared
# `CONTEXT ALL`. Left as `REQUIRED`, `getAllowedContextIds` collapses to the
# one already-selected band even though the source says `allAvailableContexts`,
# and a gig from another band silently never appears. A read model may widen a
# context requirement past its consuming view's; the view still gates entry
# to the page.
READ_MODEL MyAvailabilityWithGigs
  CONTEXT ALL Band
  UNION
  SOURCE event OBJECT Event SCOPE allAvailableContexts
  SOURCE availability OBJECT Availability SCOPE currentUser
  FIELD EventDateSource FROM event.Date
  FIELD AvailabilityDate FROM availability.Date
  FIELD ScheduleDate DATE = EventDateSource ?? AvailabilityDate
  FIELD EventTypeSource FROM event.EventType
  FIELD AvailabilityStatus FROM availability.Status
  FIELD ScheduleStatus TEXT = EventTypeSource ?? AvailabilityStatus
  FIELD EventTitle FROM event.Title
  FIELD AvailabilityNotes FROM availability.Notes
  FIELD Title TEXT = EventTitle ?? AvailabilityNotes
  FIELD EventVenueName FROM event.VenueName
  FIELD VenueName TEXT = EventVenueName ?? 'Personal calendar'
  SORT ScheduleDate ASC
END.READ_MODEL

READ_MODEL PendingInvitations
  CONTEXT REQUIRED Band
  SOURCE invitation OBJECT BandInvitation SCOPE currentContext
  FIELD InviteeEmail FROM invitation.InviteeEmail
  FIELD Role FROM invitation.Role
  FIELD Status FROM invitation.Status
  FIELD SentAt FROM invitation.SentAt
  SORT SentAt ASC
END.READ_MODEL

# The admin-facing counterpart to `PendingInvitations`: every invitation this
# band has sent, in any status, so a `BandAdmin` can see what was accepted,
# declined or revoked as well as what is still outstanding. `IsSender` uses
# the same `runtime.userId` comparison the object's own policy rules already
# use for `Invitee` (see `BandInvitationPolicy.allowInviteeReadOwnInvitation`)
# so the view can tell an admin which invitations they personally sent.
READ_MODEL SentBandInvitations
  CONTEXT REQUIRED Band
  SOURCE invitation OBJECT BandInvitation SCOPE currentContext
  # `InviteeEmail` leads the field list on purpose: the generic dashboard
  # renderer used by a `READ_MODEL`-backed view with no composed presentation
  # (see `MyInvitationList` in `ui.adl`, and `BandMemberAvailabilityBoard` /
  # `SetListByPosition` for the same pattern elsewhere in this app) always
  # shows every read-model field, using the first non-date field as each
  # row's bold title -- so `Inviter` (a lookup id, not something to read)
  # comes last, alongside the `IsSender` field it only exists to support.
  FIELD InviteeEmail FROM invitation.InviteeEmail
  FIELD Role FROM invitation.Role
  FIELD Status FROM invitation.Status
  FIELD SentAt FROM invitation.SentAt
  FIELD RespondedAt FROM invitation.RespondedAt
  FIELD Inviter FROM invitation.Inviter
  FIELD IsSender BOOLEAN = Inviter == runtime.userId
  SORT SentAt DESC
END.READ_MODEL

COMMAND AcceptBandInvitation LABEL 'Accept invitation'
  INPUT Invitation TEXT REQUIRED
  STEP acceptInvitation UPDATE BandInvitation ID INPUT Invitation
    VALUE Status LITERAL Accepted
    VALUE RespondedAt RUNTIME today
    REQUIRE Invitee == runtime.userId
    REQUIRE Status == 'Pending'
  END.STEP

  STEP createMembership CREATE BandMember AUTHORITY command
    VALUE User RUNTIME userId
    VALUE Band STEP acceptInvitation FIELD Band
    VALUE Role STEP acceptInvitation FIELD Role
    VALUE JoinedAt RUNTIME today
  END.STEP
END.COMMAND

# Revocation is deliberately any-`BandAdmin`, not sender-only: it relies on
# `BandInvitationPolicy.allowBandAdminUpdateInvitations`, the same
# unrestricted admin-management rule that already lets any `BandAdmin`
# update or delete a `BandInvitation` regardless of who sent it (see
# `allowBandAdminUpdateInvitations` / `allowBandAdminDeleteInvitations`).
# Restricting it to `Inviter == runtime.userId` would strand a pending
# invitation the moment its original sender left the band or lost admin
# rights, which is worse product behavior than letting any current admin
# clean it up. `RespondedAt` is left unset because a revoke is not a
# response from the invitee (see the `respondedAtRequiredAfterResponse`
# validation on `BandInvitation`).
COMMAND RevokeBandInvitation LABEL 'Revoke invitation'
  INPUT Invitation TEXT REQUIRED
  STEP revokeInvitation UPDATE BandInvitation ID INPUT Invitation
    VALUE Status LITERAL Revoked
    REQUIRE Status == 'Pending'
  END.STEP
END.COMMAND

COMMAND CreateBand LABEL 'Create band'
  INPUT Name TEXT REQUIRED
  INPUT Description TEXT OPTIONAL
  STEP createBand CREATE Band ESTABLISHES CONTEXT Band
    VALUE Name INPUT Name
    VALUE Description INPUT Description
    VALUE CreatedBy RUNTIME userId
  END.STEP

  STEP createFounderMembership CREATE BandMember AUTHORITY command
    VALUE User RUNTIME userId
    VALUE Band STEP createBand META guid
    VALUE Role LITERAL BandAdmin
    VALUE JoinedAt RUNTIME today
  END.STEP
END.COMMAND

COMMAND ImportSongs LABEL 'Import songs'
  INPUT Band TEXT REQUIRED
  INPUT Songs LIST REQUIRED
    FIELD Title TEXT REQUIRED
    FIELD Composer TEXT
    FIELD DurationSeconds NUMBER
  END.INPUT
  STEP importSongs CREATE Song FOR EACH Songs
    VALUE Band INPUT Band
    VALUE Title ITEM Title
    VALUE Composer ITEM Composer
    VALUE DurationSeconds ITEM DurationSeconds
  END.STEP
END.COMMAND

COMMAND AddSongsToSetList LABEL 'Add songs to set list'
  INPUT Band TEXT REQUIRED
  INPUT SetList TEXT REQUIRED
  INPUT Items LIST REQUIRED
    FIELD Song TEXT REQUIRED
    FIELD Position NUMBER REQUIRED
  END.INPUT
  STEP addSetListItems CREATE SetListItem FOR EACH Items
    VALUE Band INPUT Band
    VALUE SetList INPUT SetList
    VALUE Song ITEM Song
    VALUE Position ITEM Position
  END.STEP
END.COMMAND

COMMAND ReorderSetList LABEL 'Reorder set list'
  INPUT Items LIST REQUIRED
    FIELD Item TEXT REQUIRED
    FIELD Position NUMBER REQUIRED
  END.INPUT
  STEP moveSetListItems UPDATE SetListItem ID ITEM Item FOR EACH Items
    VALUE Position ITEM Position
  END.STEP
END.COMMAND

POLICY UserSystemAdminPolicy ON User
  RULE allowSystemAdminAllUserOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY BandSystemAdminPolicy ON Band
  RULE allowSystemAdminAllBandOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY BandMemberSystemAdminPolicy ON BandMember
  RULE allowSystemAdminAllBandMemberOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY BandInvitationSystemAdminPolicy ON BandInvitation
  RULE allowSystemAdminAllBandInvitationOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY EventSystemAdminPolicy ON Event
  RULE allowSystemAdminAllEventOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY AvailabilitySystemAdminPolicy ON Availability
  RULE allowSystemAdminAllAvailabilityOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY SongSystemAdminPolicy ON Song
  RULE allowSystemAdminAllSongOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY SetListSystemAdminPolicy ON SetList
  RULE allowSystemAdminAllSetListOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY SetListItemSystemAdminPolicy ON SetListItem
  RULE allowSystemAdminAllSetListItemOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY StreamingLinkSystemAdminPolicy ON StreamingLink
  RULE allowSystemAdminAllStreamingLinkOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY DevicePreferenceSystemAdminPolicy ON DevicePreference
  RULE allowSystemAdminAllDevicePreferenceOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY UserPolicy ON User
  RULE allowBandMemberSearchUsers ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadUsers ALLOW READ ROLE BandMember
END.POLICY

POLICY BandPolicy ON Band
  RULE allowBandMemberSearchBands ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadBand ALLOW READ ROLE BandMember
  RULE allowAuthenticatedCreateOwnBand ALLOW CREATE AUTHENTICATED WHEN CreatedBy == runtime.userId
  RULE allowBandCreatorReadOwnBand ALLOW READ AUTHENTICATED WHEN CreatedBy == runtime.userId
  RULE allowBandAdminUpdateBand ALLOW UPDATE ROLE BandAdmin
  RULE allowBandAdminDeleteBand ALLOW DELETE ROLE BandAdmin
END.POLICY

POLICY BandMemberPolicy ON BandMember
  RULE allowBandMemberSearchMembers ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadMembers ALLOW READ ROLE BandMember
  RULE allowAuthenticatedReadOwnMembership ALLOW READ AUTHENTICATED WHEN User == runtime.userId
  RULE allowBandAdminCreateMembers ALLOW CREATE ROLE BandAdmin
  RULE allowBandAdminUpdateMembers ALLOW UPDATE ROLE BandAdmin
  RULE allowBandAdminDeleteMembers ALLOW DELETE ROLE BandAdmin
END.POLICY

POLICY BandInvitationPolicy ON BandInvitation
  RULE allowBandAdminCreateInvitations ALLOW CREATE ROLE BandAdmin
  RULE allowBandAdminReadInvitations ALLOW READ ROLE BandAdmin
  RULE allowInviteeReadOwnInvitation ALLOW READ AUTHENTICATED WHEN Invitee == runtime.userId
  RULE allowBandAdminSearchInvitations ALLOW SEARCH ROLE BandAdmin
  RULE allowBandAdminUpdateInvitations ALLOW UPDATE ROLE BandAdmin
  RULE allowInviteeAcceptInvitation ALLOW UPDATE AUTHENTICATED WHEN Invitee == runtime.userId AND Status == 'Accepted'
  RULE denyInviteeIdentityInvitationUpdates DENY UPDATE FIELDS Band Inviter Invitee InviteeEmail 'Role' AUTHENTICATED WHEN Invitee == runtime.userId AND Status == 'Accepted'
  RULE allowBandAdminDeleteInvitations ALLOW DELETE ROLE BandAdmin
END.POLICY

POLICY EventPolicy ON Event
  RULE allowBandMemberSearchEvents ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadEvents ALLOW READ ROLE BandMember
  RULE allowBandAdminCreateEvents ALLOW CREATE ROLE BandAdmin
  RULE allowBandAdminUpdateEvents ALLOW UPDATE ROLE BandAdmin
  RULE allowBandAdminDeleteEvents ALLOW DELETE ROLE BandAdmin
  RULE allowBandAdminExportEvents ALLOW EXPORT ROLE BandAdmin
END.POLICY

POLICY AvailabilityPolicy ON Availability
  RULE allowAuthenticatedSearchAvailability ALLOW SEARCH AUTHENTICATED
  RULE allowAuthenticatedCreateAvailability ALLOW CREATE AUTHENTICATED WHEN User == runtime.userId
  RULE allowAvailabilityOwnerRead ALLOW READ AUTHENTICATED WHEN User == runtime.userId
  RULE allowAvailabilityOwnerUpdate ALLOW UPDATE AUTHENTICATED WHEN User == runtime.userId
  RULE allowAvailabilityOwnerDelete ALLOW DELETE AUTHENTICATED WHEN User == runtime.userId
  RULE allowAvailabilityOwnerExport ALLOW EXPORT AUTHENTICATED WHEN User == runtime.userId
  RULE allowBandMemberReadSharedAvailability ALLOW READ CONTEXT_MEMBER Band FIELD User
END.POLICY

POLICY SongPolicy ON Song
  RULE allowBandMemberSearchSongs ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadSongs ALLOW READ ROLE BandMember
  RULE allowBandAdminCreateSongs ALLOW CREATE ROLE BandAdmin
  RULE allowBandAdminUpdateSongs ALLOW UPDATE ROLE BandAdmin
  RULE allowBandAdminDeleteSongs ALLOW DELETE ROLE BandAdmin
END.POLICY

POLICY SetListPolicy ON SetList
  RULE allowBandMemberSearchSetLists ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadSetLists ALLOW READ ROLE BandMember
  RULE allowBandAdminCreateSetLists ALLOW CREATE ROLE BandAdmin
  RULE allowBandAdminUpdateSetLists ALLOW UPDATE ROLE BandAdmin
  RULE allowBandAdminDeleteSetLists ALLOW DELETE ROLE BandAdmin
END.POLICY

POLICY SetListItemPolicy ON SetListItem
  RULE allowBandMemberSearchSetListItems ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadSetListItems ALLOW READ ROLE BandMember
  RULE allowBandAdminCreateSetListItemsWithPosition ALLOW CREATE ROLE BandAdmin
  RULE allowBandAdminUpdateSetListItems ALLOW UPDATE ROLE BandAdmin
  RULE allowBandAdminDeleteSetListItems ALLOW DELETE ROLE BandAdmin
END.POLICY

POLICY StreamingLinkPolicy ON StreamingLink
  RULE allowBandMemberSearchStreamingLinks ALLOW SEARCH ROLE BandMember
  RULE allowBandMemberReadStreamingLinks ALLOW READ ROLE BandMember
  RULE allowBandAdminCreateStreamingLinks ALLOW CREATE ROLE BandAdmin
  RULE allowBandAdminUpdateStreamingLinks ALLOW UPDATE ROLE BandAdmin
  RULE allowBandAdminDeleteStreamingLinks ALLOW DELETE ROLE BandAdmin
END.POLICY

POLICY DevicePreferencePolicy ON DevicePreference
  RULE allowAuthenticatedSearchDevicePreferences ALLOW SEARCH AUTHENTICATED
  RULE allowAuthenticatedCreateDevicePreferences ALLOW CREATE AUTHENTICATED
  RULE allowDevicePreferenceOwnerRead ALLOW READ OWNER
  RULE allowDevicePreferenceOwnerUpdate ALLOW UPDATE OWNER
  RULE allowDevicePreferenceOwnerDelete ALLOW DELETE OWNER
END.POLICY

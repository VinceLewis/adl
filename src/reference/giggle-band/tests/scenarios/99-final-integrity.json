{
  "version": 1,
  "name": "giggle.final-integrity",
  "fixture": "giggle.admin-seeded.v1",
  "defaults": {"timeout": "5s"},
  "steps": [
    {"id": "startup", "op": "settle"},
    {"id": "show-the-permanent-drawer", "op": "resize", "size": {"width": 1400, "height": 1900}, "metric": {"pxPerDp": 1, "pxPerSp": 1}},
    {"id": "resized", "op": "settle"},
    {"id": "select-the-user-context", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "User: Casey Morgan"}]}},
    {"id": "user-selected", "op": "settle"},
    {"id": "open-the-context-sheet", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "Context Selector: User: Casey Morgan"}]}},
    {"id": "sheet-open", "op": "settle"},
    {"id": "select-the-band", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "Band: The Alphas"}]}},
    {"id": "band-selected", "op": "settle"},

    {"id": "the-caller-holds-both-roles", "op": "expectProbe", "probe": "giggle.contexts", "args": {},
     "equals": {"bands": [{"record": "band-alphas", "role": "BandAdmin"}, {"record": "band-betas", "role": "BandMember"}],
      "selected": [{"name": "Band", "record": "band-alphas"}, {"name": "User", "record": "user-casey"}], "selectedCount": 2}},

    {"id": "the-headline-set-list-is-intact", "op": "expectProbe", "probe": "giggle.set_list_integrity", "args": {"setList": "setlist-headline"},
     "equals": {"setList": "setlist-headline", "songAliases": ["song-neon-map", "song-late-signal", "song-harbour-lights"],
      "positions": [1, 2, 3], "uniqueSongs": true, "contiguousPositions": true, "totalDurationSeconds": 638}},
    {"id": "the-rehearsal-set-list-is-intact", "op": "expectProbe", "probe": "giggle.set_list_integrity", "args": {"setList": "setlist-rehearsal"},
     "equals": {"setList": "setlist-rehearsal", "songAliases": ["song-slow-tide"],
      "positions": [1], "uniqueSongs": true, "contiguousPositions": true, "totalDurationSeconds": 245}},
    {"id": "the-event-links-are-intact", "op": "expectProbe", "probe": "giggle.event_set_list_integrity", "args": {"event": "event-headline"},
     "equals": {"event": "event-headline", "setListAliases": ["setlist-headline", "setlist-rehearsal"],
      "positions": [1, 2], "uniqueSetLists": true, "contiguousPositions": true}},

    {"id": "no-other-bands-library-leaks-into-this-context", "op": "expectProbe", "probe": "giggle.no_cross_context_leak",
     "args": {"object": "Song", "context": "band-alphas",
      "expected": ["song-harbour-lights", "song-late-signal", "song-library-001", "song-library-072", "song-neon-map", "song-slow-tide"],
      "forbidden": ["song-beta-only"]},
     "equals": {"object": "Song", "context": "band-alphas", "expectedPresent": true,
      "forbiddenPresent": [], "unexpected": [], "clean": true}},
    {"id": "set-lists-are-scoped-too", "op": "expectProbe", "probe": "giggle.no_cross_context_leak",
     "args": {"object": "SetList", "context": "band-alphas",
      "expected": ["setlist-headline", "setlist-rehearsal"], "forbidden": []},
     "equals": {"object": "SetList", "context": "band-alphas", "expectedPresent": true,
      "forbiddenPresent": [], "unexpected": [], "clean": true}},

    {"id": "every-declared-object-holds-its-seeded-rows", "op": "expectProbe", "probe": "records", "args": {"object": "User"},
     "equals": {"object": "User", "count": 2, "aliasCount": 2, "aliases": ["user-casey", "user-riley"], "unaliased": 0, "truncated": false}},
    {"id": "bands-are-intact", "op": "expectProbe", "probe": "records", "args": {"object": "Band"},
     "equals": {"object": "Band", "count": 2, "aliasCount": 2, "aliases": ["band-alphas", "band-betas"], "unaliased": 0, "truncated": false}},
    {"id": "memberships-are-intact", "op": "expectProbe", "probe": "records", "args": {"object": "BandMember"},
     "equals": {"object": "BandMember", "count": 3, "aliasCount": 3,
      "aliases": ["member-casey-alphas", "member-casey-betas", "member-riley-alphas"], "unaliased": 0, "truncated": false}},
    {"id": "no-invitation-exists-in-this-fixture", "op": "expectProbe", "probe": "records", "args": {"object": "BandInvitation"},
     "equals": {"object": "BandInvitation", "count": 0, "aliasCount": 0, "aliases": [], "unaliased": 0, "truncated": false}},
    {"id": "availability-is-intact", "op": "expectProbe", "probe": "records", "args": {"object": "Availability"},
     "equals": {"object": "Availability", "count": 4, "aliasCount": 4,
      "aliases": ["avail-conflict", "avail-free", "avail-prep", "avail-riley"], "unaliased": 0, "truncated": false}},
    {"id": "set-list-items-are-intact", "op": "expectProbe", "probe": "records", "args": {"object": "SetListItem"},
     "equals": {"object": "SetListItem", "count": 4, "aliasCount": 4,
      "aliases": ["item-headline-1", "item-headline-2", "item-headline-3", "item-rehearsal-1"], "unaliased": 0, "truncated": false}},
    {"id": "event-set-lists-are-intact", "op": "expectProbe", "probe": "records", "args": {"object": "EventSetList"},
     "equals": {"object": "EventSetList", "count": 2, "aliasCount": 2,
      "aliases": ["eventsetlist-headline-1", "eventsetlist-headline-2"], "unaliased": 0, "truncated": false}},
    {"id": "streaming-links-are-intact", "op": "expectProbe", "probe": "records", "args": {"object": "StreamingLink"},
     "equals": {"object": "StreamingLink", "count": 2, "aliasCount": 2,
      "aliases": ["link-neon-spotify", "link-neon-youtube"], "unaliased": 0, "truncated": false}},
    {"id": "device-preferences-are-intact", "op": "expectProbe", "probe": "records", "args": {"object": "DevicePreference"},
     "equals": {"object": "DevicePreference", "count": 1, "aliasCount": 1,
      "aliases": ["preference-casey"], "unaliased": 0, "truncated": false}},

    {"id": "reading-the-model-wrote-nothing", "op": "expectProbe", "probe": "operations", "args": {},
     "equals": {"status": "", "count": 0, "operations": [], "truncated": false}},
    {"id": "the-dashboard-has-no-grid-surface", "op": "expectSnapshot", "component": "grid", "pointer": "/available", "equals": false},
    {"id": "nothing-is-stacked-over-the-dashboard", "op": "expectSnapshot", "component": "router", "pointer": "/modalCount", "equals": 0},
    {"id": "no-guard-is-pending", "op": "expectSnapshot", "component": "dialog", "pointer": "/available", "equals": false},

    {"id": "final-capture", "op": "capture", "name": "giggle-final-integrity",
     "components": ["router", "shell", "grid"], "screenshot": "optional"}
  ]
}

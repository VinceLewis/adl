{
  "version": 1,
  "name": "giggle.connected-fail-closed",
  "fixture": "giggle.invitee-seeded.v1",
  "defaults": {"timeout": "5s"},
  "steps": [
    {"id": "startup", "op": "settle"},
    {"id": "show-the-permanent-drawer", "op": "resize", "size": {"width": 1400, "height": 1900}, "metric": {"pxPerDp": 1, "pxPerSp": 1}},
    {"id": "resized", "op": "settle"},
    {"id": "the-app-opens-on-the-declared-start-view", "op": "expectSnapshot", "component": "router", "pointer": "/route/name", "equals": "HomeDashboard"},

    {"id": "connectivity-is-unavailable-before-any-context-is-chosen", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Connection"}]}, "expect": "disabled"},
    {"id": "sync-is-unavailable-before-any-context-is-chosen", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Sync Status"}]}, "expect": "disabled"},
    {"id": "sign-out-is-unavailable-before-any-context-is-chosen", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Sign out"}]}, "expect": "disabled"},
    {"id": "the-reason-is-shown-to-the-musician", "op": "expect", "selector": {"label": "Available when connected"}, "expect": "present"},

    {"id": "choose-the-user-context", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "User: Casey Morgan"}]}},
    {"id": "user-context-chosen", "op": "settle"},
    {"id": "open-the-context-sheet", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "Context Selector: User: Casey Morgan"}]}},
    {"id": "context-sheet-open", "op": "settle"},
    {"id": "administer-the-alphas", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "Band: The Alphas"}]}},
    {"id": "alphas-selected", "op": "settle"},
    {"id": "the-session-is-scoped-to-the-alphas-and-to-casey", "op": "expectProbe", "probe": "client_state", "args": {},
     "equals": {"authenticated": true, "modalDepth": 0, "route": "HomeDashboard", "routeDepth": 1,
       "selectedContextCount": 2,
       "selectedContexts": [{"name": "Band", "record": "band-alphas"}, {"name": "User", "record": "user-casey"}],
       "selectedContextsTruncated": false, "theme": "light"}},

    {"id": "the-context-selector-beside-them-is-live-so-the-top-bar-is-interactive", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Context Selector: Band: The Alphas; User: Casey Morgan"}]}, "expect": "enabled"},
    {"id": "connectivity-is-still-unavailable-with-a-band-in-hand", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Connection"}]}, "expect": "disabled"},
    {"id": "the-connection-control-reports-disabled-semantically-not-just-visually", "op": "expectSnapshot", "component": "shell", "pointer": "/topBar/1/enabled", "equals": false},
    {"id": "and-it-is-the-connection-control-that-is-disabled", "op": "expectSnapshot", "component": "shell", "pointer": "/topBar/1/id", "equals": "connection"},
    {"id": "the-connection-control-carries-a-machine-readable-reason", "op": "expectSnapshot", "component": "shell", "pointer": "/topBar/1/disabledReason", "equals": "host or connected capability is unavailable"},
    {"id": "sync-is-still-unavailable-with-a-band-in-hand", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Sync Status"}]}, "expect": "disabled"},
    {"id": "the-sync-control-reports-disabled-semantically-not-just-visually", "op": "expectSnapshot", "component": "shell", "pointer": "/topBar/2/enabled", "equals": false},
    {"id": "and-it-is-the-sync-control-that-is-disabled", "op": "expectSnapshot", "component": "shell", "pointer": "/topBar/2/id", "equals": "syncStatus"},
    {"id": "the-sync-control-carries-a-machine-readable-reason", "op": "expectSnapshot", "component": "shell", "pointer": "/topBar/2/disabledReason", "equals": "host or connected capability is unavailable"},
    {"id": "sign-out-is-still-unavailable-with-a-band-in-hand", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Sign out"}]}, "expect": "disabled"},
    {"id": "the-sign-out-control-reports-disabled-semantically-not-just-visually", "op": "expectSnapshot", "component": "shell", "pointer": "/drawerControls/2/enabled", "equals": false},
    {"id": "and-it-is-the-sign-out-control-that-is-disabled", "op": "expectSnapshot", "component": "shell", "pointer": "/drawerControls/2/id", "equals": "signOut"},
    {"id": "the-sign-out-control-carries-a-machine-readable-reason", "op": "expectSnapshot", "component": "shell", "pointer": "/drawerControls/2/disabledReason", "equals": "host or connected capability is unavailable"},
    {"id": "the-drawer-still-states-the-reason-in-words", "op": "expect", "selector": {"label": "Available when connected"}, "expect": "present"},
    {"id": "the-neighbouring-theme-switch-is-not-swept-up-in-the-lockout", "op": "expect", "selector": {"all": [{"role": "switch"}, {"name": "Theme"}]}, "expect": "enabled"},
    {"id": "connected-controls", "op": "capture", "name": "connected-controls-disabled", "components": ["shell", "router"], "screenshot": "optional"},

    {"id": "open-the-invitations-addressed-to-this-musician", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "My Invitations"}]}},
    {"id": "my-invitations-open", "op": "settle"},
    {"id": "the-my-invitations-view-is-routed", "op": "expectSnapshot", "component": "router", "pointer": "/route/name", "equals": "MyBandInvitationList"},
    {"id": "the-view-renders-its-declared-heading", "op": "expect", "selector": {"label": "Your invitations"}, "expect": "present"},
    {"id": "and-it-renders-the-seeded-pending-invitation", "op": "expect", "selector": {"text": "invited as   BandMember   on"}, "expect": "present"},
    {"id": "no-accept-action-is-offered-on-a-connected-only-object", "op": "expect", "selector": {"label": "Accept"}, "expect": "absent"},
    {"id": "and-no-accept-button-is-reachable-by-name-either", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Accept"}]}, "expect": "absent"},
    {"id": "no-invitation-can-be-created-from-this-view", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "ADD"}]}, "expect": "absent"},
    {"id": "no-invitation-can-be-deleted-from-this-view", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "DELETE"}]}, "expect": "absent"},
    {"id": "no-invitation-can-be-saved-from-this-view", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "SAVE"}]}, "expect": "absent"},
    {"id": "no-editor-is-exposed-on-the-connected-only-view", "op": "expect", "selector": {"role": "editor"}, "expect": "absent"},
    {"id": "reading-the-view-opened-no-modal-and-committed-nothing", "op": "expectSnapshot", "component": "router", "pointer": "/modalCount", "equals": 0},
    {"id": "nothing-was-written-by-visiting-my-invitations", "op": "expectProbe", "probe": "operations", "args": {},
     "equals": {"status": "", "count": 0, "operations": [], "truncated": false}},

    {"id": "open-the-invitations-this-administrator-sent", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "Sent Invitations"}]}},
    {"id": "sent-invitations-open", "op": "settle"},
    {"id": "the-sent-invitations-view-is-routed", "op": "expectSnapshot", "component": "router", "pointer": "/route/name", "equals": "MyInvitationList"},
    {"id": "the-sent-view-renders-its-declared-heading", "op": "expect", "selector": {"label": "Sent invitations"}, "expect": "present"},
    {"id": "the-pending-invitation-reads-exactly-as-seeded", "op": "expect", "selector": {"label": "pending@example.com   -   BandMember   -   Pending   -   Tue 7 Jul"}, "expect": "present"},
    {"id": "the-accepted-invitation-reads-exactly-as-seeded", "op": "expect", "selector": {"label": "riley@example.com   -   BandMember   -   Accepted   -   Sun 5 Jul"}, "expect": "present"},
    {"id": "the-declined-invitation-reads-exactly-as-seeded", "op": "expect", "selector": {"label": "declined@example.com   -   BandMember   -   Declined   -   Sat 4 Jul"}, "expect": "present"},
    {"id": "the-revoked-invitation-reads-exactly-as-seeded", "op": "expect", "selector": {"label": "revoked@example.com   -   BandMember   -   Revoked   -   Fri 3 Jul"}, "expect": "present"},

    {"id": "exactly-one-row-offers-revoke-because-only-one-is-pending", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Revoke"}]}, "expect": "count", "count": 1},
    {"id": "the-revoke-row-action-fails-closed-while-disconnected", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Revoke"}]}, "expect": "disabled"},
    {"id": "the-revoke-row-action-states-why-it-is-unavailable", "op": "expect", "selector": {"description": "operation requires connected delivery"}, "expect": "present"},
    {"id": "no-invitation-can-be-created-from-the-sent-view", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "ADD"}]}, "expect": "absent"},
    {"id": "no-invitation-can-be-deleted-from-the-sent-view", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "DELETE"}]}, "expect": "absent"},
    {"id": "no-invitation-can-be-saved-from-the-sent-view", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "SAVE"}]}, "expect": "absent"},
    {"id": "no-editor-is-exposed-on-the-sent-view", "op": "expect", "selector": {"role": "editor"}, "expect": "absent"},
    {"id": "drive-the-pending-row-itself-since-its-action-cannot-be-driven", "op": "tap", "selector": {"label": "pending@example.com   -   BandMember   -   Pending   -   Tue 7 Jul"}},
    {"id": "pending-row-driven", "op": "settle"},
    {"id": "driving-the-row-opened-no-editor", "op": "expectSnapshot", "component": "router", "pointer": "/route/name", "equals": "MyInvitationList"},
    {"id": "driving-the-row-pushed-nothing-onto-the-stack", "op": "expectSnapshot", "component": "router", "pointer": "/stackCount", "equals": 3},
    {"id": "driving-the-row-opened-no-modal", "op": "expectSnapshot", "component": "router", "pointer": "/modalCount", "equals": 0},
    {"id": "driving-the-row-opened-no-confirmation", "op": "expectSnapshot", "component": "dialog", "pointer": "/available", "equals": false},
    {"id": "the-pending-invitation-still-reads-pending-after-being-driven", "op": "expect", "selector": {"label": "pending@example.com   -   BandMember   -   Pending   -   Tue 7 Jul"}, "expect": "present"},
    {"id": "the-revoke-action-is-still-refused-after-the-attempt", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Revoke"}]}, "expect": "disabled"},
    {"id": "nothing-was-written-by-driving-the-invitation-row", "op": "expectProbe", "probe": "operations", "args": {},
     "equals": {"status": "", "count": 0, "operations": [], "truncated": false}},
    {"id": "the-connected-controls-remain-disabled-on-this-view-too", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Connection"}]}, "expect": "disabled"},
    {"id": "and-sign-out-remains-disabled-on-this-view-too", "op": "expect", "selector": {"all": [{"role": "button"}, {"name": "Sign out"}]}, "expect": "disabled"},
    {"id": "sent-invitations", "op": "capture", "name": "sent-invitations-fail-closed", "components": ["shell", "router"], "screenshot": "optional"},

    {"id": "return-home-where-the-same-invitation-is-summarised", "op": "tap", "selector": {"all": [{"role": "button"}, {"name": "Home"}]}},
    {"id": "home-open", "op": "settle"},
    {"id": "the-home-dashboard-is-routed", "op": "expectSnapshot", "component": "router", "pointer": "/route/name", "equals": "HomeDashboard"},
    {"id": "home-renders-its-invitations-section", "op": "expect", "selector": {"label": "Invitations"}, "expect": "present"},
    {"id": "home-offers-no-accept-either", "op": "expect", "selector": {"label": "Accept"}, "expect": "absent"},
    {"id": "home-offers-no-revoke-either", "op": "expect", "selector": {"label": "Revoke"}, "expect": "absent"},

    {"id": "every-seeded-invitation-still-exists-and-none-was-added", "op": "expectProbe", "probe": "records", "args": {"object": "BandInvitation"},
     "equals": {"object": "BandInvitation", "count": 4, "aliasCount": 4,
       "aliases": ["invitation-accepted", "invitation-declined", "invitation-pending", "invitation-revoked"],
       "unaliased": 0, "truncated": false}},
    {"id": "not-one-invitation-was-revised", "op": "expectProbe", "probe": "revisions",
     "args": {"records": ["invitation-accepted", "invitation-declined", "invitation-pending", "invitation-revoked"]},
     "equals": {"records": [
       {"alias": "invitation-accepted", "found": true, "revision": "current", "auditEntries": 0, "deleted": false},
       {"alias": "invitation-declined", "found": true, "revision": "current", "auditEntries": 0, "deleted": false},
       {"alias": "invitation-pending", "found": true, "revision": "current", "auditEntries": 0, "deleted": false},
       {"alias": "invitation-revoked", "found": true, "revision": "current", "auditEntries": 0, "deleted": false}]}},
    {"id": "no-audit-row-was-written-against-the-pending-invitation", "op": "expectProbe", "probe": "audit", "args": {"record": "invitation-pending"},
     "equals": {"record": "invitation-pending", "count": 0, "entries": [], "truncated": false}},
    {"id": "no-audit-row-was-written-against-the-accepted-invitation", "op": "expectProbe", "probe": "audit", "args": {"record": "invitation-accepted"},
     "equals": {"record": "invitation-accepted", "count": 0, "entries": [], "truncated": false}},
    {"id": "no-operation-was-queued-accepted-or-rejected", "op": "expectProbe", "probe": "operations", "args": {},
     "equals": {"status": "", "count": 0, "operations": [], "truncated": false}},
    {"id": "no-operation-is-pending-delivery-either", "op": "expectProbe", "probe": "operations", "args": {"status": "pending"},
     "equals": {"status": "pending", "count": 0, "operations": [], "truncated": false}},
    {"id": "the-runtime-was-never-asked-to-run-an-invitation-command", "op": "expectProbe", "probe": "runtime_calls", "args": {"kind": "command"},
     "equals": {"count": 0, "calls": [], "truncated": false}},
    {"id": "no-membership-was-granted-by-an-unaccepted-invitation", "op": "expectProbe", "probe": "records", "args": {"object": "BandMember"},
     "equals": {"object": "BandMember", "count": 3, "aliasCount": 3,
       "aliases": ["member-casey-alphas", "member-casey-betas", "member-riley-alphas"], "unaliased": 0, "truncated": false}},
    {"id": "no-band-was-created-or-removed", "op": "expectProbe", "probe": "records", "args": {"object": "Band"},
     "equals": {"object": "Band", "count": 2, "aliasCount": 2, "aliases": ["band-alphas", "band-betas"], "unaliased": 0, "truncated": false}},
    {"id": "no-user-was-created-or-removed", "op": "expectProbe", "probe": "records", "args": {"object": "User"},
     "equals": {"object": "User", "count": 2, "aliasCount": 2, "aliases": ["user-casey", "user-riley"], "unaliased": 0, "truncated": false}},
    {"id": "the-session-is-still-signed-in-because-sign-out-could-not-run", "op": "expectProbe", "probe": "client_state", "args": {},
     "equals": {"authenticated": true, "modalDepth": 0, "route": "HomeDashboard", "routeDepth": 4,
       "selectedContextCount": 2,
       "selectedContexts": [{"name": "Band", "record": "band-alphas"}, {"name": "User", "record": "user-casey"}],
       "selectedContextsTruncated": false, "theme": "light"}}
  ]
}

          "state": [],
          "fields": []
        },
        {
          "name": "allowCircleOwnerReadInvites",
          "effect": "allow",
          "principal": {
            "match": "specific",
            "roles": [
              "CircleOwner"
            ],
            "groupRoles": [],
            "users": [],
            "owner": false
          },
          "action": "read",
          "state": [],
          "fields": []
        },
        {
          "name": "allowInviteeReadOwnInvite",
          "effect": "allow",
          "principal": {
            "match": "authenticated",
            "roles": [],
            "groupRoles": [],
            "users": [],
            "owner": false
          },
          "action": "read",
          "state": [],
          "fields": [],
          "condition": "Invitee == RUNTIME.userId"
        },
        {
          "name": "allowAuthenticatedSearchInvites",
          "effect": "allow",
          "principal": {
            "match": "authenticated",
            "roles": [],
            "groupRoles": [],
            "users": [],
            "owner": false
          },
          "action": "search",
          "state": [],
          "fields": [],
          "comment": "Deliberately unconditioned, matching `AvailabilityPolicy.\nallowAuthenticatedSearchAvailability` in Giggle Band: a `SEARCH` rule's\n`WHEN` is checked against `request.record`, which a coarse \"may this\nprincipal search this object at all\" gate never has -- `Invitee ==\nruntime.userId` would evaluate against no record and always fail, so a\nconditioned `ALLOW SEARCH ... WHEN` can never actually grant search.\n`MyPendingCircleInvites` (`ui.adlj`'s `MyPendingInvites` view) is the one\ncross-circle read model this app has where the *invitee*, not a\n`CircleOwner`, is the caller; row-level shaping still narrows what comes\nback to just their own invite via `allowInviteeReadOwnInvite` above."
        },
        {
          "name": "allowCircleOwnerUpdateInvites",
          "effect": "allow",
          "principal": {
            "match": "specific",
            "roles": [
              "CircleOwner"
            ],
            "groupRoles": [],
            "users": [],
            "owner": false
          },
          "action": "update",
          "state": [],
          "fields": []
        },
        {
          "name": "allowInviteeRespondToInvite",
          "effect": "allow",
          "principal": {
            "match": "authenticated",
            "roles": [],
            "groupRoles": [],
            "users": [],
            "owner": false
          },
          "action": "update",
          "state": [],
          "fields": [],
          "condition": "(Invitee == RUNTIME.userId) AND ((Status == 'accepted') OR (Status == 'declined'))"
        },
        {
          "name": "denyInviteeIdentityInviteUpdates",
          "effect": "deny",
          "principal": {
            "match": "authenticated",
            "roles": [],
            "groupRoles": [],
            "users": [],
            "owner": false
          },
          "action": "update",
          "state": [],
          "fields": [
            "Circle",
            "InvitedBy",
            "Invitee",
            "InviteeEmail"
          ],
          "condition": "(Invitee == RUNTIME.userId) AND ((Status == 'accepted') OR (Status == 'declined'))"
        },
        {
          "name": "allowCircleOwnerDeleteInvites",
          "effect": "allow",
          "principal": {

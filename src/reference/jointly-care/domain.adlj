    {
      "name": "CircleInvitePolicy",
      "object": "CircleInvite",
      "rules": [
        {
          "name": "allowCircleOwnerCreateInvites",
          "effect": "allow",
          "principal": {
            "match": "specific",
            "roles": [
              "CircleOwner"

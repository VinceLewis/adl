            "targetObject": "User",
            "displayField": "DisplayName"
          },
          "comment": "Optional -- see `Circle.Owner` above for why a plain create form cannot\nstamp the current user onto this field. Populated by seed/test data, and\navailable for a future command to set deliberately.",
          "validators": []
        },
        {
          "name": "Title",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "Description",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "Location",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "StartsAt",
          "type": "datetime",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "EndsAt",
          "type": "datetime",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "AllDay",
          "type": "boolean",
          "required": false,
          "defaultValue": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [
        {
          "name": "endsAtNotBeforeStartsAt",
          "expression": "(EndsAt == NULL) OR (EndsAt >= StartsAt)",
          "message": "EndsAt must not be before StartsAt."
        }
      ],
      "views": [
        {
          "name": "CircleEventList",
          "kind": "list",
          "context": {
            "mode": "required",
            "context": "Circle"
          },
          "fields": [
            "StartsAt",
            "Title",
            "Location",
            "AllDay"
          ],
          "searchFields": [
            "Title",
            "Location"
          ],
          "sort": [
            {
              "field": "StartsAt",
              "direction": "asc"
            }
          ],
          "actions": [
            "create",
            "read",
            "update",
            "delete"
          ]
        },
        {
          "name": "CircleEventForm",
          "kind": "form",
          "context": {
            "mode": "required",
            "context": "Circle"
          },
          "fields": [
            "Title",
            "Description",
            "Location",
            "StartsAt",
            "EndsAt",
            "AllDay"
          ],
          "searchFields": [],
          "sort": [],
          "actions": [
            "save",
            "delete"
          ]
        }
      ],
      "sync": {
        "mode": "localFirst",
        "scope": "currentContext",
        "window": {
          "field": "StartsAt",
          "days": 90,
          "limit": 2000
        }
      }
    },

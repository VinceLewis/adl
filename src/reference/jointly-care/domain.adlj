            "Location",
            "StartsAt",
            "EndsAt",
            "AllDay"
          ],
          "searchFields": [],
          "sort": [],
          "actions": [
            "save",
            "delete"
          ]
        }
      ],
      "sync": {
        "mode": "localFirst",
        "scope": "currentContext",
        "window": {
          "field": "StartsAt",
          "days": 90,
          "limit": 2000
        }
      }
    },

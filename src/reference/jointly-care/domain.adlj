            "Location",
            "AllDay"
          ],
          "searchFields": [
            "Title",
            "Location"
          ],
          "sort": [
            {
              "field": "StartsAt",
              "direction": "asc"
            }
          ],
          "actions": [
            "create",
            "read",
            "update",
            "delete"
          ]
        },
        {
          "name": "CircleEventForm",
          "kind": "form",
          "context": {
            "mode": "required",
            "context": "Circle"
          },
          "fields": [
            "Title",

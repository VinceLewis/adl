          "defaultValue": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [
        {
          "name": "endsAtNotBeforeStartsAt",
          "expression": "(EndsAt == NULL) OR (EndsAt >= StartsAt)",
          "message": "EndsAt must not be before StartsAt."
        }
      ],
      "views": [
        {
          "name": "CircleEventList",
          "kind": "list",
          "context": {

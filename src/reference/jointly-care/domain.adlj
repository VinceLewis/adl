    {
      "name": "CircleMember",
      "scope": {
        "context": "Circle",
        "field": "Circle"
      },
      "constraints": [
        {
          "name": "uniqueCircleMemberUser",
          "kind": "unique",
          "fields": [
            "User"
          ],
          "scopeFields": [
            "Circle"
          ]
        },
        {
          "name": "lastCircleOwnerStanding",
          "kind": "protectedRole",
          "scopeFields": [
            "Circle"
          ],
          "roleField": "Role",
          "roleValues": [
            "CircleOwner"
          ],
          "minCount": 1
        }
      ],
      "policies": [],
      "fields": [
        {
          "name": "Circle",
          "type": "text",

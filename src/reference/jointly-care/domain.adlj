  "objects": [
    {
      "name": "User",
      "businessKey": "Email",
      "displayField": "DisplayName",
      "constraints": [],
      "policies": [],
      "fields": [
        {
          "name": "Email",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "email"
            }
          ]
        },
        {
          "name": "DisplayName",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "comment": "PRD 1.2: `display_name` defaults to `\"\"` and an empty one renders as the\nemail prefix in the UI. ADL's `DISPLAY` directive must name a stored field\n(`ADL_OBJECT_DISPLAY_FIELD_UNKNOWN` rejects a `COMPUTED` one), so this app\ncannot reproduce the empty-string fallback exactly. It used to display\n`Email` instead -- simpler, and always populated. That is no longer\nacceptable: `UserPolicy` now grants a signed-in caller the display field\nand nothing else, so displaying `Email` would grant every caller the very\naddress the policy exists to withhold. `DISPLAY` is `DisplayName`, and a\nrecord left without one shows the raw id rather than an email -- the\nfail-closed direction, and the reason the seeded dataset always sets it.\nMaking the field `required` is a separate product decision this change\ndeliberately does not take on.",
          "validators": []
        },
        {
          "name": "Timezone",
          "type": "text",
          "required": false,
          "defaultValue": "UTC",
          "readonly": false,
          "hidden": false,
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [],
      "views": [
        {
          "name": "UserProfileList",
          "kind": "list",
          "fields": [
            "DisplayName",
            "Email",
            "Timezone"
          ],
          "searchFields": [
            "DisplayName",
            "Email"
          ],
          "sort": [],
          "actions": [
            "read",
            "search"
          ]
        }
      ],
      "sync": {
        "mode": "localFirst",
        "scope": "currentUser"
      }
    },
    {
      "name": "Circle",
      "displayField": "Name",
      "constraints": [],
      "policies": [],
      "fields": [
        {
          "name": "Name",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "maxLength",
              "value": 100
            }
          ]
        },
        {
          "name": "Description",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "Owner",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "DisplayName"
          },
          "comment": "Optional, not `REQUIRED`: only `CreateCircle` ever writes it (`VALUE\nOwner RUNTIME userId`), matching Giggle Band's `Band.CreatedBy` -- a\ngeneric `ACTIONS create` view has no way to stamp the current user onto\na field (`RUNTIME.userId` is a command-step-only value source; see\n`CircleInvite.InvitedBy` below for the fuller version of this note), so\n`Circle` is never created through a plain create form, only through the\ncommand.",
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [],
      "views": [
        {
          "name": "CircleDirectory",
          "kind": "list",
          "context": {
            "mode": "all",
            "context": "Circle"
          },
          "fields": [
            "Name",
            "Description"
          ],
          "searchFields": [
            "Name"
          ],
          "sort": [],
          "actions": [
            "read",
            "search"
          ]
        },
        {
          "name": "CircleProfile",
          "kind": "form",
          "context": {
            "mode": "required",
            "context": "Circle"
          },
          "fields": [
            "Name",
            "Description"
          ],
          "searchFields": [],
          "sort": [],
          "actions": [
            "save",
            "delete"
          ]
        }
      ],
      "sync": {
        "mode": "localFirst",
        "scope": "allAvailableContexts"
      }
    },
    {
      "name": "CircleMember",
      "scope": {
        "context": "Circle",
        "field": "Circle"
      },
      "constraints": [
        {
          "name": "uniqueCircleMemberUser",
          "kind": "unique",
          "fields": [
            "User"
          ],
          "scopeFields": [
            "Circle"
          ]
        },
        {
          "name": "lastCircleOwnerStanding",
          "kind": "protectedRole",
          "scopeFields": [
            "Circle"
          ],
          "roleField": "Role",
          "roleValues": [
            "CircleOwner"
          ],
          "minCount": 1
        }
      ],
      "policies": [],
      "fields": [
        {
          "name": "Circle",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "Circle",
            "displayField": "Name"
          },
          "validators": []
        },
        {
          "name": "User",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "DisplayName"
          },
          "validators": []
        },
        {
          "name": "Role",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "in",
              "value": [
                "CircleOwner",
                "CircleMember"
              ]
            }
          ]
        },
        {
          "name": "JoinedAt",
          "type": "date",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [],
      "views": [
        {
          "name": "CircleMemberList",
          "kind": "list",
          "context": {
            "mode": "required",
            "context": "Circle"
          },
          "fields": [

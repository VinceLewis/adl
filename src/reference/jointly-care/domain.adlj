    {
      "name": "DeclineCircleInvite",
      "label": "Decline invite",
      "inputs": [
        {
          "name": "Invite",
          "type": "text",
          "required": true
        }
      ],
      "comment": "Symmetric with `AcceptCircleInvite` above: `REQUIRE Invitee ==\nruntime.userId` is what stops any authenticated caller from declining an\ninvite addressed to someone else. An invite an inviter sent to an email\nwith no matching account yet has no `Invitee` to match, so it cannot be\ndeclined through this command either -- only accepted or declined by the\nperson it already names.",
      "preconditions": [],
      "steps": [
        {
          "name": "declineInvite",
          "action": "update",
          "object": "CircleInvite",
          "recordId": {
            "kind": "input",
            "name": "Invite"
          },
          "patch": {
            "Status": {
              "kind": "literal",
              "value": "declined"
            },
            "RespondedAt": {
              "kind": "runtime",
              "property": "today"
            }
          },
          "preconditions": [
            "Invitee == RUNTIME.userId",
            "Status == 'pending'"
          ]
        }
      ]
    }
  ],

  "contexts": [
    {
      "name": "User",
      "object": "User",
      "selection": {
        "mode": "required"
      }
    },
    {
      "name": "Circle",
      "object": "Circle",
      "selection": {
        "mode": "optional",
        "autoSelect": false,
        "persistence": "local"
      },
      "membership": {
        "object": "CircleMember",
        "userField": "User",
        "contextField": "Circle",
        "roleField": "Role",
        "roles": [
          "CircleOwner",
          "CircleMember"
        ]
      },
      "grants": [
        {
          "name": "pendingCircleInvite",
          "object": "CircleInvite",
          "userField": "Invitee",
          "contextField": "Circle",
          "comment": "Mirrors Giggle Band's `pendingBandInvitation` grant: without this, a circle\na user has been invited to but not yet joined is not one of their\n\"available contexts\", so `SCOPE allAvailableContexts` on `CircleInvite`\ncould never surface the invite to the person it is addressed to.",
          "condition": "Status == 'pending'"
        }
      ]
    }
  ],

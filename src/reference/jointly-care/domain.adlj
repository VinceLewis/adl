    {
      "name": "CircleInvite",
      "scope": {
        "context": "Circle",
        "field": "Circle"
      },
      "constraints": [
        {
          "name": "uniqueCircleInviteEmail",
          "kind": "unique",
          "fields": [
            "InviteeEmail"
          ],
          "scopeFields": [
            "Circle"
          ]
        }
      ],
      "policies": [],
      "fields": [
        {
          "name": "Circle",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "Circle",
            "displayField": "Name"
          },
          "validators": []
        },
        {
          "name": "InvitedBy",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "Email"
          },
          "validators": []
        },
        {
          "name": "Invitee",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "Email"
          },
          "validators": []
        },
        {
          "name": "InviteeEmail",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "email"
            }
          ]
        },
        {
          "name": "Status",
          "type": "text",
          "required": true,
          "defaultValue": "pending",
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "in",
              "value": [
                "pending",
                "accepted",
                "declined"
              ]
            }
          ]
        },
        {
          "name": "SentAt",
          "type": "date",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "RespondedAt",
          "type": "date",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [
        {
          "name": "respondedAtRequiredAfterResponse",
          "expression": "(Status == 'pending') OR (RespondedAt != NULL)",
          "message": "RespondedAt is required once an invite has been accepted or declined."
        }
      ],
      "views": [
        {
          "name": "CircleInviteList",
          "kind": "list",
          "context": {
            "mode": "required",
            "context": "Circle"
          },
          "fields": [
            "InviteeEmail",
            "Status",
            "SentAt"
          ],
          "searchFields": [
            "InviteeEmail",
            "Status"
          ],
          "sort": [],
          "actions": [
            "create",
            "read",
            "update",
            "delete"
          ]
        }
      ],
      "sync": {
        "mode": "onlineRequired",
        "scope": "currentContext"
      }
    },

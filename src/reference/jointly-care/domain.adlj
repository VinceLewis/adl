            "read",
            "search"
          ]
        }
      ],
      "sync": {
        "mode": "localFirst",
        "scope": "allAvailableContexts"
      }
    },
    {
      "name": "CircleInvite",
      "scope": {
        "context": "Circle",
        "field": "Circle"
      },
      "constraints": [
        {
          "name": "uniqueCircleInviteEmail",
          "kind": "unique",
          "fields": [
            "InviteeEmail"
          ],
          "scopeFields": [
            "Circle"
          ]
        }
      ],
      "policies": [],
      "fields": [
        {
          "name": "Circle",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "Circle",
            "displayField": "Name"
          },
          "validators": []
        },
        {
          "name": "InvitedBy",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "DisplayName"
          },
          "comment": "Optional, like `Circle.Owner` above: `CircleInviteList`'s create form\n(`FIELDS InviteeEmail`) has no way to stamp the sending owner's id onto\nthe write, since only a `COMMAND` step's `VALUE ... RUNTIME userId` can\ndo that and a plain object `ACTIONS create` action is not a command.\nLeft unset when sent from the generic form; a future command could set\nit deliberately, the same way `AcceptCircleInvite` below sets `Invitee`.",
          "validators": []
        },
        {
          "name": "Invitee",
          "type": "text",
          "required": false,
          "readonly": false,
          "hidden": false,
          "lookup": {
            "targetObject": "User",
            "displayField": "DisplayName"
          },
          "comment": "Also optional: the owner sending the invite may not know whether the\ninvitee already has an account. `AcceptCircleInvite` fills this in from\n`RUNTIME.userId` when the invitation is accepted.",
          "validators": []
        },
        {
          "name": "InviteeEmail",
          "type": "text",
          "required": true,
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "email"
            }
          ]
        },
        {
          "name": "Status",
          "type": "text",
          "required": true,
          "defaultValue": "pending",
          "readonly": false,
          "hidden": false,
          "validators": [
            {
              "kind": "in",
              "value": [
                "pending",
                "accepted",
                "declined"
              ]
            }
          ]
        },
        {
          "name": "SentAt",
          "type": "date",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        },
        {
          "name": "RespondedAt",
          "type": "date",
          "required": false,
          "readonly": false,
          "hidden": false,
          "validators": []
        }
      ],
      "computedFields": [],
      "validations": [
        {
          "name": "respondedAtRequiredAfterResponse",
          "expression": "(Status == 'pending') OR (RespondedAt != NULL)",
          "message": "RespondedAt is required once an invite has been accepted or declined.",
          "comment": "A still-`pending` invite has no response yet, so it is exempted the same\nway Giggle Band's `BandInvitation.respondedAtRequiredAfterResponse` is."
        }
      ],
      "views": [
        {
          "name": "CircleInviteList",
          "kind": "list",
          "context": {
            "mode": "required",
            "context": "Circle"
          },
          "fields": [
            "InviteeEmail",
            "Status",
            "SentAt"
          ],
          "searchFields": [
            "InviteeEmail",
            "Status"
          ],
          "sort": [],
          "actions": [
            "create",
            "read",
            "update",
            "delete"
          ]
        }
      ],
      "sync": {
        "mode": "onlineRequired",
        "scope": "currentContext"
      }
    },
    {
      "name": "Event",
      "displayField": "Title",
      "scope": {
        "context": "Circle",
        "field": "Circle"
      },
      "constraints": [],
      "policies": [],
      "fields": [
        {
          "name": "Circle",

APP 'Jointly Care ADL Example'
  MODEL_VERSION '1.0.0'
  THEME MinimalLight
  START_VIEW HomeDashboard
  OFFLINE_GRACE 30 DAYS
END.APP

# Domain source for the ADL-native equivalent of Jointly MVP -- a care
# coordination app where a group of carers (a "circle") share a calendar,
# notes and messages around the person they support. See
# `OSV_PRD_Elixir_Canonical_Jointly.md` for the canonical Phoenix/LiveView
# PRD this app is modelled from. ADL's own runtime replaces the generator
# scaffold (`phx.gen.auth`/`phx.gen.live`) and its hand-wired backend gaps
# (PRD sections 0.1/0.2) with CONTEXT membership, POLICY rules and COMMANDs
# -- none of that wiring is hand-written application code here.

ROLE SystemAdmin
ROLE CircleMember
ROLE CircleOwner INHERITS CircleMember

CONTEXT User OBJECT User SELECTION REQUIRED
CONTEXT Circle OBJECT Circle SELECTION OPTIONAL AUTO_SELECT false PERSISTENCE local MEMBERSHIP CircleMember USER User CONTEXT_FIELD Circle ROLE_FIELD Role ROLES CircleOwner CircleMember

# Mirrors Giggle Band's `pendingBandInvitation` grant: without this, a circle
# a user has been invited to but not yet joined is not one of their
# "available contexts", so `SCOPE allAvailableContexts` on `CircleInvite`
# could never surface the invite to the person it is addressed to.
CONTEXT_GRANT pendingCircleInvite ON Circle OBJECT CircleInvite USER Invitee CONTEXT_FIELD Circle WHEN Status == 'pending'

OBJECT User
  KEY Email
  DISPLAY Email
  FIELD Email TEXT REQUIRED EMAIL
  # PRD 1.2: `display_name` defaults to `""` and an empty one renders as the
  # email prefix in the UI. ADL's `DISPLAY` directive must name a stored
  # field (`ADL_OBJECT_DISPLAY_FIELD_UNKNOWN` rejects a `COMPUTED` one), so
  # this app displays `Email` directly rather than reproducing the
  # empty-string fallback -- a simpler, always-populated label with the same
  # practical effect. `DisplayName` is still a real field a person can set.
  FIELD DisplayName TEXT
  FIELD Timezone TEXT DEFAULT('UTC')
  SYNC LOCAL_FIRST SCOPE currentUser

  VIEW UserProfileList LIST
    FIELDS DisplayName Email Timezone
    SEARCH DisplayName Email
    ACTIONS read search
  END.VIEW
END.OBJECT

OBJECT Circle
  DISPLAY Name
  FIELD Name TEXT REQUIRED MAX_LENGTH(100)
  FIELD Description TEXT
  # Optional, not `REQUIRED`: only `CreateCircle` ever writes it (`VALUE
  # Owner RUNTIME userId`), matching Giggle Band's `Band.CreatedBy` -- a
  # generic `ACTIONS create` view has no way to stamp the current user onto
  # a field (`RUNTIME.userId` is a command-step-only value source; see
  # `CircleInvite.InvitedBy` below for the fuller version of this note), so
  # `Circle` is never created through a plain create form, only through the
  # command.
  FIELD Owner TEXT LOOKUP User DISPLAY Email
  SYNC LOCAL_FIRST SCOPE allAvailableContexts

  VIEW CircleDirectory LIST
    CONTEXT ALL Circle
    FIELDS Name Description
    SEARCH Name
    ACTIONS read search
  END.VIEW

  VIEW CircleProfile FORM
    CONTEXT REQUIRED Circle
    FIELDS Name Description
    ACTIONS save delete
  END.VIEW
END.OBJECT

OBJECT CircleMember
  SCOPE Circle FIELD Circle
  CONSTRAINT uniqueCircleMemberUser UNIQUE SCOPE Circle FIELDS User
  CONSTRAINT lastCircleOwnerStanding PROTECTED_ROLE SCOPE Circle FIELD Role VALUES ('CircleOwner') MIN(1)
  FIELD Circle TEXT REQUIRED LOOKUP Circle DISPLAY Name
  FIELD User TEXT REQUIRED LOOKUP User DISPLAY Email
  FIELD Role TEXT REQUIRED IN ('CircleOwner', 'CircleMember')
  FIELD JoinedAt DATE
  SYNC LOCAL_FIRST SCOPE allAvailableContexts

  VIEW CircleMemberList LIST
    CONTEXT REQUIRED Circle
    FIELDS User Role JoinedAt
    SEARCH Role
    ACTIONS read search
  END.VIEW
END.OBJECT

OBJECT CircleInvite
  SCOPE Circle FIELD Circle
  CONSTRAINT uniqueCircleInviteEmail UNIQUE SCOPE Circle FIELDS InviteeEmail
  FIELD Circle TEXT REQUIRED LOOKUP Circle DISPLAY Name
  # Optional, like `Circle.Owner` above: `CircleInviteList`'s create form
  # (`FIELDS InviteeEmail`) has no way to stamp the sending owner's id onto
  # the write, since only a `COMMAND` step's `VALUE ... RUNTIME userId` can
  # do that and a plain object `ACTIONS create` action is not a command.
  # Left unset when sent from the generic form; a future command could set
  # it deliberately, the same way `AcceptCircleInvite` below sets `Invitee`.
  FIELD InvitedBy TEXT LOOKUP User DISPLAY Email
  # Also optional: the owner sending the invite may not know whether the
  # invitee already has an account. `AcceptCircleInvite` fills this in from
  # `RUNTIME.userId` when the invitation is accepted.
  FIELD Invitee TEXT LOOKUP User DISPLAY Email
  FIELD InviteeEmail TEXT REQUIRED EMAIL
  FIELD Status TEXT REQUIRED DEFAULT('pending') IN ('pending', 'accepted', 'declined')
  FIELD SentAt DATE
  FIELD RespondedAt DATE
  # A still-`pending` invite has no response yet, so it is exempted the same
  # way Giggle Band's `BandInvitation.respondedAtRequiredAfterResponse` is.
  VALIDATE respondedAtRequiredAfterResponse Status == 'pending' OR RespondedAt != NULL MESSAGE 'RespondedAt is required once an invite has been accepted or declined.'
  SYNC ONLINE_REQUIRED SCOPE currentContext

  VIEW CircleInviteList LIST
    CONTEXT REQUIRED Circle
    FIELDS InviteeEmail Status SentAt
    SEARCH InviteeEmail Status
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

OBJECT Event
  DISPLAY Title
  SCOPE Circle FIELD Circle
  FIELD Circle TEXT REQUIRED LOOKUP Circle DISPLAY Name
  # Optional -- see `Circle.Owner` above for why a plain create form cannot
  # stamp the current user onto this field. Populated by seed/test data, and
  # available for a future command to set deliberately.
  FIELD CreatedBy TEXT LOOKUP User DISPLAY Email
  FIELD Title TEXT REQUIRED
  FIELD Description TEXT
  FIELD Location TEXT
  FIELD StartsAt DATETIME REQUIRED
  FIELD EndsAt DATETIME
  FIELD AllDay BOOLEAN DEFAULT(false)
  VALIDATE endsAtNotBeforeStartsAt EndsAt == NULL OR EndsAt >= StartsAt MESSAGE 'EndsAt must not be before StartsAt.'
  SYNC LOCAL_FIRST SCOPE currentContext WINDOW StartsAt 90 DAYS LIMIT 2000

  VIEW CircleEventList LIST
    CONTEXT REQUIRED Circle
    FIELDS StartsAt Title Location AllDay
    SEARCH Title Location
    SORT StartsAt ASC
    ACTIONS create read update delete
  END.VIEW

  VIEW CircleEventForm FORM
    CONTEXT REQUIRED Circle
    FIELDS Title Description Location StartsAt EndsAt AllDay
    ACTIONS save delete
  END.VIEW
END.OBJECT

OBJECT Note
  DISPLAY Title
  SCOPE Circle FIELD Circle
  FIELD Circle TEXT REQUIRED LOOKUP Circle DISPLAY Name
  FIELD CreatedBy TEXT LOOKUP User DISPLAY Email
  FIELD Title TEXT REQUIRED
  FIELD Body TEXT REQUIRED
  SYNC LOCAL_FIRST SCOPE currentContext

  VIEW CircleNoteList LIST
    CONTEXT REQUIRED Circle
    FIELDS Title CreatedBy
    SEARCH Title Body
    ACTIONS create read update delete
  END.VIEW

  VIEW CircleNoteForm FORM
    CONTEXT REQUIRED Circle
    FIELDS Title Body
    ACTIONS save delete
  END.VIEW
END.OBJECT

OBJECT Message
  SCOPE Circle FIELD Circle
  FIELD Circle TEXT REQUIRED LOOKUP Circle DISPLAY Name
  FIELD SentBy TEXT LOOKUP User DISPLAY Email
  FIELD Body TEXT REQUIRED MAX_LENGTH(2000)
  SYNC LOCAL_FIRST SCOPE currentContext

  VIEW CircleMessageList LIST
    CONTEXT REQUIRED Circle
    FIELDS SentBy Body
    SEARCH Body
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

OBJECT Reminder
  DISPLAY Title
  SCOPE Circle FIELD Circle
  FIELD Circle TEXT REQUIRED LOOKUP Circle DISPLAY Name
  FIELD Event TEXT LOOKUP Event DISPLAY Title
  FIELD CreatedBy TEXT LOOKUP User DISPLAY Email
  FIELD Title TEXT REQUIRED
  FIELD RemindAt DATETIME REQUIRED
  FIELD Delivered BOOLEAN DEFAULT(false)
  SYNC LOCAL_FIRST SCOPE currentContext WINDOW RemindAt 90 DAYS LIMIT 200

  VIEW ReminderList LIST
    CONTEXT REQUIRED Circle
    FIELDS RemindAt Title Event Delivered
    SEARCH Title
    SORT RemindAt ASC
    ACTIONS create read update delete
  END.VIEW
END.OBJECT

READ_MODEL HomeUpcomingEvents
  CONTEXT ALL Circle
  SOURCE event OBJECT Event SCOPE allAvailableContexts
  SOURCE circle OBJECT Circle SCOPE allAvailableContexts
  FIELD StartsAt FROM event.StartsAt
  FIELD Title FROM event.Title
  FIELD Location FROM event.Location
  FIELD AllDay FROM event.AllDay
  FIELD CircleName FROM circle.Name
  SORT StartsAt ASC
END.READ_MODEL

READ_MODEL CircleCalendarItems
  CONTEXT REQUIRED Circle
  SOURCE event OBJECT Event SCOPE currentContext
  FIELD StartsAt FROM event.StartsAt
  FIELD Title FROM event.Title
  FIELD Location FROM event.Location
  FIELD AllDay FROM event.AllDay
  SORT StartsAt ASC
END.READ_MODEL

# The home feed's counterpart for invites: every circle a caller has access
# to via `pendingCircleInvite` (declared above) is one they have been
# invited to but not yet joined, so `SCOPE allAvailableContexts` here
# reaches exactly the invites addressed to them across every circle --
# without needing a circle already selected, unlike `CONTEXT REQUIRED`.
#
# This deliberately does not join `Circle` to project a `CircleName`: a
# `CONTEXT_GRANT` only ever puts the *granted* object (`CircleInvite`) in
# reach of the object-scope gate for its target, never the context's own
# root object (`Circle`). `CirclePolicy` has no rule that would let a
# pending invitee read the `Circle` record itself -- `ROLE CircleMember`
# does not apply (they are not one yet) and no policy vocabulary here
# expresses "may read because a grant admits me to this context" the way
# `CONTEXT_MEMBER` expresses relationship access on a different object's
# field. Joining it anyway would silently drop every row for exactly the
# caller this read model exists for, the same shape of finding as
# `learnings/implementation/reference-app-models.md`'s "a cross-band
# overlay cannot name which band".
READ_MODEL MyPendingCircleInvites
  CONTEXT ALL Circle
  SOURCE invite OBJECT CircleInvite SCOPE allAvailableContexts
  FIELD InviteeEmail FROM invite.InviteeEmail
  FIELD Status FROM invite.Status
  FIELD SentAt FROM invite.SentAt
  # Not shown -- projected only so `MyPendingInvites` (`ui.adl`) can gate its
  # Accept/Decline row actions to the row's actual invitee. `allowAuthenticated
  # SearchInvites` (above) is unconditioned, and `allowCircleOwnerReadInvites`
  # legitimately lets an owner read every invite their own circle has sent --
  # so this read model also surfaces a circle owner's own outgoing invites,
  # not only invites addressed to the caller. Both commands' own `REQUIRE
  # Invitee == runtime.userId` step guard makes offering the buttons on
  # someone else's invite safe either way, but showing a button that always
  # fails for its own caller is still worth avoiding.
  FIELD Invitee FROM invite.Invitee
  SORT SentAt ASC
END.READ_MODEL

READ_MODEL CircleMemberRoster
  CONTEXT REQUIRED Circle
  SOURCE member OBJECT CircleMember SCOPE currentContext
  SOURCE user OBJECT User SCOPE all
  FIELD MemberEmail FROM user.Email
  FIELD Role FROM member.Role
  FIELD JoinedAt FROM member.JoinedAt
  SORT Role ASC
END.READ_MODEL

READ_MODEL CircleRecentNotes
  CONTEXT REQUIRED Circle
  SOURCE note OBJECT Note SCOPE currentContext
  FIELD Title FROM note.Title
  FIELD Body FROM note.Body
  SORT Title ASC
END.READ_MODEL

READ_MODEL CircleRecentMessages
  CONTEXT REQUIRED Circle
  SOURCE message OBJECT Message SCOPE currentContext
  FIELD SentBy FROM message.SentBy
  FIELD Body FROM message.Body
  SORT Body ASC
END.READ_MODEL

COMMAND CreateCircle LABEL 'Create circle'
  INPUT Name TEXT REQUIRED
  INPUT Description TEXT OPTIONAL
  STEP createCircle CREATE Circle ESTABLISHES CONTEXT Circle
    VALUE Name INPUT Name
    VALUE Description INPUT Description
    VALUE Owner RUNTIME userId
  END.STEP

  STEP createOwnerMembership CREATE CircleMember AUTHORITY command
    VALUE User RUNTIME userId
    VALUE Circle STEP createCircle META guid
    VALUE Role LITERAL CircleOwner
    VALUE JoinedAt RUNTIME today
  END.STEP
END.COMMAND

COMMAND AcceptCircleInvite LABEL 'Accept invite'
  INPUT Invite TEXT REQUIRED
  STEP acceptInvite UPDATE CircleInvite ID INPUT Invite
    VALUE Status LITERAL accepted
    VALUE RespondedAt RUNTIME today
    REQUIRE Invitee == runtime.userId
    REQUIRE Status == 'pending'
  END.STEP

  STEP createMembership CREATE CircleMember AUTHORITY command
    VALUE User RUNTIME userId
    VALUE Circle STEP acceptInvite FIELD Circle
    VALUE Role LITERAL CircleMember
    VALUE JoinedAt RUNTIME today
  END.STEP
END.COMMAND

# Symmetric with `AcceptCircleInvite` above: `REQUIRE Invitee ==
# runtime.userId` is what stops any authenticated caller from declining an
# invite addressed to someone else. An invite an inviter sent to an email
# with no matching account yet has no `Invitee` to match, so it cannot be
# declined through this command either -- only accepted or declined by the
# person it already names.
COMMAND DeclineCircleInvite LABEL 'Decline invite'
  INPUT Invite TEXT REQUIRED
  STEP declineInvite UPDATE CircleInvite ID INPUT Invite
    VALUE Status LITERAL declined
    VALUE RespondedAt RUNTIME today
    REQUIRE Invitee == runtime.userId
    REQUIRE Status == 'pending'
  END.STEP
END.COMMAND

POLICY UserSystemAdminPolicy ON User
  RULE allowSystemAdminAllUserOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY CircleSystemAdminPolicy ON Circle
  RULE allowSystemAdminAllCircleOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY CircleMemberSystemAdminPolicy ON CircleMember
  RULE allowSystemAdminAllCircleMemberOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY CircleInviteSystemAdminPolicy ON CircleInvite
  RULE allowSystemAdminAllCircleInviteOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY EventSystemAdminPolicy ON Event
  RULE allowSystemAdminAllEventOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY NoteSystemAdminPolicy ON Note
  RULE allowSystemAdminAllNoteOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY MessageSystemAdminPolicy ON Message
  RULE allowSystemAdminAllMessageOps ALLOW * ROLE SystemAdmin
END.POLICY

POLICY ReminderSystemAdminPolicy ON Reminder
  RULE allowSystemAdminAllReminderOps ALLOW * ROLE SystemAdmin
END.POLICY

# `AUTHENTICATED`, not `ROLE CircleMember`: a context-scoped `ROLE` condition
# only resolves against an object that is itself scoped to that context
# (`SCOPE Circle FIELD Circle`, as `Event`/`Note`/... declare) or is itself a
# context's own bound object (`Circle`, for `CONTEXT Circle OBJECT Circle`).
# `User` is neither, so `getPolicyRequestContextTargets` (`context-scope.ts`)
# can only ever resolve targets against the `User` context (a caller's own
# identity selection) for a `User`-object policy check -- a `Circle`-derived
# role can never reach it, no matter which circle is selected. Any
# authenticated caller may look up a collaborator's profile to invite or
# recognise them; that does not depend on already sharing a circle.
POLICY UserPolicy ON User
  RULE allowAuthenticatedSearchUsers ALLOW SEARCH AUTHENTICATED
  RULE allowAuthenticatedReadUsers ALLOW READ AUTHENTICATED
END.POLICY

POLICY CirclePolicy ON Circle
  RULE allowCircleMemberSearchCircles ALLOW SEARCH ROLE CircleMember
  RULE allowCircleMemberReadCircle ALLOW READ ROLE CircleMember
  RULE allowAuthenticatedCreateOwnCircle ALLOW CREATE AUTHENTICATED WHEN Owner == runtime.userId
  RULE allowCircleCreatorReadOwnCircle ALLOW READ AUTHENTICATED WHEN Owner == runtime.userId
  RULE allowCircleOwnerUpdateCircle ALLOW UPDATE ROLE CircleOwner
  RULE allowCircleOwnerDeleteCircle ALLOW DELETE ROLE CircleOwner
END.POLICY

POLICY CircleMemberPolicy ON CircleMember
  RULE allowCircleMemberSearchMembers ALLOW SEARCH ROLE CircleMember
  RULE allowCircleMemberReadMembers ALLOW READ ROLE CircleMember
  RULE allowAuthenticatedReadOwnMembership ALLOW READ AUTHENTICATED WHEN User == runtime.userId
  RULE allowCircleOwnerCreateMembers ALLOW CREATE ROLE CircleOwner
  RULE allowCircleOwnerUpdateMembers ALLOW UPDATE ROLE CircleOwner
  RULE allowCircleOwnerDeleteMembers ALLOW DELETE ROLE CircleOwner
END.POLICY

POLICY CircleInvitePolicy ON CircleInvite
  RULE allowCircleOwnerCreateInvites ALLOW CREATE ROLE CircleOwner
  RULE allowCircleOwnerReadInvites ALLOW READ ROLE CircleOwner
  RULE allowInviteeReadOwnInvite ALLOW READ AUTHENTICATED WHEN Invitee == runtime.userId
  # Deliberately unconditioned, matching `AvailabilityPolicy.
  # allowAuthenticatedSearchAvailability` in Giggle Band: a `SEARCH` rule's
  # `WHEN` is checked against `request.record`, which a coarse "may this
  # principal search this object at all" gate never has -- `Invitee ==
  # runtime.userId` would evaluate against no record and always fail, so a
  # conditioned `ALLOW SEARCH ... WHEN` can never actually grant search.
  # `MyPendingCircleInvites` (`ui.adl`'s `MyPendingInvites` view) is the one
  # cross-circle read model this app has where the *invitee*, not a
  # `CircleOwner`, is the caller; row-level shaping still narrows what comes
  # back to just their own invite via `allowInviteeReadOwnInvite` above.
  RULE allowAuthenticatedSearchInvites ALLOW SEARCH AUTHENTICATED
  RULE allowCircleOwnerUpdateInvites ALLOW UPDATE ROLE CircleOwner
  RULE allowInviteeRespondToInvite ALLOW UPDATE AUTHENTICATED WHEN Invitee == runtime.userId AND (Status == 'accepted' OR Status == 'declined')
  RULE denyInviteeIdentityInviteUpdates DENY UPDATE FIELDS Circle InvitedBy Invitee InviteeEmail AUTHENTICATED WHEN Invitee == runtime.userId AND (Status == 'accepted' OR Status == 'declined')
  RULE allowCircleOwnerDeleteInvites ALLOW DELETE ROLE CircleOwner
END.POLICY

POLICY EventPolicy ON Event
  RULE allowCircleMemberSearchEvents ALLOW SEARCH ROLE CircleMember
  RULE allowCircleMemberReadEvents ALLOW READ ROLE CircleMember
  RULE allowCircleMemberCreateEvents ALLOW CREATE ROLE CircleMember
  RULE allowCircleMemberUpdateEvents ALLOW UPDATE ROLE CircleMember
  RULE allowCircleMemberDeleteEvents ALLOW DELETE ROLE CircleMember
END.POLICY

POLICY NotePolicy ON Note
  RULE allowCircleMemberSearchNotes ALLOW SEARCH ROLE CircleMember
  RULE allowCircleMemberReadNotes ALLOW READ ROLE CircleMember
  RULE allowCircleMemberCreateNotes ALLOW CREATE ROLE CircleMember
  RULE allowCircleMemberUpdateNotes ALLOW UPDATE ROLE CircleMember
  RULE allowCircleMemberDeleteNotes ALLOW DELETE ROLE CircleMember
END.POLICY

POLICY MessagePolicy ON Message
  RULE allowCircleMemberSearchMessages ALLOW SEARCH ROLE CircleMember
  RULE allowCircleMemberReadMessages ALLOW READ ROLE CircleMember
  RULE allowCircleMemberCreateMessages ALLOW CREATE ROLE CircleMember
  RULE allowCircleMemberUpdateMessages ALLOW UPDATE ROLE CircleMember
  RULE allowCircleMemberDeleteMessages ALLOW DELETE ROLE CircleMember
END.POLICY

POLICY ReminderPolicy ON Reminder
  RULE allowCircleMemberSearchReminders ALLOW SEARCH ROLE CircleMember
  RULE allowCircleMemberReadReminders ALLOW READ ROLE CircleMember
  RULE allowCircleMemberCreateReminders ALLOW CREATE ROLE CircleMember
  RULE allowCircleMemberUpdateReminders ALLOW UPDATE ROLE CircleMember
  RULE allowCircleMemberDeleteReminders ALLOW DELETE ROLE CircleMember
END.POLICY

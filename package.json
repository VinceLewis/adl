{
  "name": "@adl/resolved-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone ADL resolved model contract and resolver.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:authority": "tsc -p tsconfig.server.json",
    "start:authority": "npm run build:authority && node dist-server/src/server/authority-main.js",
    "retention": "npm run build:authority && node dist-server/src/server/authority-retention-main.js",
    "retention:dry-run": "npm run build:authority && node dist-server/src/server/authority-retention-main.js --dry-run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify:push": "npm run typecheck && npm run format:check && npm test && npm run build && npm run test:visual",
    "format": "prettier --write \"index.html\" \"src/**/*.css\" \"src/**/*.ts\" \"tests/**/*.ts\" \"playwright.config.ts\" \"vite.config.ts\" \"vitest.config.ts\" \"package.json\" \"tsconfig.json\" \".prettierrc\"",
    "format:check": "prettier --check \"index.html\" \"src/**/*.css\" \"src/**/*.ts\" \"tests/**/*.ts\" \"playwright.config.ts\" \"vite.config.ts\" \"vitest.config.ts\" \"package.json\" \"tsconfig.json\" \".prettierrc\""
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "20.17.6",
    "@types/pg": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "^6.4.3",
    "vitest": "4.1.10"
  }
}

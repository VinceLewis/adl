node_modules/
dist/
dist-server/
coverage/
.vitest/
playwright-report/
test-results/
# playwright-bdd generates one spec per Scenario from the qa-kit Gherkin root.
.features-gen/

# qa-kit tool output. The contract requires these results to be untracked:
# a tracked output path is refused, and the gate authenticates an untracked file.
.qa-kit/pairs/
.qa-kit/runs/
.qa-kit/cucumber-build-*/
npm-debug.log*

# Local env overrides. Never commit a filled copy (see .env.authority.sample).
.env
.env.*
!.env.authority.sample

# Local development TLS material, generated by scripts/dev/generate-local-tls.sh.
# Never commit a private key, even a development one.
.dev-tls/

# Local development scratch: certificates, logs, env overrides.
.dev-logs/
